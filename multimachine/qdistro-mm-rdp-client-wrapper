#!/usr/bin/python3
"""Installed entry point for the broker-owned FreeRDP wrapper."""
import sys
from pathlib import Path

installed = Path("/usr/local/lib/qdistro")
source_tree = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(installed if (installed / "multimachine").is_dir()
                       else source_tree))

from multimachine.rdp_client_wrapper import main

raise SystemExit(main())
