#!/bin/bash
#
# vm-gui — GUI automation for VMs via xdotool + virsh screenshot.
#
# Usage:
#   vm-gui <vm> screenshot [file]        Take screenshot (default: /tmp/vm-screenshot.png)
#   vm-gui <vm> screenshot-fresh <file> [baseline] [attempts]
#                                         Retry stale/near-black captures (default: 3 tries)
#   vm-gui <vm> start <command>          Launch a GUI app
#   vm-gui <vm> activate <title>         Focus window by title (wildcard match)
#   vm-gui <vm> click-preview <x> <y> [label]
#                                         Move pointer; save raw/marked/zoom review images
#   vm-gui <vm> click-confirm <manifest> Click the exact reviewed coordinates
#   vm-gui <vm> click <x> <y>           Left-click at coordinates
#   vm-gui <vm> rightclick <x> <y>      Right-click at coordinates
#   vm-gui <vm> doubleclick <x> <y>     Double-click at coordinates
#   vm-gui <vm> drag <x1> <y1> <x2> <y2>  Drag from (x1,y1) to (x2,y2)
#   vm-gui <vm> scroll <up|down> [n]    Scroll mouse wheel (default: 3 clicks)
#   vm-gui <vm> type <text>             Type text (100ms delay between keys)
#   vm-gui <vm> key <key> [key...]      Send key(s): Return, Tab, ctrl+c, alt+F4, ...
#   vm-gui <vm> windowsize <title> <w> <h>   Resize window
#   vm-gui <vm> windowmove <title> <x> <y>   Move window
#   vm-gui <vm> wait [seconds]          Wait (default: 2)
#
set -euo pipefail

VM="${1:?Usage: $0 <vm> <command> [args...]}"
CMD="${2:?Usage: $0 <vm> <command> [args...]}"
shift 2

# $0 is the INVOKED name, which is "bash" when this file is SOURCED rather than
# executed -- two bootstrap-hardening tests source it to unit-test
# ydotool_key_sequence/shell_quote, and under $0 the path resolved to ./vm-exec
# and ./lib/..., which do not exist from the repo root. BASH_SOURCE[0] is always
# THIS FILE, executed or sourced, so both callers resolve the same paths.
VM_GUI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VM_EXEC="$VM_GUI_DIR/vm-exec"
DELAY=100

run_as_jan() {
    "$VM_EXEC" "$VM" "su - admin -c 'export DISPLAY=:0; $1'"
}

# HARNESS CAPTURE ATTESTATION — every `virsh screenshot` below goes through the
# shared attestation library, which records it in the qci GUI gate's capture
# ledger for the VM that ledger is bound to, and can never attest a frame of
# another worker's VM.
#
# TWO SHAPES, because a retry loop and a one-shot capture want different things:
#   * a lane that captures STRAIGHT to its final path (click-preview raw/post)
#     uses capture_virsh_screenshot, which takes the screenshot and attests the
#     file it just wrote -- one row, nothing chooses the bytes;
#   * a lane that RETRIES (screenshot, screenshot-fresh) captures candidates
#     with capture_virsh_shot, which writes NO row, and the row is written when
#     a candidate is published with capture_publish_frame. Candidates the tool
#     rejects are recorded under the `rejected` scope, which the gate counts
#     nowhere.
# capture_publish_frame therefore attests bytes handed to it, in the same
# process that captured them. See the library header for what that does and does
# not prove.
# shellcheck source=lib/capture-attest.sh
. "$VM_GUI_DIR/lib/capture-attest.sh"

shell_quote() {
    printf "'"
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
    printf "'"
}

run_input() {
    "$VM_EXEC" "$VM" "runuser -u admin -- env DISPLAY=:0 XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-1 YDOTOOL_SOCKET=/run/user/1000/ydotool.sock $1"
}

have_ydotool() {
    "$VM_EXEC" "$VM" "runuser -u admin -- bash -lc 'command -v ydotool >/dev/null 2>&1 && [ -S /run/user/1000/ydotool.sock ]'" >/dev/null 2>&1
}

ydotool_keycode() {
    local key="${1,,}"
    case "$key" in
        ctrl|control|control_l|leftctrl|leftcontrol) echo 29 ;;
        alt|alt_l|leftalt) echo 56 ;;
        shift|shift_l|leftshift) echo 42 ;;
        super|meta|win|windows|leftmeta|leftsuper) echo 125 ;;
        enter|return) echo 28 ;;
        esc|escape) echo 1 ;;
        tab) echo 15 ;;
        space) echo 57 ;;
        backspace) echo 14 ;;
        delete|del) echo 111 ;;
        up) echo 103 ;;
        down) echo 108 ;;
        left) echo 105 ;;
        right) echo 106 ;;
        home) echo 102 ;;
        end) echo 107 ;;
        page_up|pageup|prior) echo 104 ;;
        page_down|pagedown|next) echo 109 ;;
        f1) echo 59 ;;
        f2) echo 60 ;;
        f3) echo 61 ;;
        f4) echo 62 ;;
        f5) echo 63 ;;
        f6) echo 64 ;;
        f7) echo 65 ;;
        f8) echo 66 ;;
        f9) echo 67 ;;
        f10) echo 68 ;;
        f11) echo 87 ;;
        f12) echo 88 ;;
        1) echo 2 ;;
        2) echo 3 ;;
        3) echo 4 ;;
        4) echo 5 ;;
        5) echo 6 ;;
        6) echo 7 ;;
        7) echo 8 ;;
        8) echo 9 ;;
        9) echo 10 ;;
        0) echo 11 ;;
        a) echo 30 ;;
        b) echo 48 ;;
        c) echo 46 ;;
        d) echo 32 ;;
        e) echo 18 ;;
        f) echo 33 ;;
        g) echo 34 ;;
        h) echo 35 ;;
        i) echo 23 ;;
        j) echo 36 ;;
        k) echo 37 ;;
        l) echo 38 ;;
        m) echo 50 ;;
        n) echo 49 ;;
        o) echo 24 ;;
        p) echo 25 ;;
        q) echo 16 ;;
        r) echo 19 ;;
        s) echo 31 ;;
        t) echo 20 ;;
        u) echo 22 ;;
        v) echo 47 ;;
        w) echo 17 ;;
        x) echo 45 ;;
        y) echo 21 ;;
        z) echo 44 ;;
        minus|hyphen) echo 12 ;;
        equal) echo 13 ;;
        bracketleft) echo 26 ;;
        bracketright) echo 27 ;;
        semicolon) echo 39 ;;
        apostrophe|quote) echo 40 ;;
        grave) echo 41 ;;
        backslash) echo 43 ;;
        comma) echo 51 ;;
        period) echo 52 ;;
        slash) echo 53 ;;
        *) return 1 ;;
    esac
}

ydotool_shifted_keycode() {
    local key="${1,,}"
    case "$key" in
        exclam|'!') echo 2 ;;
        at|'@') echo 3 ;;
        numbersign|hash|'#') echo 4 ;;
        dollar|'$') echo 5 ;;
        percent|'%') echo 6 ;;
        asciicircum|caret|'^') echo 7 ;;
        ampersand|'&') echo 8 ;;
        asterisk|'*') echo 9 ;;
        parenleft|'(') echo 10 ;;
        parenright|')') echo 11 ;;
        underscore|'_') echo 12 ;;
        plus|'+') echo 13 ;;
        braceleft|'{') echo 26 ;;
        braceright|'}') echo 27 ;;
        colon|':') echo 39 ;;
        quotedbl|'"') echo 40 ;;
        asciitilde|tilde|'~') echo 41 ;;
        bar|'|') echo 43 ;;
        less|'<') echo 51 ;;
        greater|'>') echo 52 ;;
        question|'?') echo 53 ;;
        *) return 1 ;;
    esac
}

ydotool_key_sequence() {
    local chord part code shifted_code i
    local -a parts mods seq
    seq=()
    for chord in "$@"; do
        IFS='+' read -r -a parts <<< "$chord"
        mods=()
        for part in "${parts[@]}"; do
            part="${part//[[:space:]]/}"
            [ -n "$part" ] || continue
            if shifted_code="$(ydotool_shifted_keycode "$part")"; then
                for i in "${mods[@]}"; do seq+=("$i:1"); done
                seq+=("42:1" "$shifted_code:1" "$shifted_code:0" "42:0")
                for (( i=${#mods[@]} - 1; i>=0; i-- )); do seq+=("${mods[$i]}:0"); done
                mods=()
                continue
            fi
            code="$(ydotool_keycode "$part")" || return 1
            case "${part,,}" in
                ctrl|control|control_l|leftctrl|leftcontrol|alt|alt_l|leftalt|shift|shift_l|leftshift|super|meta|win|windows|leftmeta|leftsuper)
                    mods+=("$code")
                    ;;
                *)
                    for i in "${mods[@]}"; do seq+=("$i:1"); done
                    seq+=("$code:1" "$code:0")
                    for (( i=${#mods[@]} - 1; i>=0; i-- )); do seq+=("${mods[$i]}:0"); done
                    mods=()
                    ;;
            esac
        done
        if [ "${#mods[@]}" -gt 0 ]; then
            for i in "${mods[@]}"; do seq+=("$i:1" "$i:0"); done
        fi
    done
    printf '%s\n' "${seq[*]}"
}

qmp_mouse_move() {
    local x="$1" y="$2"
    local w="${QDWIN_SCREEN_W:-1280}" h="${QDWIN_SCREEN_H:-800}"
    local ax=$(( x * 32767 / w ))
    local ay=$(( y * 32767 / h ))
    virsh -c "${LIBVIRT_DEFAULT_URI:-qemu:///session}" qemu-monitor-command "$VM" \
        "{\"execute\":\"input-send-event\",\"arguments\":{\"events\":[{\"type\":\"abs\",\"data\":{\"axis\":\"x\",\"value\":$ax}},{\"type\":\"abs\",\"data\":{\"axis\":\"y\",\"value\":$ay}}]}}" \
        >/dev/null
}

qmp_mouse_button() {
    local button="$1" state="$2"
    local down=true
    [ "$state" = up ] && down=false
    virsh -c "${LIBVIRT_DEFAULT_URI:-qemu:///session}" qemu-monitor-command "$VM" \
        "{\"execute\":\"input-send-event\",\"arguments\":{\"events\":[{\"type\":\"btn\",\"data\":{\"button\":\"$button\",\"down\":$down}}]}}" \
        >/dev/null
}

qmp_click() {
    local x="$1" y="$2" button="${3:-left}"
    qmp_mouse_move "$x" "$y"
    sleep 0.05
    qmp_mouse_button "$button" down
    sleep 0.05
    qmp_mouse_button "$button" up
}

click_artifact_dir() {
    local root=${QCI_GUI_ARTIFACT_DIR:-}
    [ -n "$root" ] || {
        echo "vm-gui: QCI_GUI_ARTIFACT_DIR must name the scenario artifact directory" >&2
        return 2
    }
    mkdir -p "$root/click-targets"
    printf '%s\n' "$root/click-targets"
}

click_log_init() {
    local log=$1
    if [ ! -e "$log" ]; then
        printf 'timestamp_utc\tpreview_id\tphase\tvm\tx\ty\twidth\theight\tlabel\traw\tannotated\tzoom\tpost\n' > "$log"
    fi
}

click_log_row() {
    local log=$1 preview_id=$2 phase=$3 x=$4 y=$5 width=$6 height=$7
    local label=$8 raw=$9 annotated=${10} zoom=${11} post=${12:-}
    label=${label//$'\t'/ }
    label=${label//$'\r'/ }
    label=${label//$'\n'/ }
    click_log_init "$log"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$preview_id" "$phase" "$VM" \
        "$x" "$y" "$width" "$height" "$label" "$raw" \
        "$annotated" "$zoom" "$post" >> "$log"
}

click_next_id() {
    local dir=$1 n=1 id
    while :; do
        id=$(printf 'click-%03d' "$n")
        [ -e "$dir/$id.preview" ] || {
            printf '%s\n' "$id"
            return 0
        }
        n=$((n + 1))
    done
}

click_validate_coordinate() {
    local name=$1 value=$2 limit=$3
    [[ "$value" =~ ^[0-9]+$ ]] || {
        echo "vm-gui: $name must be a non-negative integer (got: $value)" >&2
        return 2
    }
    [ "$value" -lt "$limit" ] || {
        echo "vm-gui: $name=$value is outside screenshot bounds 0..$((limit - 1))" >&2
        return 2
    }
}

click_image_size() {
    local image=$1
    if command -v magick >/dev/null 2>&1; then
        magick identify -format '%w %h\n' "$image"
    elif command -v identify >/dev/null 2>&1; then
        identify -format '%w %h\n' "$image"
    else
        echo "vm-gui: ImageMagick identify is required for click previews" >&2
        return 2
    fi
}

click_annotate_image() {
    local raw=$1 annotated=$2 zoom=$3 x=$4 y=$5 width=$6 height=$7
    local radius=16 tick=24 label_w=136 label_h=28 label_x label_y
    local crop_w=180 crop_h=140 crop_x crop_y image_cmd
    if command -v magick >/dev/null 2>&1; then
        image_cmd=magick
    elif command -v convert >/dev/null 2>&1; then
        image_cmd=convert
    else
        echo "vm-gui: ImageMagick magick/convert is required for click previews" >&2
        return 2
    fi

    if [ $((x + label_w + 24)) -lt "$width" ]; then label_x=$((x + 22)); else label_x=$((x - label_w - 22)); fi
    if [ "$label_x" -lt 2 ]; then label_x=2; fi
    if [ "$y" -gt 42 ]; then label_y=$((y - 36)); else label_y=$((y + 12)); fi
    if [ $((label_y + label_h)) -ge "$height" ]; then label_y=$((height - label_h - 2)); fi

    "$image_cmd" "$raw" \
        -stroke '#ff1744' -strokewidth 4 -fill none \
        -draw "circle $x,$y $((x + radius)),$y" \
        -draw "line $((x - tick)),$y $((x - radius - 3)),$y line $((x + radius + 3)),$y $((x + tick)),$y" \
        -draw "line $x,$((y - tick)) $x,$((y - radius - 3)) line $x,$((y + radius + 3)) $x,$((y + tick))" \
        -fill 'rgba(0,0,0,0.78)' -stroke '#ff1744' -strokewidth 1 \
        -draw "roundrectangle $label_x,$label_y $((label_x + label_w)),$((label_y + label_h)) 5,5" \
        -fill white -stroke none -font DejaVu-Sans -pointsize 16 \
        -annotate "+$((label_x + 8))+$((label_y + 20))" "x=$x  y=$y" \
        "$annotated"

    [ "$crop_w" -le "$width" ] || crop_w=$width
    [ "$crop_h" -le "$height" ] || crop_h=$height
    crop_x=$((x - crop_w / 2)); crop_y=$((y - crop_h / 2))
    [ "$crop_x" -ge 0 ] || crop_x=0
    [ "$crop_y" -ge 0 ] || crop_y=0
    [ $((crop_x + crop_w)) -le "$width" ] || crop_x=$((width - crop_w))
    [ $((crop_y + crop_h)) -le "$height" ] || crop_y=$((height - crop_h))
    "$image_cmd" "$annotated" -crop "${crop_w}x${crop_h}+${crop_x}+${crop_y}" \
        +repage -filter point -resize 300% "$zoom"
}

click_manifest_value() {
    local manifest=$1 key=$2
    awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$manifest"
}

click_preview() {
    local x=$1 y=$2 label=${3:-} dir id raw annotated zoom manifest log
    local width height expected_w=${QDWIN_SCREEN_W:-1280} expected_h=${QDWIN_SCREEN_H:-800}
    local label_b64 created hash
    dir=$(click_artifact_dir) || return $?
    id=$(click_next_id "$dir")
    raw="$dir/$id.raw.png"
    annotated="$dir/$id.annotated.png"
    zoom="$dir/$id.zoom.png"
    manifest="$dir/$id.preview"
    log="$dir/clicks.tsv"

    # Validate against the same geometry qmp_mouse_move uses BEFORE injecting
    # even a move event. Preview deliberately emits no button event: it parks the
    # real guest cursor at the proposal so the visual agent can compare cursor,
    # ImageMagick ring, and widget target before authorising click-confirm.
    click_validate_coordinate x "$x" "$expected_w" || return $?
    click_validate_coordinate y "$y" "$expected_h" || return $?
    qmp_mouse_move "$x" "$y"
    sleep 0.3
    capture_virsh_screenshot "$VM" "$raw"
    read -r width height < <(click_image_size "$raw")
    [ -n "$width" ] && [ -n "$height" ] || return 2
    if [ "$width" -ne "$expected_w" ] || [ "$height" -ne "$expected_h" ]; then
        echo "vm-gui: screenshot is ${width}x${height}, but QMP click mapping expects ${expected_w}x${expected_h}" >&2
        echo "vm-gui: set QDWIN_SCREEN_W/H correctly before previewing a click" >&2
        return 2
    fi
    click_validate_coordinate x "$x" "$width" || return $?
    click_validate_coordinate y "$y" "$height" || return $?
    click_annotate_image "$raw" "$annotated" "$zoom" "$x" "$y" "$width" "$height"
    label_b64=$(printf '%s' "$label" | base64 -w0)
    created=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    hash=$(sha256sum "$raw" | awk '{print $1}')
    {
        printf 'preview_version=1\n'
        printf 'preview_id=%s\n' "$id"
        printf 'vm=%s\n' "$VM"
        printf 'x=%s\n' "$x"
        printf 'y=%s\n' "$y"
        printf 'width=%s\n' "$width"
        printf 'height=%s\n' "$height"
        printf 'label_b64=%s\n' "$label_b64"
        printf 'raw=%s\n' "$raw"
        printf 'annotated=%s\n' "$annotated"
        printf 'zoom=%s\n' "$zoom"
        printf 'raw_sha256=%s\n' "$hash"
        printf 'pointer_moved_before_capture=1\n'
        printf 'button_events_before_confirmation=0\n'
        printf 'created_utc=%s\n' "$created"
    } > "$manifest"
    click_log_row "$log" "$id" preview "$x" "$y" "$width" "$height" \
        "$label" "$raw" "$annotated" "$zoom" ""

    echo "click preview $id: x=$x y=$y"
    echo "pointer moved without a button press before capture"
    echo "annotated: $annotated"
    echo "zoom: $zoom"
    echo "Review both images. If visible, the real cursor must align with the ring."
    echo "If the ring is correct, confirm with:"
    echo "  $0 $VM click-confirm $manifest"
    printf '%s\n' "$manifest"
}

click_confirm() {
    local manifest=$1 dir manifest_real expected_dir preview_id manifest_vm x y width height
    local label_b64 label raw annotated zoom post log confirmed
    [ -f "$manifest" ] || { echo "vm-gui: click preview manifest not found: $manifest" >&2; return 2; }
    dir=$(click_artifact_dir) || return $?
    manifest_real=$(realpath "$manifest")
    expected_dir=$(realpath "$dir")
    case "$manifest_real" in
        "$expected_dir"/*.preview) ;;
        *) echo "vm-gui: refusing click manifest outside $expected_dir: $manifest_real" >&2; return 2 ;;
    esac
    preview_id=$(click_manifest_value "$manifest_real" preview_id)
    manifest_vm=$(click_manifest_value "$manifest_real" vm)
    x=$(click_manifest_value "$manifest_real" x)
    y=$(click_manifest_value "$manifest_real" y)
    width=$(click_manifest_value "$manifest_real" width)
    height=$(click_manifest_value "$manifest_real" height)
    label_b64=$(click_manifest_value "$manifest_real" label_b64)
    label=$(printf '%s' "$label_b64" | base64 -d 2>/dev/null) || label=""
    raw=$(click_manifest_value "$manifest_real" raw)
    annotated=$(click_manifest_value "$manifest_real" annotated)
    zoom=$(click_manifest_value "$manifest_real" zoom)
    [ "$manifest_vm" = "$VM" ] || {
        echo "vm-gui: preview belongs to VM $manifest_vm, not $VM" >&2
        return 2
    }
    click_validate_coordinate x "$x" "$width" || return $?
    click_validate_coordinate y "$y" "$height" || return $?
    [ -f "$annotated" ] && [ -f "$zoom" ] || {
        echo "vm-gui: reviewed preview images are missing for $preview_id" >&2
        return 2
    }
    confirmed="$dir/$preview_id.confirmed"
    [ ! -e "$confirmed" ] || {
        echo "vm-gui: click preview $preview_id was already confirmed" >&2
        return 2
    }

    qmp_click "$x" "$y" left
    sleep 0.3
    post="$dir/$preview_id.post.png"
    capture_virsh_screenshot "$VM" "$post"
    printf 'confirmed_utc=%s\nx=%s\ny=%s\npost=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$x" "$y" "$post" > "$confirmed"
    log="$dir/clicks.tsv"
    click_log_row "$log" "$preview_id" confirmed "$x" "$y" "$width" "$height" \
        "$label" "$raw" "$annotated" "$zoom" "$post"
    echo "confirmed click $preview_id: x=$x y=$y"
    echo "post-click: $post"
}

# Is FILE a frame an agent could actually form a verdict from?
#
# THREE WAYS A CAPTURE IS USELESS, and they are NOT the same failure:
#   2  UNDECODABLE -- truncated/corrupt PNG. Nothing can read it, including any
#      OCR backend. This check exists independently of OCR precisely because OCR
#      is no longer a grading precondition: when it was, a corrupt file failed
#      the OCR gate and was noticed by accident. It no longer is, so readability
#      has to be checked on its own or an undecodable frame reaches the agent
#      looking like a normal capture.
#   3  NEAR-BLACK -- an empty framebuffer: no structure AND dark.
#   4  FLAT -- no structure, but not dark: an all-WHITE or all-grey frame,
#      just as empty and just as useless.
#
# EMPTINESS IS DECIDED BY STRUCTURE, NOT BY BRIGHTNESS, and brightness only
# picks which of the two labels an empty frame gets. This is the opposite of
# what the check did until 2026-09-18, and the reversal is measured, not a
# preference. The old rule refused any frame under 15% bright pixels, with a
# comment claiming "a real dark-theme TUI frame measured well above it and a
# stale black qterminal capture measured 12.6%". The first live capture ever
# taken through this gate refused SIX consecutive frames of the qdlocker lock
# screen -- clock, date, password field, all plainly legible -- at 3.7% bright.
# The stale BLACK frame the cutoff was chosen for is BRIGHTER than a good dark
# one, so no brightness threshold can separate them.
#
# Structure separates them completely. Over 700 frames harvested by the
# 2026-09-16/17 runs: 169 sit under the 15% cutoff, and their standard
# deviation takes exactly two values among the genuinely empty ones -- 0.00000
# (4 frames) and 0.00625 (98, the signature of a black frame with a mouse
# cursor) -- while the next value up is 0.01792. Nothing occupies the gap. The
# 67 remaining sub-15% frames are real content (qdlocker steps, qdshell
# panels, annotated click targets) that the old rule threw away: 9.6% of every
# frame the harness takes.
#
# WHAT THIS GIVES UP, stated because it is a real cost: the brightness cutoff
# was also a crude staleness proxy, and a stale frame showing real content now
# passes the blankness check. Staleness is screenshot_fresh's baseline-hash
# job, and the plain `screenshot` lane has no baseline -- so for that lane the
# proxy is gone rather than replaced. Tune with QCI_FRAME_FLAT_SIGMA rather
# than by restoring a brightness floor.
#
# Return 0 when the frame is usable, or one of the codes above. Return 5 when
# ImageMagick is absent: "cannot tell" must never be silently read as "fine".
FRAME_FLAT_SIGMA=${QCI_FRAME_FLAT_SIGMA:-0.01}
FRAME_BRIGHT_MIN=${QCI_FRAME_BRIGHT_MIN:-0.15}
screenshot_is_usable() {
    local file=$1 dims bright sigma
    command -v magick >/dev/null 2>&1 || return 5
    dims=$(magick identify -quiet -format '%w %h' "$file" 2>/dev/null) || return 2
    case "$dims" in ''|*' 0'|'0 '*) return 2 ;; esac
    sigma=$(magick "$file" -colorspace gray -format '%[fx:standard_deviation]' info: 2>/dev/null) || return 2
    # Varied? Then treat it as a frame, however dark it looks.
    #
    # WHAT THIS ACTUALLY MEASURES, stated plainly because the previous comment
    # here did not: standard deviation is VARIATION, not spatial structure and
    # not legibility. Nothing in this test distinguishes a dark UI from a
    # broken framebuffer whose variation is meaningless. The counterexample is
    # constructible: 99.9% black pixels with 0.1% white scattered at random has
    # a thresholded bright fraction near 0.001, which the old rule refused,
    # and sigma near sqrt(.001*.999) = 0.0316, which this accepts. Hot pixels,
    # a larger cursor or sensor-style noise land the same way. The 700-frame
    # sample below justifies the THRESHOLD for frames this harness has
    # actually seen; it does not make variance into structure (sol, B11).
    #
    # This is a deliberate trade, and the terms are: the variance gate newly
    # accepts every sub-15%-bright frame whose sigma clears the threshold.
    # That class CONTAINS the 67 observed real-content frames counted below,
    # and it also contains noise-like frames meeting the same threshold --
    # they are not two separate classes, they are the wanted and unwanted
    # members of one. How often the unwanted ones occur in practice is NOT
    # established here. A spatial or content measure could separate cases
    # this one cannot; calling it strictly better would need a defined error
    # metric and evidence, and there is neither (sol, C2 rounds 1 and 2).
    awk -v s="$sigma" -v m="$FRAME_FLAT_SIGMA" 'BEGIN { exit !(s < m) }' || return 0
    bright=$(magick "$file" -colorspace gray -threshold 10% \
        -format '%[fx:mean]' info: 2>/dev/null) || return 2
    # Empty. Dark empty is near-black (3); bright empty is flat (4).
    awk -v b="$bright" -v m="$FRAME_BRIGHT_MIN" 'BEGIN { exit !(b < m) }' && return 3
    return 4
}

# Human-readable reason for a screenshot_is_usable code.
screenshot_unusable_reason() {
    case "$1" in
        2) echo "undecodable (truncated or corrupt image)" ;;
        3) echo "near-black (stale framebuffer)" ;;
        4) echo "flat (a single colour fills the frame)" ;;
        5) echo "cannot analyse (ImageMagick 'magick' is not installed)" ;;
        *) echo "unusable (code $1)" ;;
    esac
}

# Publish an accepted candidate to its final path, with THE one ledger row for
# that frame.
#
# ONE ROW PER FRAME (B round 4). Earlier rounds attested every candidate at
# capture time, so a delivered frame carried two rows -- the scratch capture and
# the publication -- and the gate had to pair them back up from their bytes.
# Three review rounds showed that cannot work: identical bytes are not the same
# capture, so real duplicate captures collapsed into one, while a capture to
# /tmp that the scenario copied in did not collapse at all. Candidates are now
# captured UNATTESTED; the row is written when a frame is published.
#
# A failed publication is FATAL: a delivered frame with no row is precisely the
# ungraded-evidence state this path exists to prevent, and the bytes are moved
# out of the frame set (the gate finds frames by image extension) rather than
# left where a later match could grade them.
deliver_attested_frame() {
    local src=$1 dst=$2
    # REFUSE A NON-REGULAR DESTINATION BEFORE PUBLISHING, not after. `-f`
    # dereferences, so a pre-existing SYMLINK was classified as a regular file:
    # the copy followed it and overwrote a file outside the artifact tree, then
    # the symlink was quarantined while the damage stayed done. A FIFO was worse
    # -- `cp -T` blocked in it forever, because the type was only acted on after
    # the copy. `-h` first, then `-f` (sol, B round 5).
    if [ -h "$dst" ] || { [ -e "$dst" ] && [ ! -f "$dst" ]; }; then
        echo "vm-gui: ERROR: refusing to publish a capture to $dst -- it already exists and is not a regular file. It has been left untouched; nothing was captured to that path." >&2
        return 1
    fi
    # A NON-WRITABLE regular file is refused DELIBERATELY. It used to be
    # refused by accident: `cp -T` returned EACCES and the publication failed.
    # Publication now stages and renames, and a rename only needs the DIRECTORY
    # to be writable, so that file would silently be replaced. Whether it should
    # be is a policy question, and the answer that keeps round 7's guarantee --
    # never destroy something the harness did not write, never claim a capture
    # that did not happen -- is to refuse and say so.
    if [ -e "$dst" ] && [ ! -w "$dst" ]; then
        echo "vm-gui: ERROR: refusing to publish a capture to $dst -- a file is already there and is not writable, so it was not written by this harness. It has been left untouched; nothing was captured to that path." >&2
        return 1
    fi
    local prc=0
    if declare -f capture_publish_frame >/dev/null 2>&1; then
        capture_publish_frame "$src" "$dst" "$VM" && return 0
        prc=$?
        # rc=2 is "the copy failed", which is knowledge only the publisher has.
        # Round 7 tried to recover it here by comparing the destination's
        # CONTENT to the source -- which proves what the bytes are, not who
        # wrote them, so a pre-existing read-only file that happened to hold the
        # same bytes was quarantined under a message claiming a capture (sol and
        # fable, B round 7). Nothing was written, so nothing here is ours.
        if [ "$prc" -eq 2 ]; then
            echo "vm-gui: ERROR: could not publish a capture to $dst -- nothing was written there. Anything already at that path was put there by something else and has been left untouched." >&2
            return 1
        fi
        # QUARANTINE ONLY WHAT THIS CALL PUT THERE. Testing `-e` moved whatever
        # already occupied the destination -- a pre-existing DIRECTORY that
        # `cp -T` had correctly refused to overwrite was renamed to
        # `.unattested`, and the error then claimed the frame had been captured
        # and its bytes recovered there. Both were false (sol, B round 4).
        #
        # Past here the copy SUCCEEDED and only the row failed, so the bytes at
        # $dst are ours and are unattested. (The type check above does not by
        # itself make them ours -- that is what the publisher's exit code is
        # for.)
        if [ -f "$dst" ] && [ ! -h "$dst" ]; then
            mv -fT -- "$dst" "$dst.unattested" 2>/dev/null || rm -f -- "$dst"
            echo "vm-gui: ERROR: captured $dst but could NOT record it in the capture ledger, so it is NOT evidence; the bytes are at $dst.unattested" >&2
        else
            echo "vm-gui: ERROR: could not publish a capture to $dst; nothing was written there" >&2
        fi
        return 1
    fi
    # Standalone / older qdistro checkout: no ledger to write to.
    cp -T -- "$src" "$dst" || return 1
    return 0
}

# Record a candidate this tool judged unusable, and keep its bytes for triage
# under a NON-IMAGE name. Both halves matter: the `rejected` row keeps the
# ledger a complete account of what the harness captured, and the name keeps the
# bytes out of the frame set, so a frame the harness already refused can never
# be graded -- nor satisfy the decoded-frame floor on its own.
retain_rejected_candidate() {
    local src=$1 dst=$2 rc=0
    if declare -f capture_attest_rejected >/dev/null 2>&1; then
        # NOT `|| true`. Swallowing this made "the ledger is a complete account
        # of what the harness took" false while the code claimed it: the row
        # could silently go missing and a later attempt could still publish, so
        # the screenshot command succeeded with an incomplete record (sol,
        # B round 4). If completeness is the point, a failure to record is a
        # failure.
        capture_attest_rejected "$src" "$VM" || rc=$?
    fi
    cp -T -- "$src" "$dst" 2>/dev/null || true
    if [ "$rc" -ne 0 ]; then
        echo "vm-gui: ERROR: could not record a rejected capture in the ledger; the account of what this scenario captured is INCOMPLETE (bytes kept at $dst)" >&2
        return "$rc"
    fi
    return 0
}

# Tell the driver when a frame it was just handed is BYTE-IDENTICAL to a frame
# already in the artifact tree. Diagnostic only: it changes no file, no ledger
# row and no exit status. Why it exists: in full-20260922T193137Z-881799
# (permissions-gui/06, /25) and again in the 2026-09-23 rerun of 06, the driver
# graded a capture "entirely black" that was byte-for-byte the same valid frame
# it had graded correctly one step earlier (e.g. s3-cachehit.png ==
# s2-afterapprove.png, mean luma 138/255). Every misread frame was a repeat of
# an earlier one, so the driver's viewer is suspected of not re-rendering a
# repeated image. Naming the twin gives the driver something to check against.
note_identical_frames() {
    local out=$1 dir sum f twins=""
    [ -f "$out" ] || return 0
    dir=$(dirname -- "$out")
    sum=$(sha256sum -- "$out" 2>/dev/null | awk '{print $1}') || return 0
    [ -n "$sum" ] || return 0
    for f in "$dir"/*.png "$dir"/click-targets/*.png; do
        [ -f "$f" ] || continue
        [ "$f" -ef "$out" ] && continue
        [ "$(sha256sum -- "$f" 2>/dev/null | awk '{print $1}')" = "$sum" ] || continue
        twins="$twins ${f#"$dir"/}"
    done
    [ -n "$twins" ] || return 0
    echo "vm-gui: note: $out is BYTE-IDENTICAL to earlier capture(s):$twins -- the screen did not change between them. It is a usable, non-blank frame; if your image viewer shows it blank or black, that is the viewer not re-rendering a repeated image, not the screen. Grade it as the same picture as those files." >&2
    return 0
}

# THE GATE ON THE PLAIN `screenshot` PATH. Before round 9 this path captured and
# attested whatever virsh returned, so a black or corrupt frame was handed to the
# agent looking exactly like a good one -- and an agent that OCR'd it read no
# text and could not distinguish "the control is absent" from "I cannot read
# this". That produced a real FALSE FAIL on a working product (run
# gui-20260916T115528Z: the first S3 capture was 2-colour black, the retries were
# the correct window, and the scenario was reported FAIL).
#
# Retries are taken into a scratch dir and only the ACCEPTED frame is published
# to $out, via deliver_attested_frame, which gives it an IN-TREE ledger row.
# A rejected attempt is recorded under the `rejected` scope, which the gate
# counts NOWHERE, and its bytes are copied beside $out under a non-image name,
# so it can never be graded and tidying it away is free; deleting the delivered
# frame is not.
# If no attempt is usable this returns NONZERO rather than yielding a bad frame:
# the caller must not be handed something it cannot form a verdict from.
capture_usable_screenshot() {
    local out=$1 attempts=${2:-3}
    local i candidate rc scratch
    [[ "$attempts" =~ ^[1-9][0-9]*$ ]] || {
        echo "vm-gui: screenshot attempts must be a positive integer" >&2
        return 1
    }
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/qci-shot.XXXXXX") || return 1
    for (( i=1; i<=attempts; i++ )); do
        candidate="$scratch/attempt-${i}.png"
        capture_virsh_shot "$VM" "$candidate" \
            || { rc=$?; rm -rf -- "$scratch"; return "$rc"; }
        rc=0
        screenshot_is_usable "$candidate" || rc=$?
        if [ "$rc" -eq 0 ]; then
            deliver_attested_frame "$candidate" "$out" || { rm -rf -- "$scratch"; return 1; }
            rm -rf -- "$scratch"
            note_identical_frames "$out"
            return 0
        fi
        if [ "$rc" -eq 5 ]; then
            # No analyser. Do not pretend the frame was checked: hand it over and
            # say plainly that it was not.
            deliver_attested_frame "$candidate" "$out" || { rm -rf -- "$scratch"; return 1; }
            rm -rf -- "$scratch"
            echo "vm-gui: WARNING: screenshot NOT checked for blankness -- $(screenshot_unusable_reason 5)" >&2
            note_identical_frames "$out"
            return 0
        fi
        # NOT under an image extension: the gate finds frames BY EXTENSION, so
        # an image-named copy of a candidate the harness already judged
        # unusable (blank, wrong window) could be picked up and graded, and
        # could even satisfy the decoded-frame floor on its own. The candidate
        # itself carries no row until it is published or refused; on refusal it
        # gets a `rejected` row, which the gate counts NOWHERE, and the bytes
        # remain beside $out for triage. (This comment used to explain the name
        # by saying the library had attested the candidate at capture time.
        # That model was removed in round 6 and both round-5 reviewers listed
        # this site; the name is still right, the reason was not.)
        retain_rejected_candidate "$candidate" "${out}.attempt-${i}.rejected" || {
            rm -rf -- "$scratch"; return 1; }
        echo "vm-gui: screenshot attempt $i/$attempts rejected: $(screenshot_unusable_reason "$rc") (${out}.attempt-${i}.rejected)" >&2
        [ "$i" -lt "$attempts" ] && sleep 1
    done
    rm -rf -- "$scratch"
    echo "vm-gui: ERROR: no usable screenshot after $attempts attempts; rejected attempts retained beside $out. Do NOT record a visual PASS or FAIL from a frame you never received -- this is an ERROR condition." >&2
    return 1
}

screenshot_fresh() {
    local out=$1 baseline=${2:-} attempts=${3:-3}
    local i candidate hash baseline_hash reason rc unchecked
    [[ "$attempts" =~ ^[1-9][0-9]*$ ]] || {
        echo "vm-gui: screenshot-fresh attempts must be a positive integer" >&2
        return 2
    }
    baseline_hash=""
    if [ -n "$baseline" ]; then
        [ -f "$baseline" ] || {
            echo "vm-gui: screenshot-fresh baseline does not exist: $baseline" >&2
            return 2
        }
        baseline_hash=$(sha256sum "$baseline" | awk '{print $1}')
    fi
    # Candidates are captured OUT OF TREE (a private scratch dir) and carry NO
    # ledger row: the candidate capture writes nothing, so a frame that is never
    # published leaves no trace claiming to be evidence. On acceptance the
    # publication writes the SINGLE row for that frame, in-tree, so its bytes
    # going missing afterwards is a real omission. On rejection the candidate
    # gets a `rejected` row -- which the gate counts NOWHERE -- and its bytes
    # are kept beside $out under a non-image name, so tidying them away is free
    # and they can never be graded.
    local scratch
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/qci-shotfresh.XXXXXX") || return 1
    for (( i=1; i<=attempts; i++ )); do
        candidate="$scratch/attempt-${i}.png"
        capture_virsh_shot "$VM" "$candidate" \
            || { local caprc=$?; rm -rf -- "$scratch"; return "$caprc"; }
        # ONE USABILITY GATE FOR BOTH LANES. This loop used to carry its own
        # black-only check (`screenshot_is_black`, a hard-coded 0.15 cutoff),
        # while the `screenshot` lane used screenshot_is_usable. Two gates meant
        # this lane could not see an UNDECODABLE or a FLAT frame at all, and the
        # cutoff here ignored QCI_FRAME_BRIGHT_MIN.
        #
        # THE NEAR-BLACK BEHAVIOUR HERE IS NOT UNCHANGED -- an earlier version
        # of this comment claimed it was, on the grounds that FRAME_BRIGHT_MIN
        # defaults to the same 0.15 (sol, B11). The default matches, but the
        # cutoff is no longer reached the same way: screenshot_is_usable tests
        # sigma FIRST and returns usable before computing brightness at all.
        # This lane previously refused every frame under 15% bright; it now
        # accepts any such frame whose sigma is at least FRAME_FLAT_SIGMA.
        # That reversal is the point of the change, and it belongs in the
        # comment rather than a claim of continuity.
        reason=""
        unchecked=""
        # `|| rc=$?`, NOT `; rc=$?`: this runs under `set -e`, so a bare
        # `; rc=$?` lets the first unusable frame kill vm-gui outright -- no
        # message, no retry, exit status 3. The `screenshot` lane survived that
        # only because its caller writes `... || exit $?`, which disables errexit
        # for the whole call; screenshot-fresh has no such caller and died. Both
        # sites are written the safe way rather than relying on the caller.
        rc=0
        screenshot_is_usable "$candidate" || rc=$?
        case "$rc" in
            0) ;;
            5) unchecked=1 ;;   # no analyser -- see below
            *) reason=$(screenshot_unusable_reason "$rc") ;;
        esac
        # The baseline comparison needs no analyser, so it still runs when the
        # frame could not be judged.
        if [ -z "$reason" ] && [ -n "$baseline_hash" ]; then
            hash=$(sha256sum "$candidate" | awk '{print $1}')
            [ "$hash" = "$baseline_hash" ] && reason="unchanged-baseline"
        fi
        if [ -z "$reason" ]; then
            deliver_attested_frame "$candidate" "$out" || { rm -rf -- "$scratch"; return 1; }
            rm -rf -- "$scratch"
            # A MISSING ANALYSER NO LONGER FAILS THIS LANE. It used to return
            # the probe's own rc, so a host without ImageMagick could not take a
            # fresh screenshot at all -- while the `screenshot` lane delivered
            # the frame and said plainly it was unchecked. Same choice here: the
            # freshness guarantee (bytes differ from the baseline) is still
            # enforced, and only the blankness judgement is absent.
            [ -n "$unchecked" ] && \
                echo "vm-gui: WARNING: screenshot NOT checked for blankness -- $(screenshot_unusable_reason 5)" >&2
            echo "$out"
            return 0
        fi
        # Keep the rejected frame beside $out for triage, under a NON-IMAGE
        # name, for the reason given in screenshot(): the gate finds frames by
        # extension, and a refused frame must not be able to enter the evidence
        # set. Its `rejected` row is counted nowhere, so deleting the bytes is
        # free. (Same stale attest-at-capture rationale as above, same fix.)
        retain_rejected_candidate "$candidate" "${out}.attempt-${i}.rejected" || {
            rm -rf -- "$scratch"; return 1; }
        echo "vm-gui: screenshot attempt $i/$attempts rejected: $reason (${out}.attempt-${i}.rejected)" >&2
        [ "$i" -lt "$attempts" ] && sleep 1
    done
    rm -rf -- "$scratch"
    echo "vm-gui: no fresh usable screenshot after $attempts attempts; attempts retained beside $out" >&2
    return 1
}

case "$CMD" in
    screenshot)
        OUT="${1:-/tmp/vm-screenshot.png}"
        capture_usable_screenshot "$OUT" "${QCI_SCREENSHOT_ATTEMPTS:-3}" || exit $?
        echo "$OUT"
        ;;
    screenshot-fresh)
        OUT="${1:?Usage: vm-gui <vm> screenshot-fresh <file> [baseline] [attempts]}"
        screenshot_fresh "$OUT" "${2:-}" "${3:-3}"
        ;;
    start)
        APP="$*"
        "$VM_EXEC" "$VM" "su - admin -c 'DISPLAY=:0 $APP &'"
        sleep 2
        ;;
    activate)
        TITLE="$*"
        run_as_jan "wid=\$(xdotool search --onlyvisible --name \".*${TITLE}.*\" | head -n1); [ -n \"\$wid\" ] && xdotool windowactivate --sync \"\$wid\" windowraise \"\$wid\""
        sleep 0.5
        ;;
    click-preview)
        X="${1:?Usage: vm-gui <vm> click-preview <x> <y> [label]}"
        Y="${2:?Usage: vm-gui <vm> click-preview <x> <y> [label]}"
        shift 2
        click_preview "$X" "$Y" "$*"
        ;;
    click-confirm)
        MANIFEST="${1:?Usage: vm-gui <vm> click-confirm <preview-manifest>}"
        click_confirm "$MANIFEST"
        ;;
    click)
        X="${1:?Usage: vm-gui <vm> click <x> <y>}"
        Y="${2:?Usage: vm-gui <vm> click <x> <y>}"
        qmp_click "$X" "$Y" left
        sleep 0.3
        ;;
    rightclick)
        X="${1:?Usage: vm-gui <vm> rightclick <x> <y>}"
        Y="${2:?Usage: vm-gui <vm> rightclick <x> <y>}"
        qmp_click "$X" "$Y" right
        sleep 0.3
        ;;
    doubleclick)
        X="${1:?Usage: vm-gui <vm> doubleclick <x> <y>}"
        Y="${2:?Usage: vm-gui <vm> doubleclick <x> <y>}"
        qmp_click "$X" "$Y" left
        sleep 0.1
        qmp_click "$X" "$Y" left
        sleep 0.3
        ;;
    drag)
        X1="${1:?Usage: vm-gui <vm> drag <x1> <y1> <x2> <y2>}"
        Y1="${2:?}"
        X2="${3:?}"
        Y2="${4:?}"
        qmp_mouse_move "$X1" "$Y1"
        sleep 0.08
        qmp_mouse_button left down
        for i in 1 2 3 4 5 6 7 8; do
            qmp_mouse_move "$(( X1 + (X2 - X1) * i / 8 ))" \
                           "$(( Y1 + (Y2 - Y1) * i / 8 ))"
            sleep 0.03
        done
        qmp_mouse_button left up
        sleep 0.3
        ;;
    scroll)
        DIR="${1:?Usage: vm-gui <vm> scroll <up|down> [clicks]}"
        CLICKS="${2:-3}"
        case "$DIR" in
            up)   BUTTON=4 ;;
            down) BUTTON=5 ;;
            *) echo "scroll direction: up or down" >&2; exit 1 ;;
        esac
        run_as_jan "xdotool click --repeat $CLICKS --delay 50 $BUTTON"
        sleep 0.3
        ;;
    windowsize)
        TITLE="${1:?Usage: vm-gui <vm> windowsize <title> <w> <h>}"
        W="${2:?}"
        H="${3:?}"
        run_as_jan "xdotool search --name '.*${TITLE}.*' windowsize $W $H"
        sleep 0.3
        ;;
    windowmove)
        TITLE="${1:?Usage: vm-gui <vm> windowmove <title> <x> <y>}"
        X="${2:?}"
        Y="${3:?}"
        run_as_jan "xdotool search --name '.*${TITLE}.*' windowmove $X $Y"
        sleep 0.3
        ;;
    type)
        TEXT="$*"
        if have_ydotool; then
            run_input "ydotool type --key-delay=$DELAY $(shell_quote "$TEXT")"
        else
            # Send each character as a key event to handle spaces properly
            for (( i=0; i<${#TEXT}; i++ )); do
                char="${TEXT:$i:1}"
                case "$char" in
                    ' ') KEY="space" ;;
                    '.')  KEY="period" ;;
                    ',')  KEY="comma" ;;
                    '/')  KEY="slash" ;;
                    '-')  KEY="minus" ;;
                    '=')  KEY="equal" ;;
                    ';')  KEY="semicolon" ;;
                    "'")  KEY="apostrophe" ;;
                    '[')  KEY="bracketleft" ;;
                    ']')  KEY="bracketright" ;;
                    '!')  KEY="shift+1" ;;
                    '@')  KEY="shift+2" ;;
                    '#')  KEY="shift+3" ;;
                    '$')  KEY="shift+4" ;;
                    '%')  KEY="shift+5" ;;
                    '^')  KEY="shift+6" ;;
                    '&')  KEY="shift+7" ;;
                    '*')  KEY="shift+8" ;;
                    '(')  KEY="shift+9" ;;
                    ')')  KEY="shift+0" ;;
                    '_')  KEY="shift+minus" ;;
                    '+')  KEY="shift+equal" ;;
                    ':')  KEY="shift+semicolon" ;;
                    '"')  KEY="shift+apostrophe" ;;
                    '<')  KEY="shift+comma" ;;
                    '>')  KEY="shift+period" ;;
                    '?')  KEY="shift+slash" ;;
                    '~')  KEY="shift+grave" ;;
                    '`')  KEY="grave" ;;
                    *)
                        if [[ "$char" =~ [A-Z] ]]; then
                            KEY="shift+${char,,}"
                        else
                            KEY="$char"
                        fi
                        ;;
                esac
                run_as_jan "xdotool key $KEY" 2>/dev/null
                sleep "0.$(printf '%03d' $DELAY)"
            done
        fi
        ;;
    key)
        if have_ydotool; then
            KEY_EVENTS="$(ydotool_key_sequence "$@")" \
                || { echo "vm-gui: unsupported ydotool key name(s): $*" >&2; exit 2; }
            run_input "ydotool key --key-delay=$DELAY $KEY_EVENTS"
        else
            run_as_jan "xdotool key $*"
        fi
        sleep 0.3
        ;;
    wait)
        SECS="${1:-2}"
        sleep "$SECS"
        ;;
    *)
        echo "Unknown command: $CMD" >&2
        echo "Commands: screenshot, start, activate, click-preview, click-confirm, click, rightclick, doubleclick, drag, scroll, type, key, windowsize, windowmove, wait" >&2
        exit 1
        ;;
esac
