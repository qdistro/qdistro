#!/bin/bash
#
# vm-gui — GUI automation for VMs via xdotool + virsh screenshot.
#
# Usage:
#   vm-gui <vm> screenshot [file]        Take screenshot (default: /tmp/vm-screenshot.png)
#   vm-gui <vm> screenshot-fresh <file> [baseline] [attempts]
#                                         Retry stale/near-black captures (default: 3 tries)
#   vm-gui <vm> start <command>          Launch a GUI app
#   vm-gui <vm> activate <title>         Focus window by title (wildcard match)
#   vm-gui <vm> click-preview <x> <y> [label]
#                                         Move pointer; save raw/marked/zoom review images
#   vm-gui <vm> click-confirm <manifest> Click the exact reviewed coordinates
#   vm-gui <vm> click <x> <y>           Left-click at coordinates
#   vm-gui <vm> rightclick <x> <y>      Right-click at coordinates
#   vm-gui <vm> doubleclick <x> <y>     Double-click at coordinates
#   vm-gui <vm> drag <x1> <y1> <x2> <y2>  Drag from (x1,y1) to (x2,y2)
#   vm-gui <vm> scroll <up|down> [n]    Scroll mouse wheel (default: 3 clicks)
#   vm-gui <vm> type <text>             Type text (100ms delay between keys)
#   vm-gui <vm> key <key> [key...]      Send key(s): Return, Tab, ctrl+c, alt+F4, ...
#   vm-gui <vm> windowsize <title> <w> <h>   Resize window
#   vm-gui <vm> windowmove <title> <x> <y>   Move window
#   vm-gui <vm> wait [seconds]          Wait (default: 2)
#
set -euo pipefail

VM="${1:?Usage: $0 <vm> <command> [args...]}"
CMD="${2:?Usage: $0 <vm> <command> [args...]}"
shift 2

VM_EXEC="$(dirname "$0")/vm-exec"
DELAY=100

run_as_jan() {
    "$VM_EXEC" "$VM" "su - admin -c 'export DISPLAY=:0; $1'"
}

shell_quote() {
    printf "'"
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
    printf "'"
}

run_input() {
    "$VM_EXEC" "$VM" "runuser -u admin -- env DISPLAY=:0 XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-1 YDOTOOL_SOCKET=/run/user/1000/ydotool.sock $1"
}

have_ydotool() {
    "$VM_EXEC" "$VM" "runuser -u admin -- bash -lc 'command -v ydotool >/dev/null 2>&1 && [ -S /run/user/1000/ydotool.sock ]'" >/dev/null 2>&1
}

ydotool_keycode() {
    local key="${1,,}"
    case "$key" in
        ctrl|control|control_l|leftctrl|leftcontrol) echo 29 ;;
        alt|alt_l|leftalt) echo 56 ;;
        shift|shift_l|leftshift) echo 42 ;;
        super|meta|win|windows|leftmeta|leftsuper) echo 125 ;;
        enter|return) echo 28 ;;
        esc|escape) echo 1 ;;
        tab) echo 15 ;;
        space) echo 57 ;;
        backspace) echo 14 ;;
        delete|del) echo 111 ;;
        up) echo 103 ;;
        down) echo 108 ;;
        left) echo 105 ;;
        right) echo 106 ;;
        home) echo 102 ;;
        end) echo 107 ;;
        page_up|pageup|prior) echo 104 ;;
        page_down|pagedown|next) echo 109 ;;
        f1) echo 59 ;;
        f2) echo 60 ;;
        f3) echo 61 ;;
        f4) echo 62 ;;
        f5) echo 63 ;;
        f6) echo 64 ;;
        f7) echo 65 ;;
        f8) echo 66 ;;
        f9) echo 67 ;;
        f10) echo 68 ;;
        f11) echo 87 ;;
        f12) echo 88 ;;
        1) echo 2 ;;
        2) echo 3 ;;
        3) echo 4 ;;
        4) echo 5 ;;
        5) echo 6 ;;
        6) echo 7 ;;
        7) echo 8 ;;
        8) echo 9 ;;
        9) echo 10 ;;
        0) echo 11 ;;
        a) echo 30 ;;
        b) echo 48 ;;
        c) echo 46 ;;
        d) echo 32 ;;
        e) echo 18 ;;
        f) echo 33 ;;
        g) echo 34 ;;
        h) echo 35 ;;
        i) echo 23 ;;
        j) echo 36 ;;
        k) echo 37 ;;
        l) echo 38 ;;
        m) echo 50 ;;
        n) echo 49 ;;
        o) echo 24 ;;
        p) echo 25 ;;
        q) echo 16 ;;
        r) echo 19 ;;
        s) echo 31 ;;
        t) echo 20 ;;
        u) echo 22 ;;
        v) echo 47 ;;
        w) echo 17 ;;
        x) echo 45 ;;
        y) echo 21 ;;
        z) echo 44 ;;
        minus|hyphen) echo 12 ;;
        equal) echo 13 ;;
        bracketleft) echo 26 ;;
        bracketright) echo 27 ;;
        semicolon) echo 39 ;;
        apostrophe|quote) echo 40 ;;
        grave) echo 41 ;;
        backslash) echo 43 ;;
        comma) echo 51 ;;
        period) echo 52 ;;
        slash) echo 53 ;;
        *) return 1 ;;
    esac
}

ydotool_shifted_keycode() {
    local key="${1,,}"
    case "$key" in
        exclam|'!') echo 2 ;;
        at|'@') echo 3 ;;
        numbersign|hash|'#') echo 4 ;;
        dollar|'$') echo 5 ;;
        percent|'%') echo 6 ;;
        asciicircum|caret|'^') echo 7 ;;
        ampersand|'&') echo 8 ;;
        asterisk|'*') echo 9 ;;
        parenleft|'(') echo 10 ;;
        parenright|')') echo 11 ;;
        underscore|'_') echo 12 ;;
        plus|'+') echo 13 ;;
        braceleft|'{') echo 26 ;;
        braceright|'}') echo 27 ;;
        colon|':') echo 39 ;;
        quotedbl|'"') echo 40 ;;
        asciitilde|tilde|'~') echo 41 ;;
        bar|'|') echo 43 ;;
        less|'<') echo 51 ;;
        greater|'>') echo 52 ;;
        question|'?') echo 53 ;;
        *) return 1 ;;
    esac
}

ydotool_key_sequence() {
    local chord part code shifted_code i
    local -a parts mods seq
    seq=()
    for chord in "$@"; do
        IFS='+' read -r -a parts <<< "$chord"
        mods=()
        for part in "${parts[@]}"; do
            part="${part//[[:space:]]/}"
            [ -n "$part" ] || continue
            if shifted_code="$(ydotool_shifted_keycode "$part")"; then
                for i in "${mods[@]}"; do seq+=("$i:1"); done
                seq+=("42:1" "$shifted_code:1" "$shifted_code:0" "42:0")
                for (( i=${#mods[@]} - 1; i>=0; i-- )); do seq+=("${mods[$i]}:0"); done
                mods=()
                continue
            fi
            code="$(ydotool_keycode "$part")" || return 1
            case "${part,,}" in
                ctrl|control|control_l|leftctrl|leftcontrol|alt|alt_l|leftalt|shift|shift_l|leftshift|super|meta|win|windows|leftmeta|leftsuper)
                    mods+=("$code")
                    ;;
                *)
                    for i in "${mods[@]}"; do seq+=("$i:1"); done
                    seq+=("$code:1" "$code:0")
                    for (( i=${#mods[@]} - 1; i>=0; i-- )); do seq+=("${mods[$i]}:0"); done
                    mods=()
                    ;;
            esac
        done
        if [ "${#mods[@]}" -gt 0 ]; then
            for i in "${mods[@]}"; do seq+=("$i:1" "$i:0"); done
        fi
    done
    printf '%s\n' "${seq[*]}"
}

qmp_mouse_move() {
    local x="$1" y="$2"
    local w="${QDWIN_SCREEN_W:-1280}" h="${QDWIN_SCREEN_H:-800}"
    local ax=$(( x * 32767 / w ))
    local ay=$(( y * 32767 / h ))
    virsh -c "${LIBVIRT_DEFAULT_URI:-qemu:///session}" qemu-monitor-command "$VM" \
        "{\"execute\":\"input-send-event\",\"arguments\":{\"events\":[{\"type\":\"abs\",\"data\":{\"axis\":\"x\",\"value\":$ax}},{\"type\":\"abs\",\"data\":{\"axis\":\"y\",\"value\":$ay}}]}}" \
        >/dev/null
}

qmp_mouse_button() {
    local button="$1" state="$2"
    local down=true
    [ "$state" = up ] && down=false
    virsh -c "${LIBVIRT_DEFAULT_URI:-qemu:///session}" qemu-monitor-command "$VM" \
        "{\"execute\":\"input-send-event\",\"arguments\":{\"events\":[{\"type\":\"btn\",\"data\":{\"button\":\"$button\",\"down\":$down}}]}}" \
        >/dev/null
}

qmp_click() {
    local x="$1" y="$2" button="${3:-left}"
    qmp_mouse_move "$x" "$y"
    sleep 0.05
    qmp_mouse_button "$button" down
    sleep 0.05
    qmp_mouse_button "$button" up
}

click_artifact_dir() {
    local root=${QCI_GUI_ARTIFACT_DIR:-}
    [ -n "$root" ] || {
        echo "vm-gui: QCI_GUI_ARTIFACT_DIR must name the scenario artifact directory" >&2
        return 2
    }
    mkdir -p "$root/click-targets"
    printf '%s\n' "$root/click-targets"
}

click_log_init() {
    local log=$1
    if [ ! -e "$log" ]; then
        printf 'timestamp_utc\tpreview_id\tphase\tvm\tx\ty\twidth\theight\tlabel\traw\tannotated\tzoom\tpost\n' > "$log"
    fi
}

click_log_row() {
    local log=$1 preview_id=$2 phase=$3 x=$4 y=$5 width=$6 height=$7
    local label=$8 raw=$9 annotated=${10} zoom=${11} post=${12:-}
    label=${label//$'\t'/ }
    label=${label//$'\r'/ }
    label=${label//$'\n'/ }
    click_log_init "$log"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$preview_id" "$phase" "$VM" \
        "$x" "$y" "$width" "$height" "$label" "$raw" \
        "$annotated" "$zoom" "$post" >> "$log"
}

click_next_id() {
    local dir=$1 n=1 id
    while :; do
        id=$(printf 'click-%03d' "$n")
        [ -e "$dir/$id.preview" ] || {
            printf '%s\n' "$id"
            return 0
        }
        n=$((n + 1))
    done
}

click_validate_coordinate() {
    local name=$1 value=$2 limit=$3
    [[ "$value" =~ ^[0-9]+$ ]] || {
        echo "vm-gui: $name must be a non-negative integer (got: $value)" >&2
        return 2
    }
    [ "$value" -lt "$limit" ] || {
        echo "vm-gui: $name=$value is outside screenshot bounds 0..$((limit - 1))" >&2
        return 2
    }
}

click_image_size() {
    local image=$1
    if command -v magick >/dev/null 2>&1; then
        magick identify -format '%w %h\n' "$image"
    elif command -v identify >/dev/null 2>&1; then
        identify -format '%w %h\n' "$image"
    else
        echo "vm-gui: ImageMagick identify is required for click previews" >&2
        return 2
    fi
}

click_annotate_image() {
    local raw=$1 annotated=$2 zoom=$3 x=$4 y=$5 width=$6 height=$7
    local radius=16 tick=24 label_w=136 label_h=28 label_x label_y
    local crop_w=180 crop_h=140 crop_x crop_y image_cmd
    if command -v magick >/dev/null 2>&1; then
        image_cmd=magick
    elif command -v convert >/dev/null 2>&1; then
        image_cmd=convert
    else
        echo "vm-gui: ImageMagick magick/convert is required for click previews" >&2
        return 2
    fi

    if [ $((x + label_w + 24)) -lt "$width" ]; then label_x=$((x + 22)); else label_x=$((x - label_w - 22)); fi
    if [ "$label_x" -lt 2 ]; then label_x=2; fi
    if [ "$y" -gt 42 ]; then label_y=$((y - 36)); else label_y=$((y + 12)); fi
    if [ $((label_y + label_h)) -ge "$height" ]; then label_y=$((height - label_h - 2)); fi

    "$image_cmd" "$raw" \
        -stroke '#ff1744' -strokewidth 4 -fill none \
        -draw "circle $x,$y $((x + radius)),$y" \
        -draw "line $((x - tick)),$y $((x - radius - 3)),$y line $((x + radius + 3)),$y $((x + tick)),$y" \
        -draw "line $x,$((y - tick)) $x,$((y - radius - 3)) line $x,$((y + radius + 3)) $x,$((y + tick))" \
        -fill 'rgba(0,0,0,0.78)' -stroke '#ff1744' -strokewidth 1 \
        -draw "roundrectangle $label_x,$label_y $((label_x + label_w)),$((label_y + label_h)) 5,5" \
        -fill white -stroke none -font DejaVu-Sans -pointsize 16 \
        -annotate "+$((label_x + 8))+$((label_y + 20))" "x=$x  y=$y" \
        "$annotated"

    [ "$crop_w" -le "$width" ] || crop_w=$width
    [ "$crop_h" -le "$height" ] || crop_h=$height
    crop_x=$((x - crop_w / 2)); crop_y=$((y - crop_h / 2))
    [ "$crop_x" -ge 0 ] || crop_x=0
    [ "$crop_y" -ge 0 ] || crop_y=0
    [ $((crop_x + crop_w)) -le "$width" ] || crop_x=$((width - crop_w))
    [ $((crop_y + crop_h)) -le "$height" ] || crop_y=$((height - crop_h))
    "$image_cmd" "$annotated" -crop "${crop_w}x${crop_h}+${crop_x}+${crop_y}" \
        +repage -filter point -resize 300% "$zoom"
}

click_manifest_value() {
    local manifest=$1 key=$2
    awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$manifest"
}

click_preview() {
    local x=$1 y=$2 label=${3:-} dir id raw annotated zoom manifest log
    local width height expected_w=${QDWIN_SCREEN_W:-1280} expected_h=${QDWIN_SCREEN_H:-800}
    local label_b64 created hash
    dir=$(click_artifact_dir) || return $?
    id=$(click_next_id "$dir")
    raw="$dir/$id.raw.png"
    annotated="$dir/$id.annotated.png"
    zoom="$dir/$id.zoom.png"
    manifest="$dir/$id.preview"
    log="$dir/clicks.tsv"

    # Validate against the same geometry qmp_mouse_move uses BEFORE injecting
    # even a move event. Preview deliberately emits no button event: it parks the
    # real guest cursor at the proposal so the visual agent can compare cursor,
    # ImageMagick ring, and widget target before authorising click-confirm.
    click_validate_coordinate x "$x" "$expected_w" || return $?
    click_validate_coordinate y "$y" "$expected_h" || return $?
    qmp_mouse_move "$x" "$y"
    sleep 0.3
    virsh -c "${LIBVIRT_DEFAULT_URI:-qemu:///session}" screenshot "$VM" "$raw" >/dev/null
    read -r width height < <(click_image_size "$raw")
    [ -n "$width" ] && [ -n "$height" ] || return 2
    if [ "$width" -ne "$expected_w" ] || [ "$height" -ne "$expected_h" ]; then
        echo "vm-gui: screenshot is ${width}x${height}, but QMP click mapping expects ${expected_w}x${expected_h}" >&2
        echo "vm-gui: set QDWIN_SCREEN_W/H correctly before previewing a click" >&2
        return 2
    fi
    click_validate_coordinate x "$x" "$width" || return $?
    click_validate_coordinate y "$y" "$height" || return $?
    click_annotate_image "$raw" "$annotated" "$zoom" "$x" "$y" "$width" "$height"
    label_b64=$(printf '%s' "$label" | base64 -w0)
    created=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    hash=$(sha256sum "$raw" | awk '{print $1}')
    {
        printf 'preview_version=1\n'
        printf 'preview_id=%s\n' "$id"
        printf 'vm=%s\n' "$VM"
        printf 'x=%s\n' "$x"
        printf 'y=%s\n' "$y"
        printf 'width=%s\n' "$width"
        printf 'height=%s\n' "$height"
        printf 'label_b64=%s\n' "$label_b64"
        printf 'raw=%s\n' "$raw"
        printf 'annotated=%s\n' "$annotated"
        printf 'zoom=%s\n' "$zoom"
        printf 'raw_sha256=%s\n' "$hash"
        printf 'pointer_moved_before_capture=1\n'
        printf 'button_events_before_confirmation=0\n'
        printf 'created_utc=%s\n' "$created"
    } > "$manifest"
    click_log_row "$log" "$id" preview "$x" "$y" "$width" "$height" \
        "$label" "$raw" "$annotated" "$zoom" ""

    echo "click preview $id: x=$x y=$y"
    echo "pointer moved without a button press before capture"
    echo "annotated: $annotated"
    echo "zoom: $zoom"
    echo "Review both images. If visible, the real cursor must align with the ring."
    echo "If the ring is correct, confirm with:"
    echo "  $0 $VM click-confirm $manifest"
    printf '%s\n' "$manifest"
}

click_confirm() {
    local manifest=$1 dir manifest_real expected_dir preview_id manifest_vm x y width height
    local label_b64 label raw annotated zoom post log confirmed
    [ -f "$manifest" ] || { echo "vm-gui: click preview manifest not found: $manifest" >&2; return 2; }
    dir=$(click_artifact_dir) || return $?
    manifest_real=$(realpath "$manifest")
    expected_dir=$(realpath "$dir")
    case "$manifest_real" in
        "$expected_dir"/*.preview) ;;
        *) echo "vm-gui: refusing click manifest outside $expected_dir: $manifest_real" >&2; return 2 ;;
    esac
    preview_id=$(click_manifest_value "$manifest_real" preview_id)
    manifest_vm=$(click_manifest_value "$manifest_real" vm)
    x=$(click_manifest_value "$manifest_real" x)
    y=$(click_manifest_value "$manifest_real" y)
    width=$(click_manifest_value "$manifest_real" width)
    height=$(click_manifest_value "$manifest_real" height)
    label_b64=$(click_manifest_value "$manifest_real" label_b64)
    label=$(printf '%s' "$label_b64" | base64 -d 2>/dev/null) || label=""
    raw=$(click_manifest_value "$manifest_real" raw)
    annotated=$(click_manifest_value "$manifest_real" annotated)
    zoom=$(click_manifest_value "$manifest_real" zoom)
    [ "$manifest_vm" = "$VM" ] || {
        echo "vm-gui: preview belongs to VM $manifest_vm, not $VM" >&2
        return 2
    }
    click_validate_coordinate x "$x" "$width" || return $?
    click_validate_coordinate y "$y" "$height" || return $?
    [ -f "$annotated" ] && [ -f "$zoom" ] || {
        echo "vm-gui: reviewed preview images are missing for $preview_id" >&2
        return 2
    }
    confirmed="$dir/$preview_id.confirmed"
    [ ! -e "$confirmed" ] || {
        echo "vm-gui: click preview $preview_id was already confirmed" >&2
        return 2
    }

    qmp_click "$x" "$y" left
    sleep 0.3
    post="$dir/$preview_id.post.png"
    virsh -c "${LIBVIRT_DEFAULT_URI:-qemu:///session}" screenshot "$VM" "$post" >/dev/null
    printf 'confirmed_utc=%s\nx=%s\ny=%s\npost=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$x" "$y" "$post" > "$confirmed"
    log="$dir/clicks.tsv"
    click_log_row "$log" "$preview_id" confirmed "$x" "$y" "$width" "$height" \
        "$label" "$raw" "$annotated" "$zoom" "$post"
    echo "confirmed click $preview_id: x=$x y=$y"
    echo "post-click: $post"
}

# Returns success if FILE is overwhelmingly black. A valid dark-theme TUI
# frame still has substantial bright text/chrome; a stale black qterminal
# capture from virsh screenshot measured 12.6% bright pixels. Keep the 15%
# cutoff deliberately conservative and leave the raw attempts beside OUT for
# triage rather than silently accepting a suspect frame.
screenshot_is_black() {
    local file=$1 bright
    command -v magick >/dev/null 2>&1 || return 2
    bright=$(magick "$file" -colorspace gray -threshold 10% \
        -format '%[fx:mean]' info: 2>/dev/null) || return 2
    awk -v bright="$bright" 'BEGIN { exit !(bright < 0.15) }'
}

screenshot_fresh() {
    local out=$1 baseline=${2:-} attempts=${3:-3}
    local i candidate hash baseline_hash reason
    [[ "$attempts" =~ ^[1-9][0-9]*$ ]] || {
        echo "vm-gui: screenshot-fresh attempts must be a positive integer" >&2
        return 2
    }
    baseline_hash=""
    if [ -n "$baseline" ]; then
        [ -f "$baseline" ] || {
            echo "vm-gui: screenshot-fresh baseline does not exist: $baseline" >&2
            return 2
        }
        baseline_hash=$(sha256sum "$baseline" | awk '{print $1}')
    fi
    for (( i=1; i<=attempts; i++ )); do
        candidate="${out}.attempt-${i}.png"
        virsh -c "${LIBVIRT_DEFAULT_URI:-qemu:///session}" screenshot \
            "$VM" "$candidate" >/dev/null || return $?
        reason=""
        if screenshot_is_black "$candidate"; then
            reason="near-black"
        else
            local black_rc=$?
            if [ "$black_rc" -ne 1 ]; then
                echo "vm-gui: cannot analyse screenshot brightness (requires ImageMagick magick)" >&2
                return "$black_rc"
            fi
            hash=$(sha256sum "$candidate" | awk '{print $1}')
            if [ -n "$baseline_hash" ] && [ "$hash" = "$baseline_hash" ]; then
                reason="unchanged-baseline"
            fi
        fi
        if [ -z "$reason" ]; then
            cp "$candidate" "$out"
            echo "$out"
            return 0
        fi
        echo "vm-gui: screenshot attempt $i/$attempts rejected: $reason ($candidate)" >&2
        [ "$i" -lt "$attempts" ] && sleep 1
    done
    echo "vm-gui: no fresh non-black screenshot after $attempts attempts; attempts retained beside $out" >&2
    return 1
}

case "$CMD" in
    screenshot)
        OUT="${1:-/tmp/vm-screenshot.png}"
        virsh -c "${LIBVIRT_DEFAULT_URI:-qemu:///session}" screenshot "$VM" "$OUT" >/dev/null
        echo "$OUT"
        ;;
    screenshot-fresh)
        OUT="${1:?Usage: vm-gui <vm> screenshot-fresh <file> [baseline] [attempts]}"
        screenshot_fresh "$OUT" "${2:-}" "${3:-3}"
        ;;
    start)
        APP="$*"
        "$VM_EXEC" "$VM" "su - admin -c 'DISPLAY=:0 $APP &'"
        sleep 2
        ;;
    activate)
        TITLE="$*"
        run_as_jan "wid=\$(xdotool search --onlyvisible --name \".*${TITLE}.*\" | head -n1); [ -n \"\$wid\" ] && xdotool windowactivate --sync \"\$wid\" windowraise \"\$wid\""
        sleep 0.5
        ;;
    click-preview)
        X="${1:?Usage: vm-gui <vm> click-preview <x> <y> [label]}"
        Y="${2:?Usage: vm-gui <vm> click-preview <x> <y> [label]}"
        shift 2
        click_preview "$X" "$Y" "$*"
        ;;
    click-confirm)
        MANIFEST="${1:?Usage: vm-gui <vm> click-confirm <preview-manifest>}"
        click_confirm "$MANIFEST"
        ;;
    click)
        X="${1:?Usage: vm-gui <vm> click <x> <y>}"
        Y="${2:?Usage: vm-gui <vm> click <x> <y>}"
        qmp_click "$X" "$Y" left
        sleep 0.3
        ;;
    rightclick)
        X="${1:?Usage: vm-gui <vm> rightclick <x> <y>}"
        Y="${2:?Usage: vm-gui <vm> rightclick <x> <y>}"
        qmp_click "$X" "$Y" right
        sleep 0.3
        ;;
    doubleclick)
        X="${1:?Usage: vm-gui <vm> doubleclick <x> <y>}"
        Y="${2:?Usage: vm-gui <vm> doubleclick <x> <y>}"
        qmp_click "$X" "$Y" left
        sleep 0.1
        qmp_click "$X" "$Y" left
        sleep 0.3
        ;;
    drag)
        X1="${1:?Usage: vm-gui <vm> drag <x1> <y1> <x2> <y2>}"
        Y1="${2:?}"
        X2="${3:?}"
        Y2="${4:?}"
        qmp_mouse_move "$X1" "$Y1"
        sleep 0.08
        qmp_mouse_button left down
        for i in 1 2 3 4 5 6 7 8; do
            qmp_mouse_move "$(( X1 + (X2 - X1) * i / 8 ))" \
                           "$(( Y1 + (Y2 - Y1) * i / 8 ))"
            sleep 0.03
        done
        qmp_mouse_button left up
        sleep 0.3
        ;;
    scroll)
        DIR="${1:?Usage: vm-gui <vm> scroll <up|down> [clicks]}"
        CLICKS="${2:-3}"
        case "$DIR" in
            up)   BUTTON=4 ;;
            down) BUTTON=5 ;;
            *) echo "scroll direction: up or down" >&2; exit 1 ;;
        esac
        run_as_jan "xdotool click --repeat $CLICKS --delay 50 $BUTTON"
        sleep 0.3
        ;;
    windowsize)
        TITLE="${1:?Usage: vm-gui <vm> windowsize <title> <w> <h>}"
        W="${2:?}"
        H="${3:?}"
        run_as_jan "xdotool search --name '.*${TITLE}.*' windowsize $W $H"
        sleep 0.3
        ;;
    windowmove)
        TITLE="${1:?Usage: vm-gui <vm> windowmove <title> <x> <y>}"
        X="${2:?}"
        Y="${3:?}"
        run_as_jan "xdotool search --name '.*${TITLE}.*' windowmove $X $Y"
        sleep 0.3
        ;;
    type)
        TEXT="$*"
        if have_ydotool; then
            run_input "ydotool type --key-delay=$DELAY $(shell_quote "$TEXT")"
        else
            # Send each character as a key event to handle spaces properly
            for (( i=0; i<${#TEXT}; i++ )); do
                char="${TEXT:$i:1}"
                case "$char" in
                    ' ') KEY="space" ;;
                    '.')  KEY="period" ;;
                    ',')  KEY="comma" ;;
                    '/')  KEY="slash" ;;
                    '-')  KEY="minus" ;;
                    '=')  KEY="equal" ;;
                    ';')  KEY="semicolon" ;;
                    "'")  KEY="apostrophe" ;;
                    '[')  KEY="bracketleft" ;;
                    ']')  KEY="bracketright" ;;
                    '!')  KEY="shift+1" ;;
                    '@')  KEY="shift+2" ;;
                    '#')  KEY="shift+3" ;;
                    '$')  KEY="shift+4" ;;
                    '%')  KEY="shift+5" ;;
                    '^')  KEY="shift+6" ;;
                    '&')  KEY="shift+7" ;;
                    '*')  KEY="shift+8" ;;
                    '(')  KEY="shift+9" ;;
                    ')')  KEY="shift+0" ;;
                    '_')  KEY="shift+minus" ;;
                    '+')  KEY="shift+equal" ;;
                    ':')  KEY="shift+semicolon" ;;
                    '"')  KEY="shift+apostrophe" ;;
                    '<')  KEY="shift+comma" ;;
                    '>')  KEY="shift+period" ;;
                    '?')  KEY="shift+slash" ;;
                    '~')  KEY="shift+grave" ;;
                    '`')  KEY="grave" ;;
                    *)
                        if [[ "$char" =~ [A-Z] ]]; then
                            KEY="shift+${char,,}"
                        else
                            KEY="$char"
                        fi
                        ;;
                esac
                run_as_jan "xdotool key $KEY" 2>/dev/null
                sleep "0.$(printf '%03d' $DELAY)"
            done
        fi
        ;;
    key)
        if have_ydotool; then
            KEY_EVENTS="$(ydotool_key_sequence "$@")" \
                || { echo "vm-gui: unsupported ydotool key name(s): $*" >&2; exit 2; }
            run_input "ydotool key --key-delay=$DELAY $KEY_EVENTS"
        else
            run_as_jan "xdotool key $*"
        fi
        sleep 0.3
        ;;
    wait)
        SECS="${1:-2}"
        sleep "$SECS"
        ;;
    *)
        echo "Unknown command: $CMD" >&2
        echo "Commands: screenshot, start, activate, click-preview, click-confirm, click, rightclick, doubleclick, drag, scroll, type, key, windowsize, windowmove, wait" >&2
        exit 1
        ;;
esac
