{
  "manifest_version": 3,
  "name": "qdistro browser bridge",
  "version": "0.2.0",
  "description": "qdistro native-messaging client: tabs, pwd, page-extract, cookies, mpris, downloads, notifications, screen-lock.",
  "minimum_chrome_version": "126",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "cookies",
    "downloads",
    "notifications",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "qdistro browser bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/pwd-content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/mpris-content.js",
        "src/content/screenlock-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
