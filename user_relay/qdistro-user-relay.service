[Unit]
Description=qdistro per-user session-bus relay
Documentation=file:///usr/share/doc/qdistro/user_relay/README.md
# Only meaningful once a session bus exists.
After=dbus.socket
Requires=dbus.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/libexec/qdistro/qdistro_user_relay.py
Restart=on-failure
RestartSec=2
# 78 (EX_CONFIG) means the system bus refused this identity's
# org.qdistro.UserRelay.uid<N> by static policy — see
# org.qdistro.UserRelay.conf. That is a fact about the config, not a
# transient fault, so restarting every 2s only churns the unit and
# floods the journal. Every OTHER failure still restarts.
RestartPreventExitStatus=78
# No private /tmp — we want to share the session bus socket under
# /run/user/<uid>/bus which needs the user's runtime dir layout
# intact.

[Install]
WantedBy=default.target
