#!/bin/bash
# qdistro-podapp-launch <launch-token> — ExecStart of
# qdistro-podapp@<launch-token>.service (tracker J12 Fix A).
#
# Why this exists at all: clicking a container app in the launcher used to fork
# spawn-tier2 DIRECTLY from qdshell, which runs as the unprivileged admin
# session. That caller has no root launcher parent, so spawn-tier2 took its
# un-tagged branch — the container's outer Wayland connection carried no
# wp_security_context_v1 at all, the compositor could not identify the window,
# and on a hardened profile spawn-tier2 refused the launch outright (exit 2),
# i.e. clicking a pod app did nothing at all on daily-driver/release.
#
# This is the podapp analogue of qdistro-tier2-silo-launch and works exactly
# the same way: the session manager (root) writes
# /run/qdistro/podapp-launch/<token>.env and `systemctl start`s the unit, which
# runs THIS script as ROOT. We do NOT drop privilege here — we hand spawn-tier2
# the root-launcher mode (TIER2_ROOT_LAUNCHER=1 + the resolved admin uid), so
# it keeps root only as the trusted launcher PARENT of qdistro-secctx-exec
# (which is what puts the silo/app tag on the wire) and drops EVERY podman op
# to the admin uid via `runuser`. podman never runs as root; the rootless
# --userns=keep-id + admin-owned-state model is preserved.
#
# The instance name is the 32-hex LAUNCH TOKEN, not the container name. Two
# reasons: a hex token needs no systemd escaping, and it is unique per click,
# so two launches never collide on one unit instance.
#
# FAIL CLOSED: if the admin uid cannot be resolved (missing user / uid 0 / not
# uid 1000) we exit nonzero rather than fall through to an un-tagged spawn — an
# app that cannot be secctx-tagged must NOT launch, exactly as the silo and
# disposable root-launcher paths refuse when they cannot stamp.
set -euo pipefail

TOKEN="${1:?usage: qdistro-podapp-launch <launch-token>}"
# The token is a systemd instance name that becomes a file path below, so
# validate its shape before touching the filesystem: anything but 32 lowercase
# hex digits is a caller bug (the daemon generates it) or an attempt to steer
# us at another file. Fail closed.
[[ "$TOKEN" =~ ^[0-9a-f]{32}$ ]] || {
    echo "podapp-launch: launch token must be 32 lowercase hex digits" >&2
    exit 2
}

# QDISTRO_PODAPP_LAUNCH_ENV_DIR is a TEST-ONLY override (host unit tests cannot
# write the real /run path unprivileged); production systemd/daemon never sets
# it, and the safe-source guard below applies REGARDLESS of the path, so an
# override cannot weaken the root-TCB protection.
ENV_DIR="${QDISTRO_PODAPP_LAUNCH_ENV_DIR:-/run/qdistro/podapp-launch}"
ENV_FILE="${ENV_DIR}/${TOKEN}.env"

[ -r "$ENV_FILE" ] || { echo "podapp-launch: no launch env at $ENV_FILE" >&2; exit 2; }

# SECURITY: we run as ROOT and are about to `.`-source this file — that is code
# execution AS THE SOURCING USER. So the file MUST be in our trusted computing
# base: a regular file owned BY US (the sourcing euid) and NOT writable by
# group or other. In production that means root-owned 0600 — admin (or anyone
# non-root) must not be able to plant or rewrite it, or they could run
# ARBITRARY root code via the source. The check is euid-relative so it is
# correct both in prod (euid 0 -> owner must be root) and under unprivileged
# host tests (euid test-user -> owner must be that user). Fail closed on any
# deviation. Kept byte-compatible with qdistro-tier2-silo-launch's guard.
require_trusted_env() {
    local f="$1" meta owner perms me
    me="$(id -u)"
    [ -f "$f" ] || { echo "podapp-launch: launch env $f is not a regular file" >&2; exit 2; }
    meta="$(stat -c '%u %a' "$f" 2>/dev/null)" \
        || { echo "podapp-launch: cannot stat launch env $f" >&2; exit 2; }
    owner="${meta%% *}"; perms="${meta##* }"
    [ "$owner" = "$me" ] || {
        echo "podapp-launch: launch env $f is owned by uid $owner, not the" \
             "sourcing uid $me — refusing to source untrusted content" >&2
        exit 2
    }
    # perms is 3 or 4 octal digits; the last digit is other-write, the middle
    # is group-write. Reject if either is set (writable by a non-owner).
    case "$perms" in
        *[2367]) echo "podapp-launch: launch env $f is other-writable (mode $perms)" \
                      "— refusing to source as root" >&2; exit 2 ;;
    esac
    case "$perms" in
        *[2367]?) echo "podapp-launch: launch env $f is group-writable (mode $perms)" \
                       "— refusing to source as root" >&2; exit 2 ;;
    esac
}
require_trusted_env "$ENV_FILE"

# The env file is shlex-quoted KEY='VALUE' written by the daemon (trusted, now
# ownership-verified above). `set -a` exports everything it defines so the
# Python argv splitter (a subprocess) sees QD_APP_ARGV_JSON.
unset QDISTRO_PROFILE
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

: "${QD_CONTAINER:?launch env missing QD_CONTAINER}"
: "${QD_WORKLOAD:?launch env missing QD_WORKLOAD}"
export TIER2_NETWORK="${TIER2_NETWORK:-none}"

# The env file also carries the token. It MUST agree with the instance name we
# were started as, or we would launch a container whose wire tag the caller is
# not watching for (the placeholder would time out) — and, worse, a mismatch
# means we are reading some other launch's stanza. Fail closed.
[ "${QD_LAUNCH_TOKEN:-}" = "$TOKEN" ] || {
    echo "podapp-launch: launch env token '${QD_LAUNCH_TOKEN:-}' does not match" \
         "the unit instance '$TOKEN' — refusing to launch" >&2
    exit 2
}

safe_source_profile() {
    local f="$1" meta owner perms
    [ -r "$f" ] || return 1
    [ -f "$f" ] || return 1
    meta="$(stat -c '%u %a' "$f" 2>/dev/null)" || return 1
    owner="${meta%% *}"; perms="${meta##* }"
    [ "$owner" = "0" ] || return 1
    case "$perms" in *[2367]|*[2367]?) return 1 ;; esac
    # shellcheck disable=SC1090
    . "$f"
}

if [ -z "${QDISTRO_PROFILE:-}" ]; then
    safe_source_profile /etc/qdistro/profile || true
fi
QDISTRO_PROFILE="${QDISTRO_PROFILE:-daily-driver}"
case "$QDISTRO_PROFILE" in
    dev|daily-driver|release) ;;
    prod|production) QDISTRO_PROFILE=release ;;
    daily|dd) QDISTRO_PROFILE=daily-driver ;;
    *)
        echo "podapp-launch: invalid QDISTRO_PROFILE=$QDISTRO_PROFILE" >&2
        exit 2
        ;;
esac

# Re-split the JSON argv the daemon exported (no quoting hazards: it was
# json.dumps'd). Empty/absent argv defaults to the workload binary name.
#
# NUL-separated, not newline-separated: `mapfile -t` on a newline-joined string
# silently drops empty elements (and a trailing empty one entirely), so an argv
# containing "" would reach the app as a DIFFERENT argv than the caller asked
# for. NUL is the one byte an exec'd argv element cannot contain (and the
# daemon's validator rejects it outright, including the \u0000 JSON escape), so
# the split is exact. The trailing separator keeps the last element from being
# merged.
#
# `wait "$!"` is load-bearing: mapfile reads a PROCESS SUBSTITUTION, not a
# pipeline, so neither `pipefail` nor mapfile's own status notices a failing
# splitter — a missing python3 or a decode error would silently yield an EMPTY
# argv and we would exec anyway. Waiting on the producer puts its status under
# `set -e`, so we fail closed instead.
mapfile -d '' -t APP_ARGV < <(python3 -c '
import json, os, sys
argv = json.loads(os.environ.get("QD_APP_ARGV_JSON", "[]") or "[]")
if not argv:
    argv = [os.environ["QD_WORKLOAD"]]
sys.stdout.write("".join(a + "\0" for a in argv))
')
wait "$!"

# Resolve spawn-tier2 (installed wrapper, else dev tree).
SPAWN=""
for cand in /usr/bin/qdistro-tier2-spawn \
            /usr/libexec/qdistro/spawn-tier2.sh \
            "$(dirname "$(readlink -f "$0")")/../tier2/spawn-tier2.sh"; do
    if [ -x "$cand" ]; then SPAWN="$cand"; break; fi
done
[ -n "$SPAWN" ] || { echo "podapp-launch: spawn-tier2 not found" >&2; exit 5; }

# Resolve the fixed admin uid spawn-tier2's root-launcher mode drops
# podman/resolver/broker to. Fail closed: a missing user or uid 0 means we
# cannot run rootless-as-admin, so we must NOT launch (no un-tagged fallback).
ADMIN_USER="admin"
ADMIN_UID="$(id -u "$ADMIN_USER" 2>/dev/null || true)"
[ -n "$ADMIN_UID" ] || {
    echo "podapp-launch: admin user '$ADMIN_USER' does not exist" \
         "— refusing to launch $QD_CONTAINER un-tagged" >&2
    exit 6
}
[ "$ADMIN_UID" != "0" ] || {
    echo "podapp-launch: admin user '$ADMIN_USER' resolves to uid 0 —" \
         "rootless podman needs a non-root uid; refusing to launch $QD_CONTAINER" >&2
    exit 6
}
[ "$ADMIN_UID" = "1000" ] || {
    echo "podapp-launch: admin user '$ADMIN_USER' resolves to uid $ADMIN_UID —" \
         "qdistro requires admin uid 1000; refusing to launch $QD_CONTAINER" >&2
    exit 6
}

# Hand spawn-tier2 the root-launcher topology. We are root (unit User=root), so
# spawn-tier2's TIER2_ROOT_LAUNCHER gate (which requires real root) is
# satisfied; it stays the trusted root parent of qdistro-secctx-exec and drops
# every podman/resolver/broker op to ADMIN_UID. If it cannot stamp the wire tag
# it fails closed itself (exit 2), so a tagged app or no app — never an
# un-tagged one.
#
# TIER2_LAUNCH_TOKEN pre-commits the token the daemon already returned to the
# clicking shell, so the shell's placeholder resolves on the secctx instance-id
# without anyone parsing our stdout (which is the journal here, not a pipe).
#
# Use env -i so an ambient service environment cannot weaken the sandbox
# posture with TIER2_ALLOW_PRIVESC, TIER2_KEEP_CAPS, a caller-selected seccomp
# profile, or other spawn-tier2 knobs. Re-add only the trusted launch stanza
# fields from the root-owned env file plus a deterministic PATH.
exec env -i \
    PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    QDISTRO_PROFILE="$QDISTRO_PROFILE" \
    TIER2_ROOT_LAUNCHER=1 \
    TIER2_ADMIN_UID="$ADMIN_UID" \
    TIER2_LAUNCH_TOKEN="$TOKEN" \
    TIER2_NETWORK="$TIER2_NETWORK" \
    "$SPAWN" "$QD_CONTAINER" "$QD_WORKLOAD" -- "${APP_ARGV[@]}"
