[Unit]
Description=qdistro tier-2 templated silo %i
# Referenced by qdistro_session_manager.TIER2_SILO_LAUNCHER_FMT
# (qdistro-tier2-silo@<name>.service). The session manager (root) writes
# /run/qdistro/silo-launch/<name>.env, then `systemctl start`s this unit;
# the unit drops to admin and runs spawn-tier2 (rootless podman). This is
# fableplan2 task 04's follow-up to the stubbed launcher wiring.
After=qdistro-session-manager.service
PartOf=qdistro-session-manager.service

[Service]
Type=simple
# Run as ROOT — but ONLY as the trusted launcher PARENT. spawn-tier2 is
# invoked with TIER2_ROOT_LAUNCHER=1 (by qdistro-tier2-silo-launch below), so
# it keeps root only as the direct ancestor of qdistro-secctx-exec — what
# qdwin's root-parent attestation requires to accept the secctx manager bind —
# and drops EVERY podman op (and the binding resolver + the broker gate) to the
# admin uid via `runuser`. The rootless --userns=keep-id + admin-owned-state
# model (task 01) is therefore PRESERVED: podman never runs as root. This is
# the production-grade replacement for the old User=admin path, which left the
# templated silo's secctx app_id UN-TAGGED on the wire (it had no direct root
# launcher parent) — tagged only under the QDWIN_SECCTX_OPEN=1 +
# QDISTRO_SECCTX_EXEC_ALLOW_UNTRUSTED=1 dev override the test VMs set.
#
# The launch env the daemon exported supplies TIER2_SILO (the binding to
# resolve — the only launch that mounts real state), TIER2_NETWORK, the
# workload, the container name, and the app argv.
#
# Proven end-to-end (NO dev override) by tier2-silo-secctx-wiretag.bats; the
# disposable analogue of this topology is disposable-secctx-wiretag.bats.
# WARNING: do NOT "simplify" this back to running podman as root — that breaks
# the rootless admin-owned state mount. The privilege boundary is: root parent,
# admin podman/resolver/broker.
User=root
ExecStart=/usr/libexec/qdistro/qdistro-tier2-silo-launch %i
# Stop the container EXPLICITLY, AS ADMIN. Rootless `podman run` in a non-tty
# context (this unit has no tty) does NOT proxy SIGTERM to the container —
# sig-proxy defaults off without a tty — and conmon keeps the container alive
# in the admin user manager scope, OUTSIDE this unit's cgroup. So a plain
# `systemctl stop` would SIGTERM only the foreground supervisor (which dies),
# orphan the container, and then time out on TimeoutStopSec. `podman stop`
# talks to conmon directly and tears the container down; the supervisor's
# `podman run` then returns and the unit exits cleanly.
#
# Because this unit now runs as root, ExecStop must DROP to admin to reach the
# admin-rootless container — a root `podman stop` would query root's empty
# store and never find qdistro-silo-<name>, orphaning it. The drop + the
# fixed admin uid resolution + fail-closed (no uid 0) live in the helper
# qdistro-tier2-silo-stop.
# Best-effort (`-`): an already-gone container must not fail the stop. The
# container is named qdistro-silo-<silo> and the instance %i IS the silo name.
ExecStop=-/usr/libexec/qdistro/qdistro-tier2-silo-stop %i
# A clean stop kills the container, so the supervising `podman run` returns
# 143 (SIGTERM) or 137 (SIGKILL after the -t grace); treat those as success so
# `systemctl stop` leaves the unit inactive, not failed (a failed unit would
# need reset-failed before the next launch and reads as a spurious error).
SuccessExitStatus=143 137
# No Restart: a crashed browser silo should not be silently relaunched onto a
# possibly-broken generation; the admin restarts it (which re-resolves the
# binding) explicitly.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
