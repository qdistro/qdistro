#!/bin/bash
# qdistro-tier2-silo-launch <silo-name> — ExecStart of
# qdistro-tier2-silo@<name>.service (fableplan2 task 04).
#
# The session manager (root) writes /run/qdistro/silo-launch/<name>.env and
# `systemctl start`s the unit; the unit runs THIS script as ROOT. We do NOT
# drop privilege here: instead we hand spawn-tier2 the root-launcher mode
# (TIER2_ROOT_LAUNCHER=1 + the resolved admin uid). spawn-tier2 keeps root only
# as the trusted launcher PARENT of qdistro-secctx-exec (so the silo's secctx
# app_id reaches qdwin on the wire) and drops EVERY podman op — plus the
# binding resolver and the broker gate — to the admin uid via `runuser`. The
# rootless --userns=keep-id + admin-owned-state model is therefore preserved;
# podman never runs as root. This is the production-grade replacement for the
# old User=admin launch, whose silo ran UN-TAGGED on the wire.
#
# The script reads the exported launch stanza and execs spawn-tier2 in the
# FOREGROUND as the unit's main process, and the per-container runtime dir is
# cleaned after the container exits (spawn-tier2's trap). No `podman run -d`.
# NB: a plain `systemctl stop` SIGTERM does NOT reliably stop the container —
# rootless `podman run` in a non-tty context has sig-proxy off, so conmon keeps
# the admin container alive outside this unit's cgroup. The unit's ExecStop
# (qdistro-tier2-silo-stop, which drops to admin) is what actually tears it
# down; see qdistro-tier2-silo@.service.
#
# FAIL CLOSED: if the admin uid cannot be resolved (missing user / uid 0) we
# exit nonzero rather than fall through to an un-tagged admin-direct spawn — a
# persistent silo that cannot be secctx-tagged must NOT launch (it would
# recreate the production wire-tag bug, ambiguous provenance), exactly as the
# disposable root-launcher mode refuses when it cannot stamp.
set -euo pipefail

NAME="${1:?usage: qdistro-tier2-silo-launch <silo-name>}"
ENV_FILE="/run/qdistro/silo-launch/${NAME}.env"

[ -r "$ENV_FILE" ] || { echo "tier2-silo-launch: no launch env at $ENV_FILE" >&2; exit 2; }
# The env file is single-quoted KEY='VALUE' written by the daemon (trusted).
# `set -a` exports everything it defines so the Python argv splitter (a
# subprocess) sees QD_WORKLOAD/QD_APP_ARGV_JSON, and spawn-tier2 sees
# TIER2_SILO/TIER2_NETWORK.
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

: "${TIER2_SILO:?launch env missing TIER2_SILO}"
: "${QD_WORKLOAD:?launch env missing QD_WORKLOAD}"
: "${QD_CONTAINER:?launch env missing QD_CONTAINER}"
export TIER2_NETWORK="${TIER2_NETWORK:-none}"

# Re-split the JSON argv the daemon exported (no quoting hazards: it was
# json.dumps'd). Empty/absent argv defaults to the workload binary name.
mapfile -t APP_ARGV < <(python3 -c '
import json, os, sys
argv = json.loads(os.environ.get("QD_APP_ARGV_JSON", "[]") or "[]")
if not argv:
    argv = [os.environ["QD_WORKLOAD"]]
sys.stdout.write("\n".join(argv))
')

# Resolve spawn-tier2 (installed wrapper, else dev tree).
SPAWN=""
for cand in /usr/bin/qdistro-tier2-spawn \
            /usr/libexec/qdistro/spawn-tier2.sh \
            "$(dirname "$(readlink -f "$0")")/../tier2/spawn-tier2.sh"; do
    if [ -x "$cand" ]; then SPAWN="$cand"; break; fi
done
[ -n "$SPAWN" ] || { echo "tier2-silo-launch: spawn-tier2 not found" >&2; exit 5; }

# Resolve the admin uid spawn-tier2's root-launcher mode drops podman/resolver/
# broker to. QDISTRO_ADMIN_USER (default admin), matching the daemon + the
# install scripts. Fail closed: a missing user or uid 0 means we cannot run
# rootless-as-admin, so we must NOT launch (no un-tagged fallback).
ADMIN_USER="${QDISTRO_ADMIN_USER:-admin}"
ADMIN_UID="$(id -u "$ADMIN_USER" 2>/dev/null || true)"
[ -n "$ADMIN_UID" ] || {
    echo "tier2-silo-launch: admin user '$ADMIN_USER' does not exist" \
         "(set QDISTRO_ADMIN_USER) — refusing to launch silo $NAME un-tagged" >&2
    exit 6
}
[ "$ADMIN_UID" != "0" ] || {
    echo "tier2-silo-launch: admin user '$ADMIN_USER' resolves to uid 0 —" \
         "rootless podman needs a non-root uid; refusing to launch silo $NAME" >&2
    exit 6
}

# Hand spawn-tier2 the root-launcher topology. We are root (unit User=root), so
# spawn-tier2's TIER2_ROOT_LAUNCHER gate (which requires real root) is
# satisfied; it stays the trusted root parent of qdistro-secctx-exec and drops
# every podman/resolver/broker op to ADMIN_UID. If it cannot stamp the wire tag
# it fails closed itself (exit 2), so a tagged silo or no silo — never an
# un-tagged one.
exec env \
    TIER2_ROOT_LAUNCHER=1 \
    TIER2_ADMIN_UID="$ADMIN_UID" \
    "$SPAWN" "$QD_CONTAINER" "$QD_WORKLOAD" -- "${APP_ARGV[@]}"
