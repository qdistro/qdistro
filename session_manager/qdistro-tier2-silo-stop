#!/bin/bash
# qdistro-tier2-silo-stop <silo-name> — ExecStop of
# qdistro-tier2-silo@<name>.service.
#
# The unit now runs as ROOT (so spawn-tier2's root-launcher mode can stamp the
# secctx wire tag — see qdistro-tier2-silo@.service). The container itself runs
# in the ADMIN user's rootless podman, so a root `podman stop` would query
# root's empty store and never find qdistro-silo-<name>, orphaning it. This
# helper resolves the fixed admin user, fails closed on a missing user or uid 0,
# and drops to that uid with the right
# XDG_RUNTIME_DIR so `podman stop` reaches the admin-rootless conmon.
#
# The per-silo launch env file is sourced only for silo/container metadata.
# A missing env file at stop time (it may legitimately race a reboot/cleanup)
# falls back to the fixed `admin` account, because ExecStop is already
# best-effort (`-`) and the daemon performs the authoritative post-stop
# `tier2_silo_running` verification. But a PRESENT env file must be safe to
# source as root (root-owned, non-group/other-writable) — a tampered file is a
# hard fail, never silently sourced.
#
# The unit invokes us with `-` (best-effort): an already-gone container or a
# transient error must not fail `systemctl stop` (the daemon re-verifies the
# container is actually gone via tier2_silo_running and fails closed itself if
# it survives). We still exit nonzero on a hard error so the journal records it.
set -u

NAME="${1:?usage: qdistro-tier2-silo-stop <silo-name>}"
# QDISTRO_SILO_LAUNCH_ENV_DIR is a TEST-ONLY override (see the launch helper);
# production never sets it and the safe-source guard applies regardless of path.
ENV_DIR="${QDISTRO_SILO_LAUNCH_ENV_DIR:-/run/qdistro/silo-launch}"
ENV_FILE="${ENV_DIR}/${NAME}.env"

# Best-effort source of the daemon-written launch env.
# SECURITY: we run as ROOT, so `.`-sourcing is root code execution — only source
# a file that is a regular file owned BY US (the sourcing euid, root in prod) and
# NOT group/other-writable. The check is euid-relative so it is correct in prod
# (owner must be root) and under unprivileged host tests (owner must be the test
# user); the admin-plants / root-sources attack is blocked because admin's uid !=
# root's euid 0. A MISSING file is fine (fall through to the env/default — stop
# is best-effort and the daemon re-verifies); a PRESENT-but-unsafe file is a HARD
# fail (someone planted/rewrote it — refuse rather than run it).
if [ -e "$ENV_FILE" ]; then
    _me="$(id -u)"
    if [ ! -f "$ENV_FILE" ]; then
        echo "tier2-silo-stop: launch env $ENV_FILE is not a regular file —" \
             "refusing to source as root" >&2
        exit 4
    fi
    _meta="$(stat -c '%u %a' "$ENV_FILE" 2>/dev/null)" \
        || { echo "tier2-silo-stop: cannot stat launch env $ENV_FILE" >&2; exit 4; }
    _owner="${_meta%% *}"; _perms="${_meta##* }"
    if [ "$_owner" != "$_me" ]; then
        echo "tier2-silo-stop: launch env $ENV_FILE owned by uid $_owner, not" \
             "the sourcing uid $_me — refusing to source untrusted content" >&2
        exit 4
    fi
    case "$_perms" in
        *[2367])  echo "tier2-silo-stop: launch env $ENV_FILE is other-writable" \
                       "(mode $_perms) — refusing to source as root" >&2; exit 4 ;;
    esac
    case "$_perms" in
        *[2367]?) echo "tier2-silo-stop: launch env $ENV_FILE is group-writable" \
                       "(mode $_perms) — refusing to source as root" >&2; exit 4 ;;
    esac
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
fi

ADMIN_USER="admin"
ADMIN_UID="$(id -u "$ADMIN_USER" 2>/dev/null || true)"
if [ -z "$ADMIN_UID" ]; then
    echo "tier2-silo-stop: admin user '$ADMIN_USER' does not exist" \
         "— cannot stop qdistro-silo-$NAME" >&2
    exit 3
fi
if [ "$ADMIN_UID" = "0" ]; then
    # Refuse to "stop" via root's store — that would silently no-op while the
    # admin-rootless container lives on. Fail closed.
    echo "tier2-silo-stop: resolved admin uid 0 for '$ADMIN_USER' — refusing" \
         "(rootless podman must run as a non-root uid)" >&2
    exit 3
fi
if [ "$ADMIN_UID" != "1000" ]; then
    echo "tier2-silo-stop: admin user '$ADMIN_USER' resolves to uid $ADMIN_UID —" \
         "qdistro requires admin uid 1000; cannot stop qdistro-silo-$NAME" >&2
    exit 3
fi

PODMAN="$(command -v podman || echo /usr/bin/podman)"

# Drop to admin with the admin runtime dir so podman talks to the admin's
# rootless conmon. -t 10 mirrors the prior ExecStop grace.
exec runuser -u "$ADMIN_USER" -- env \
    XDG_RUNTIME_DIR="/run/user/${ADMIN_UID}" \
    "$PODMAN" stop -t 10 "qdistro-silo-${NAME}"
