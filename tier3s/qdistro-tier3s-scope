#!/bin/bash
# qdistro-tier3s-scope — root-owned helper (installed as
# /usr/libexec/qdistro/qdistro-tier3s-scope). It is the FIRST process of a
# tier-3s launch's transient scope (tier3s/CONTRACT.md "D-A3b"):
#
#   systemd-run --scope --unit=qdistro-tier3s-<token>.scope -p Delegate=yes ... \
#     -- qdistro-tier3s-scope enter <token> <silo-uid> -- podman <args...>
#
# It (1) verifies it runs as root as the only process of exactly the cgroup of
# qdistro-tier3s-<token>.scope; (2) delegates that cgroup to the SILO uid
# SELECTIVELY: the directory, cgroup.procs, cgroup.subtree_control and
# cgroup.threads (what systemd's own Delegate= hands a unit's User=), while
# every limit and accounting file (memory.max, pids.max, ...) stays root's;
# (3) execs podman AS THE SILO through runuser with a fixed environment. The
# silo uid is the podman/runsc caller (Phase C2 model A: keep-id maps it to
# the same numeric guest uid); admin's uid is never accepted here — that
# would silently re-open the C1 shared-identity model. A silo-writable scope
# is what keeps rootless podman (cgroupfs manager), conmon and every runsc
# process inside it (Phase S logs 35/36). It never runs anything as root and
# accepts no other mode or program.
#
# Test hook ONLY: TIER3S_TEST_ROOT reads our cgroup from $TIER3S_TEST_ROOT/proc/<pid>/cgroup,
# prefixes /sys/fs/cgroup and keeps the caller's PATH (fakes); refused for root.
set -euo pipefail
if [ "$EUID" -eq 0 ] || [ -z "${TIER3S_TEST_ROOT:-}" ]; then PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH; fi
die() { printf 'qdistro-tier3s-scope: FAIL: %s\n' "$*" >&2; exit 2; }
T="${TIER3S_TEST_ROOT:-}"
if [ -n "$T" ]; then
    [ "$EUID" -ne 0 ] || die "TIER3S_TEST_ROOT is a unit-test hook and is refused for root"
    case "$T" in /?*) ;; *) die "TIER3S_TEST_ROOT must be absolute" ;; esac
    SELF_CGROUP="$T/proc/$$/cgroup"; SELF_PID=$$
else
    [ "$EUID" -eq 0 ] || die "must run as root (first process of the launch scope)"
    SELF_CGROUP=/proc/self/cgroup; SELF_PID=$$
fi
CGROOT="$T/sys/fs/cgroup"

[ "$#" -ge 5 ] && [ "$1" = enter ] && [ "$4" = -- ] && [ "$5" = podman ] \
    || die "usage: qdistro-tier3s-scope enter <token> <silo-uid> -- podman <args...>"
TOKEN="$2"; SILO_UID="$3"; shift 5
[[ "$TOKEN" =~ ^[0-9a-f]{32}$ ]] || die "token must be 32 lowercase hex digits"
[[ "$SILO_UID" =~ ^[0-9]+$ ]] && [ "$SILO_UID" -ge 1000 ] || die "silo uid must be a non-root numeric uid >= 1000"
# NSS is resolved once, under a bound (fable A r3 P3-2): a wedged lookup dies
# the launch rather than wedging the scope's first process. Its status counts
# (sol r5 P3-4): a line printed before the stall is not a result.
SILO_PW="$(timeout 5 getent passwd "$SILO_UID")" \
    || die "no passwd entry for uid $SILO_UID (the NSS lookup failed or timed out)"
SILO_USER="$(printf '%s\n' "$SILO_PW" | cut -d: -f1)"
SILO_PUID="$(printf '%s\n' "$SILO_PW" | cut -d: -f3)"
SILO_HOME="$(printf '%s\n' "$SILO_PW" | cut -d: -f6)"
[ -n "$SILO_USER" ] && [ "$SILO_PUID" = "$SILO_UID" ] && [[ "$SILO_HOME" == /* ]] \
    && [[ "$SILO_PW" != *$'\n'* ]] || die "no passwd entry for uid $SILO_UID"
if [ -z "$T" ]; then
    # the podman caller is a dedicated qt3s-* account (spawn-tier3s.sh §3b);
    # admin — or any other account — is refused here even though the record's
    # silo_uid is the launch's own choice.
    case "$SILO_USER" in qt3s-*) ;; *) die "uid $SILO_UID resolves to '$SILO_USER', not a qt3s-* silo account" ;; esac
fi

# (1) exactly our scope, and we are its only process
mapfile -t lines < "$SELF_CGROUP"
[ "${#lines[@]}" -eq 1 ] && [[ "${lines[0]}" == 0::/* ]] || die "not on a pure cgroup v2 hierarchy: ${lines[*]}"
REL="${lines[0]#0::}"
UNIT="qdistro-tier3s-$TOKEN.scope"
[ "${REL##*/}" = "$UNIT" ] || die "running in cgroup $REL, not in $UNIT"
case "$REL" in */../*|*/./*|*//*) die "odd cgroup path $REL" ;; esac
DIR="$CGROOT$REL"
[ -d "$DIR" ] && [ ! -L "$DIR" ] || die "scope cgroup $DIR is not a directory"
[ "$(stat -c %u -- "$DIR")" = "$(id -u)" ] || die "scope cgroup $DIR is not owned by the caller"
# mapfile, not $(...): a command substitution forks a process into the scope
mapfile -t procs < "$DIR/cgroup.procs"
[ "${procs[*]}" = "$SELF_PID" ] || die "scope $UNIT already holds processes [${procs[*]}], want only $SELF_PID"
[ -z "$(find "$DIR" -mindepth 1 -type d -print -quit)" ] || die "scope $UNIT already has child cgroups"

# (2) selective delegation: these four and nothing else
for f in "$DIR/cgroup.procs" "$DIR/cgroup.subtree_control" "$DIR/cgroup.threads"; do
    [ -f "$f" ] && [ ! -L "$f" ] || die "$f missing"
done
chown "$SILO_UID" -- "$DIR" "$DIR/cgroup.procs" "$DIR/cgroup.subtree_control" "$DIR/cgroup.threads"
printf 'qdistro-tier3s-scope: %s delegated to uid %s (dir, cgroup.procs, cgroup.subtree_control, cgroup.threads)\n' "$REL" "$SILO_UID" >&2

# (3) podman as the silo, fixed environment (runuser stays as the PAM parent,
# inside the scope). The silo has no logind session: /run/user/<uid> does not
# exist, so XDG_RUNTIME_DIR is the per-silo runtime dir the spawn created
# (silo-owned 0700 under the root-0755 base).
if [ -n "$T" ]; then PODMAN="$(command -v podman)"; else PODMAN=/usr/bin/podman; fi
exec runuser -u "$SILO_USER" -- /usr/bin/env -i PATH=/usr/bin:/bin HOME="$SILO_HOME" \
    USER="$SILO_USER" LOGNAME="$SILO_USER" XDG_RUNTIME_DIR="$T/run/qdistro-tier3s-rt/$SILO_UID" \
    "$PODMAN" "$@"
