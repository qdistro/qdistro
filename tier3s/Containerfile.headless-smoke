# tier 3s headless smoke workload (tier3s/CONTRACT.md §7). Built by
# tier3s/make-tier3s-image.sh as qdistro/tier3s-headless-smoke:latest and run
# under runsc by spawn-tier3s.sh: read-only root, silo keep-id (guest uid == the silo's host
# uid, Phase C2 model A), no network.
#
# The base follows the snapshot.conf pin (make-tier3s-image.sh passes it), so
# the base layer and the zypper repos come from one snapshot. No default: a
# build without the pin fails instead of pulling the rolling :latest.
ARG SNAPSHOT
FROM registry.opensuse.org/opensuse/tumbleweed:${SNAPSHOT}
ARG SNAPSHOT
LABEL org.qdistro.tier3s.workload="headless-smoke" \
      org.qdistro.snapshot="${SNAPSHOT}"

# Replace the rolling repositories inherited from the base before zypper reads
# metadata (tier3s-local copy of the tier-2 helper; GPG checks stay on).
COPY SNAPSHOT configure-snapshot-repos.sh /usr/lib/qdistro/tier3s/
RUN /bin/sh /usr/lib/qdistro/tier3s/configure-snapshot-repos.sh /usr/lib/qdistro/tier3s/SNAPSHOT
RUN zypper --non-interactive --gpg-auto-import-keys refresh \
 && zypper --non-interactive dup --no-recommends

# coreutils/util-linux (dmesg)/procps/iproute2 for the smoke checks;
# glibc-locale-base for a UTF-8 locale (Phase S W8: its absence broke foot).
RUN zypper --non-interactive install --no-recommends \
        bash coreutils util-linux procps iproute2 findutils grep sed \
        glibc-locale-base \
 && zypper clean --all \
 && rm -rf /var/cache/zypp/* /var/log/*.log

# uid 1000 = admin on the host; --userns=keep-id maps it 1:1. The passwd
# entry and HOME are part of the image (asserted by the A-iii driver), not
# something podman has to synthesize. .cache exists as the tmpfs mountpoint
# under the read-only root.
RUN grep -q '^admin:' /etc/group  || echo 'admin:x:1000:' >> /etc/group \
 && grep -q '^admin:' /etc/passwd || echo 'admin:x:1000:1000:qdistro admin:/home/admin:/bin/bash' >> /etc/passwd \
 && install -d -o 1000 -g 1000 -m 0700 /home/admin /home/admin/.cache \
 && install -d -m 0755 /etc/qdistro \
 && printf 'SNAPSHOT=%s\nWORKLOAD=headless-smoke\n' "${SNAPSHOT}" > /etc/qdistro/tier3s-image

COPY headless-smoke.sh /usr/local/bin/qdistro-tier3s-smoke
RUN chmod 0755 /usr/local/bin/qdistro-tier3s-smoke

ENV LANG=C.UTF-8 HOME=/home/admin
USER 1000:1000
WORKDIR /home/admin
CMD ["/usr/local/bin/qdistro-tier3s-smoke"]
