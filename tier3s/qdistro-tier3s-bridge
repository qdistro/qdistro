#!/usr/bin/env python3
"""qdistro-tier3s-bridge — per-launch A1 export-channel endpoint
(paravirt-gpu doc 11).

Forked by qdistro-tier3s-bootstrap as the admin uid with two inherited
fds by descriptor number:

  QSHM_LISTENER_FD   the SOCK_SEQPACKET donation listener the bootstrap
                     bound at /run/qdistro-tier3s/qshm-donate-<token>.sock
  QSHM_CTL_FD        a socketpair back to the bootstrap (peer report,
                     AUTH/ACK)
  QSHM_SCOPE_PREFIX  the launch scope's anchored cgroup path

Flow:

  1. accept() — bounded deadline; the Sentry connects during
     `podman init`, before any guest code runs.
  2. Peer checks: SO_PEERCRED pid must be live and its cgroup must equal
     or sit under the anchored scope prefix (a same-named nested cgroup
     under an attacker scope is refused — full-path prefix, never
     basename).
  3. Report "PEER <pid>" on the control channel, then hold the channel
     QUIESCENT: packets and fds sit in the kernel queue, never parsed,
     until the bootstrap's committed "AUTH" arrives.
  4. On AUTH: "ACK" and enter the record loop. On anything else: exit.
  5. Record loop: 40-byte records (magic, token, size, flags, reserved)
     with exactly one SCM_RIGHTS fd each. Every record is validated
     BEFORE the fd is used: magic, size bounds, reserved==0, only
     defined flag bits, descriptor kind via /proc/self/fd (memfd only),
     F_SEAL_SHRINK present. qdwin forwarding is design item 6; until
     then imported memfds are validated, accounted and released.
  6. Channel EOF (Sentry death), control EOF (bootstrap death) or a
     signal ends the bridge. The bootstrap supervises the process, so
     dying here cancels the launch.

Fail closed: every malformed input kills the bridge; the launch never
starts unless the bootstrap's authorization already committed.
"""
import array
import fcntl
import os
import signal
import socket
import struct
import sys

MAGIC = 0x315058454D485351
REC_SIZE = 40
MAX_REC_SIZE = 512 << 20
MAX_RECORDS = 64
F_SEAL_SHRINK = 0x0002
F_GET_SEALS = 1034

ACCEPT_DEADLINE = float(os.environ.get("QSHM_ACCEPT_DEADLINE", "120"))
AUTH_DEADLINE = 120    # the bootstrap must decide within this window
PROC = os.environ.get("TIER3S_TEST_ROOT", "") + "/proc"


def die(msg):
    print(f"qdistro-tier3s-bridge: FAIL: {msg}", file=sys.stderr)
    sys.exit(1)


def say(msg):
    print(f"qdistro-tier3s-bridge: {msg}", file=sys.stderr)


lfd = int(os.environ.get("QSHM_LISTENER_FD", "-1"))
cfd = int(os.environ.get("QSHM_CTL_FD", "-1"))
SCOPE_PREFIX = os.environ.get("QSHM_SCOPE_PREFIX", "")
if lfd < 0 or cfd < 0 or not SCOPE_PREFIX.startswith("/"):
    die("QSHM_LISTENER_FD, QSHM_CTL_FD and QSHM_SCOPE_PREFIX are required")

listener = socket.socket(fileno=lfd)
ctl = socket.socket(fileno=cfd)
if listener.family != socket.AF_UNIX or ctl.family != socket.AF_UNIX:
    die("donated fds are not AF_UNIX sockets")

# (1) bounded accept
listener.settimeout(ACCEPT_DEADLINE)
try:
    conn, _ = listener.accept()
except socket.timeout:
    die(f"no sentry connect within {ACCEPT_DEADLINE}s")
except OSError as e:
    die(f"accept: {e}")
listener.close()

# (2) peer checks — pidfd-pinned at accept (SO_PEERPIDFD, Linux ≥5.10):
# a dead or recycled peer is detected via the pidfd, never re-trusted.
ucred = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                        struct.calcsize("3i"))
peer_pid, peer_uid, peer_gid = struct.unpack("3i", ucred)
if peer_pid <= 0:
    die(f"peer pid {peer_pid} unusable")
SO_PEERPIDFD = 77
peer_pidfd = -1
try:
    peer_pidfd = struct.unpack(
        "i", conn.getsockopt(socket.SOL_SOCKET, SO_PEERPIDFD,
                             struct.calcsize("i")))[0]
except OSError:
    pass  # older kernel: fall back to the pid+liveness checks below
try:
    with open(f"{PROC}/{peer_pid}/cgroup") as f:
        rel = next((l.strip()[3:] for l in f
                    if l.strip().startswith("0::/")), None)
except OSError as e:
    die(f"cannot read peer cgroup /proc/{peer_pid}/cgroup: {e}")
if rel is None or not (rel == SCOPE_PREFIX
                       or rel.startswith(SCOPE_PREFIX + "/")):
    die(f"peer cgroup {rel} is not under launch scope {SCOPE_PREFIX}")
if peer_pidfd >= 0:
    # Liveness through the pidfd, not the recycled-pid-prone /proc name.
    try:
        signal.pidfd_send_signal(peer_pidfd, 0)
    except ProcessLookupError:
        die("peer died between accept and verification")
say(f"accepted peer pid={peer_pid} uid={peer_uid} pidfd={peer_pidfd} scope-ok")

# (3) report, then quiescent wait for the committed authorization
try:
    ctl.sendall(f"PEER {peer_pid}".encode())
except OSError as e:
    die(f"peer report: {e}")
ctl.settimeout(AUTH_DEADLINE)
try:
    auth = ctl.recv(16)
except socket.timeout:
    die(f"no authorization within {AUTH_DEADLINE}s")
except OSError as e:
    die(f"control read: {e}")
if auth != b"AUTH":
    die(f"authorization refused ({auth!r})")
try:
    ctl.sendall(b"ACK")
except OSError as e:
    die(f"ack: {e}")
say("authorization committed; channel live")

# (4) record loop — every field is validated before the fd is used.
records = 0
live_fds = []
conn.settimeout(None)
try:
    while True:
        try:
            msg, anc, mflags, _ = conn.recvmsg(4096, socket.CMSG_LEN(4 * 4))
        except OSError as e:
            die(f"recvmsg: {e}")
        fds = []
        for level, ctype, cdata in anc:
            if level == socket.SOL_SOCKET and ctype == socket.SCM_RIGHTS:
                fds.extend(array.array(
                    "i", cdata[:len(cdata) - len(cdata) % 4]))
        if len(msg) == 0 and not fds:
            break  # channel EOF: the Sentry closed its end (sandbox death)
        bad = None
        if mflags & socket.MSG_TRUNC or mflags & socket.MSG_CTRUNC:
            bad = "truncated packet"
        elif len(msg) != REC_SIZE or len(fds) != 1:
            bad = f"malformed record len={len(msg)} nfds={len(fds)}"
        if bad is not None:
            for x in fds:
                os.close(x)
            die(bad)
        magic, token, size, flags, reserved = struct.unpack("<QQQQQ", msg)
        if (magic != MAGIC or reserved != 0 or flags & ~1
                or size == 0 or size > MAX_REC_SIZE):
            os.close(fds[0])
            die(f"bad record header magic={magic:#x} res={reserved:#x} "
                f"flags={flags:#x} size={size}")
        # Structural kind check before any use: memfd only.
        try:
            st = os.fstat(fds[0])
            link = os.readlink(f"/proc/self/fd/{fds[0]}")
        except OSError as e:
            os.close(fds[0])
            die(f"received fd: {e}")
        if not (link.startswith("/memfd:") or link.startswith("memfd:")):
            os.close(fds[0])
            die(f"received fd is not a memfd: {link}")
        if st.st_size < size:
            os.close(fds[0])
            die(f"fd size {st.st_size} < record size {size}")
        seals = fcntl.fcntl(fds[0], F_GET_SEALS)
        if not (seals & F_SEAL_SHRINK):
            os.close(fds[0])
            die(f"import without F_SEAL_SHRINK (seals={seals:#x})")
        records += 1
        if records > MAX_RECORDS:
            os.close(fds[0])
            die(f"record cap {MAX_RECORDS} exceeded")
        live_fds.append((token, size, fds[0]))
        say(f"record {records}: token={token} size={size} flags={flags}")
except Exception as e:
    if not isinstance(e, SystemExit):
        die(f"record loop: {e}")
    raise

say(f"channel EOF after {records} records")
for _, _, fd in live_fds:
    try:
        os.close(fd)
    except OSError:
        pass
sys.exit(0)
