#!/usr/bin/env python3
"""qdistro-tier3s-bootstrap — root supervisor of a GFX tier-3s launch
(paravirt-gpu doc 11). It is the FIRST process of the launch's transient
scope, taking qdistro-tier3s-scope's place for launches that carry the
qdistro.tier3s.token annotation:

  systemd-run --scope --unit=qdistro-tier3s-<token>.scope -p Delegate=yes \
    -- qdistro-tier3s-bootstrap enter <token> <admin-uid> <container> -- \
       podman <create args...>

  1. Verifies it is root, the only process of exactly
     qdistro-tier3s-<token>.scope, and captures the scope's full cgroup
     path REL (the anchored prefix every later peer check compares
     against — never parsed from peer text).
  2. Delegates the scope cgroup to the admin uid SELECTIVELY (dir,
     cgroup.procs, cgroup.subtree_control, cgroup.threads), same set as
     qdistro-tier3s-scope.
  3. Creates the SOCK_SEQPACKET donation listener
     /run/qdistro-tier3s/qshm-donate-<token>.sock in the root-0755
     parent (never inside the admin-writable per-launch dir).
  4. Forks the bridge as the admin uid with the listener fd and a
     control socketpair donated by descriptor number — through
     root-owned executables only (runuser), never admin-selected ones.
  5. Runs the split launch: podman create (config only) -> podman init
     (runsc create; the Sentry boots and connects out) -> verify the
     accepted peer IS this create's Sentry (bridge-reported peer pid
     must equal `runsc state`'s sandbox pid for the exact container id
     create returned, pinned by peer liveness + anchored cgroup
     prefix) -> committed AUTH on the control channel -> bridge ACK ->
     podman start.
  6. Supervises: podman exit, bridge exit or channel EOF cancels the
     launch; teardown closes every endpoint, revokes nothing an admin
     could plant, unlinks only the socket we bound, and `podman rm -f`s
     a Created-but-never-started container.

Fail closed: every refusal exits 2 before podman start. An
annotation-stripped or misdirected launch never reaches start — this
process is the gfx-expected authority.

Test hook ONLY: TIER3S_TEST_ROOT prefixes /run, /proc and
/sys/fs/cgroup and keeps PATH; refused for root.
"""
import os
import re
import socket
import subprocess
import sys
import time

USAGE = ("usage: qdistro-tier3s-bootstrap enter <token> <admin-uid> "
         "<container> -- podman <create args...>")

T = os.environ.get("TIER3S_TEST_ROOT", "")
PROC = T + "/proc"
CGROOT = T + "/sys/fs/cgroup"
DONATE_DIR = T + "/run/qdistro-tier3s"
RUNSC_ROOT_BASE = T + "/run/qdistro-tier3s-runsc"
RUNUSER = "/usr/sbin/runuser"  # absolute: children get PATH=/usr/bin:/bin
PYTHON = "/usr/bin/python3"
if T:
    RUNUSER, PYTHON = "runuser", "python3"  # test-root fakes via PATH


def die(msg):
    print(f"qdistro-tier3s-bootstrap: FAIL: {msg}", file=sys.stderr)
    sys.exit(2)


def say(msg):
    print(f"qdistro-tier3s-bootstrap: {msg}", file=sys.stderr)


if T:
    if os.geteuid() == 0:
        die("TIER3S_TEST_ROOT is a unit-test hook and is refused for root")
    if not T.startswith("/"):
        die("TIER3S_TEST_ROOT must be absolute")
    SELF_CGROUP = f"{PROC}/{os.getpid()}/cgroup"
else:
    if os.geteuid() != 0:
        die("must run as root (first process of the launch scope)")
    SELF_CGROUP = "/proc/self/cgroup"
RUNSC = T + "/usr/libexec/qdistro/runsc/runsc"
BRIDGE = T + "/usr/libexec/qdistro/qdistro-tier3s-bridge"

argv = sys.argv[1:]
if len(argv) < 5 or argv[0] != "enter" or "--" not in argv:
    die(USAGE)
dash = argv.index("--")
TOKEN, ADMIN_UID_S, CONTAINER = argv[1], argv[2], argv[3]
PODMAN_ARGV = argv[dash + 1:]
if not PODMAN_ARGV or PODMAN_ARGV[0] != "podman":
    die(USAGE)
PODMAN_ARGV = PODMAN_ARGV[1:]
if not re.fullmatch(r"[0-9a-f]{32}", TOKEN):
    die("token must be 32 lowercase hex digits")
if not re.fullmatch(r"[1-9][0-9]*", ADMIN_UID_S):
    die("admin uid must be a non-root numeric uid")
ADMIN_UID = int(ADMIN_UID_S)
if not T and ADMIN_UID != 1000:
    die(f"qdistro's admin uid is 1000, got {ADMIN_UID}")
if not re.fullmatch(r"[A-Za-z0-9_.-]+", CONTAINER):
    die("invalid container name")

# NSS is resolved once, under a bound (same as the scope helper): a wedged
# lookup dies the launch rather than wedging the scope's first process.
TIMEOUT = "timeout" if T else "/usr/bin/timeout"
GETENT = "getent" if T else "/usr/bin/getent"
CHOWN = "chown" if T else "/usr/bin/chown"
try:
    ge = subprocess.run([TIMEOUT, "5", GETENT, "passwd", str(ADMIN_UID)],
                        capture_output=True, text=True, timeout=8)
except subprocess.TimeoutExpired:
    die(f"NSS lookup for uid {ADMIN_UID} wedged past the bound")
pwline = ge.stdout.strip()
fields = pwline.split(":")
if (ge.returncode != 0 or len(fields) < 7 or fields[2] != str(ADMIN_UID)
        or not fields[5].startswith("/") or "\n" in pwline):
    die(f"no passwd entry for uid {ADMIN_UID} (the NSS lookup failed or timed out)")
ADMIN_USER, ADMIN_HOME = fields[0], fields[5]

# (1) exactly our scope, and we are its only process
with open(SELF_CGROUP) as f:
    lines = [l.strip() for l in f if l.strip()]
if len(lines) != 1 or not lines[0].startswith("0::/"):
    die(f"not on a pure cgroup v2 hierarchy: {lines}")
REL = lines[0][3:]
UNIT = f"qdistro-tier3s-{TOKEN}.scope"
if os.path.basename(REL) != UNIT:
    die(f"running in cgroup {REL}, not in {UNIT}")
if ".." in REL.split("/") or "//" in REL:
    die(f"odd cgroup path {REL}")
CGDIR = CGROOT + REL
if not os.path.isdir(CGDIR) or os.path.islink(CGDIR):
    die(f"scope cgroup {CGDIR} is not a directory")
if os.stat(CGDIR).st_uid != os.getuid():
    die(f"scope cgroup {CGDIR} is not owned by the caller")
with open(f"{CGDIR}/cgroup.procs") as f:
    procs = f.read().split()
if procs != [str(os.getpid())]:
    die(f"scope {UNIT} already holds processes {procs}, want only {os.getpid()}")
if any(os.path.isdir(os.path.join(CGDIR, d)) for d in os.listdir(CGDIR)):
    die(f"scope {UNIT} already has child cgroups")

# (2) selective delegation: the same four as the scope helper, one chown
# call in the same argv shape (dir, then the three delegated files).
for fn in ("cgroup.procs", "cgroup.subtree_control", "cgroup.threads"):
    p = os.path.join(CGDIR, fn)
    if not os.path.isfile(p) or os.path.islink(p):
        die(f"{p} missing")
cr = subprocess.run(
    [CHOWN, str(ADMIN_UID), "--", CGDIR,
     f"{CGDIR}/cgroup.procs", f"{CGDIR}/cgroup.subtree_control",
     f"{CGDIR}/cgroup.threads"], capture_output=True, text=True, timeout=10)
if cr.returncode != 0:
    die(f"delegation chown failed rc={cr.returncode}: {cr.stderr.strip()}")
say(f"{REL} delegated to uid {ADMIN_UID} "
    "(dir, cgroup.procs, cgroup.subtree_control, cgroup.threads)")

# The anchored scope prefix every peer cgroup must equal or sit under.
SCOPE_PREFIX = REL

# (3) donation listener — root-created, root-0755 parent, never inside
# the admin-writable per-launch dir.
if not os.path.isdir(DONATE_DIR):
    die(f"{DONATE_DIR} missing (provisioning creates it root-0755)")
if os.path.islink(DONATE_DIR):
    die(f"{DONATE_DIR} is a symlink")
sock_path = f"{DONATE_DIR}/qshm-donate-{TOKEN}.sock"
if os.path.exists(sock_path):
    die(f"{sock_path} already exists (a stale or planted socket)")
listener = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
if T:
    # the test-root prefix pushes the path past sun_path's 108; bind the
    # basename from inside the directory instead (same file, short name)
    os.chdir(DONATE_DIR)
    listener.bind(os.path.basename(sock_path))
else:
    listener.bind(sock_path)
os.chmod(sock_path, 0o600)   # connect() needs write on the socket
listener.listen(8)
listener.setblocking(False)

# (4) control socketpair + bridge child (admin uid, root-owned exec chain)
ctl_b, ctl_a = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET)
bridge_env = {
    "PATH": os.environ.get("PATH", "/usr/bin:/bin") if T else "/usr/bin:/bin",
    "HOME": ADMIN_HOME,
    "USER": ADMIN_USER,
    "LOGNAME": ADMIN_USER,
    "XDG_RUNTIME_DIR": f"{T}/run/user/{ADMIN_UID}",
    "QSHM_LISTENER_FD": str(listener.fileno()),
    "QSHM_CTL_FD": str(ctl_a.fileno()),
    "QSHM_SCOPE_PREFIX": SCOPE_PREFIX,
}
if T:
    bridge_env["TIER3S_TEST_ROOT"] = T
    if os.environ.get("QSHM_ACCEPT_DEADLINE"):
        # unit-test knob only: bounds the bridge's accept window so a
        # no-connect launch refuses inside a test's patience.
        bridge_env["QSHM_ACCEPT_DEADLINE"] = os.environ["QSHM_ACCEPT_DEADLINE"]
podman_env = dict(bridge_env)
podman_env.pop("QSHM_LISTENER_FD")
podman_env.pop("QSHM_CTL_FD")
podman_env.pop("QSHM_SCOPE_PREFIX")


def run_admin(*args, **kw):
    """Run a command as the admin uid through runuser, never as root.
    The command is resolved under the fixed PATH=/usr/bin:/bin."""
    return subprocess.run(
        [RUNUSER, "-u", ADMIN_USER, "--", "/usr/bin/env", "-i",
         *[f"{k}={v}" for k, v in podman_env.items()], *args],
        capture_output=True, text=True, **kw)


bridge = None
container_id = None
authorized = False


def teardown(rc):
    """Close every endpoint, unlink only the socket we bound, remove a
    container that never reached start. Never returns."""
    try:
        if bridge is not None and bridge.poll() is None:
            bridge.terminate()
            bridge.wait(timeout=5)
    except Exception:
        try:
            bridge.kill()
            bridge.wait(timeout=5)
        except Exception:
            pass
    if container_id and not authorized:
        run_admin("podman", "rm", "-f", container_id,
                  timeout=15)
    try:
        listener.close()
    except Exception:
        pass
    try:
        st = os.lstat(sock_path)
        if st.st_mode & 0o170000 == 0o140000:  # S_IFSOCK only
            os.unlink(sock_path)
    except OSError:
        pass
    sys.exit(rc)


def refuse(msg):
    say(f"REFUSE: {msg}")
    teardown(2)


# Fork the bridge. runuser is the only exec in the chain: the listener
# and control fds cross it by descriptor number (non-CLOEXEC), the same
# pattern as the Sentry's own self-exec handoff.
bridge = subprocess.Popen(
    [RUNUSER, "-u", ADMIN_USER, "--", "/usr/bin/env", "-i",
     *[f"{k}={v}" for k, v in bridge_env.items()], PYTHON, BRIDGE],
    pass_fds=[listener.fileno(), ctl_a.fileno()],
    stdout=sys.stderr, stderr=sys.stderr)
ctl_a.close()
ctl_b.settimeout(30)

# (5) the split launch: create -> init -> verify -> auth/ack -> start
cr = run_admin("podman", *PODMAN_ARGV, timeout=180)
if cr.returncode != 0:
    refuse(f"podman create failed rc={cr.returncode}: "
           f"{cr.stdout.strip()} {cr.stderr.strip()}")
container_id = cr.stdout.strip().splitlines()[-1].strip()
if not re.fullmatch(r"[0-9a-f]{64}", container_id):
    refuse(f"podman create returned no container id: {cr.stdout!r}")
say(f"created {container_id[:16]}…")

ir = run_admin("podman", "init", container_id, timeout=120)
if ir.returncode != 0:
    refuse(f"podman init failed rc={ir.returncode}: "
           f"{ir.stdout.strip()} {ir.stderr.strip()}")

# The bridge reports the accepted peer as "PEER <pid>"; anything else,
# EOF, or the deadline is a refusal.
try:
    msg, anc, mflags, _ = ctl_b.recvmsg(64)
except (socket.timeout, OSError) as e:
    refuse(f"no peer report from bridge: {e}")
if not msg.startswith(b"PEER "):
    refuse(f"unexpected bridge control message {msg!r}")
try:
    peer_pid = int(msg[5:])
except ValueError:
    refuse(f"bad peer report {msg!r}")
if bridge.poll() is not None:
    refuse(f"bridge exited rc={bridge.returncode} during init")

# Verify the connected peer IS this create's Sentry: OCI state for the
# exact container id `podman create` returned, from the launch's own
# runsc state root — never from peer-supplied text.
sr = subprocess.run(
    [RUNSC, "--ignore-cgroups", f"--root={RUNSC_ROOT_BASE}/{ADMIN_UID}",
     "state", container_id],
    capture_output=True, text=True, timeout=15)
sandbox_pid = None
if sr.returncode == 0:
    import json
    try:
        sandbox_pid = int(json.loads(sr.stdout)["pid"])
    except (KeyError, ValueError, json.JSONDecodeError):
        pass
if sandbox_pid is None or peer_pid != sandbox_pid:
    refuse(f"accepted peer pid {peer_pid} != sandbox pid {sandbox_pid} "
           f"for container {container_id[:16]}…")

# Peer liveness + anchored cgroup prefix (the prefix was captured from
# /proc/self/cgroup before delegation; the peer's is only checked
# against it, never trusted).
try:
    with open(f"{PROC}/{peer_pid}/cgroup") as f:
        peer_cg = [l.strip() for l in f if l.strip()]
except OSError as e:
    refuse(f"cannot read peer cgroup /proc/{peer_pid}/cgroup: {e}")
peer_rel = next((l[3:] for l in peer_cg if l.startswith("0::/")), None)
if peer_rel is None or not (
        peer_rel == SCOPE_PREFIX or peer_rel.startswith(SCOPE_PREFIX + "/")):
    refuse(f"peer cgroup {peer_rel} is not under the launch scope "
           f"{SCOPE_PREFIX}")
say(f"peer verified: pid {peer_pid} == sandbox pid, scope member")

# Committed authorization; the channel stayed quiescent until now.
try:
    ctl_b.sendall(b"AUTH")
    ack, _, _, _ = ctl_b.recvmsg(16)
except OSError as e:
    refuse(f"auth/ack exchange failed: {e}")
if ack != b"ACK":
    refuse(f"bridge did not ack the authorization ({ack!r})")
authorized = True
say("authorization committed and acked; starting")

st = run_admin("podman", "start", container_id, timeout=60)
if st.returncode != 0:
    refuse(f"podman start failed rc={st.returncode}: "
           f"{st.stdout.strip()} {st.stderr.strip()}")
say(f"running: {container_id[:16]}… scope={SCOPE_PREFIX}")

# (6) supervise: the launch ends when the container exits (podman
# start returns immediately; `podman wait` holds until exit) or when
# the bridge dies. Either path tears the whole thing down.
wait_p = subprocess.Popen(
    [RUNUSER, "-u", ADMIN_USER, "--", "/usr/bin/env", "-i",
     *[f"{k}={v}" for k, v in podman_env.items()],
     "podman", "wait", container_id],
    stdout=subprocess.PIPE, text=True)
while True:
    wr = wait_p.poll()
    br = bridge.poll()
    if wr is not None:
        break
    if br is not None:
        say(f"bridge exited rc={br}; tearing down")
        break
    # channel EOF is the bridge's problem; here we only watch processes
    time.sleep(0.5)
try:
    wait_p.wait(timeout=10)
except subprocess.TimeoutExpired:
    wait_p.kill()
    wait_p.wait()
out = (wait_p.stdout.read() if wait_p.stdout else "").strip()
rc = 0
try:
    rc = int(out.splitlines()[-1]) if out else 0
except ValueError:
    rc = wait_p.returncode if wait_p.returncode is not None else 1
run_admin("podman", "rm", "-f", container_id, timeout=15)
teardown(rc)
