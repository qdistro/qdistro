[Unit]
Description=qdwin compositor (libweston + qdwin-shell.so)
Documentation=https://codeberg.org/qdistro/qdwin
PartOf=qdwin-session.target

[Service]
Type=simple
# Pixman renderer is required for the VM target (virtio-gpu without
# accel3d). On bare-metal with a real GPU drop renderer=pixman from
# weston.ini and let weston pick the GL renderer.
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_SESSION_TYPE=wayland
# qdwin needs a small libweston patch for layer-shell clients that
# create xdg_popup with parent=NULL and attach it later through
# zwlr_layer_surface_v1.get_popup. Keep the patch private to this
# compositor service, and map backend/renderer modules back to the
# distro copies so the DRM session keeps using the packaged drivers.
Environment=LD_LIBRARY_PATH=/usr/libexec/qdistro/qdwin-libweston/lib64
Environment=WESTON_MODULE_MAP=drm-backend.so=/usr/lib64/libweston-14/drm-backend.so;gl-renderer.so=/usr/lib64/libweston-14/gl-renderer.so;color-lcms.so=/usr/lib64/libweston-14/color-lcms.so;headless-backend.so=/usr/lib64/libweston-14/headless-backend.so;pipewire-backend.so=/usr/lib64/libweston-14/pipewire-backend.so;rdp-backend.so=/usr/lib64/libweston-14/rdp-backend.so;wayland-backend.so=/usr/lib64/libweston-14/wayland-backend.so;x11-backend.so=/usr/lib64/libweston-14/x11-backend.so;xwayland.so=/usr/lib64/libweston-14/xwayland.so
# qdwin's protocol surface (qdwin_shell_v1 v14, qdwin_locker_v1,
# wp_security_context_v1) is compiled into qdwin-shell.so; weston
# loads it as a plugin via shell= in weston.ini.
# weston --backend takes a single plugin; pipewire is not a display
# backend — view_stream output goes through weston.ini's [pipewire]
# section, not the cmdline.
ExecStart=/usr/bin/weston \
    --backend=drm-backend.so \
    --config=%h/weston.ini \
    --socket=wayland-1
Restart=on-failure
RestartSec=2
