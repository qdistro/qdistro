[Unit]
Description=qdwin compositor (libweston + qdwin-shell.so)
Documentation=https://codeberg.org/qdistro/qdwin
PartOf=qdwin-session.target

[Service]
Type=simple
# renderer=gl (set in weston.ini) is required for the virtio-gpu
# hardware cursor plane: libweston only allocates the GBM cursor BOs in
# the GL path, so under pixman the cursor is software-composited into the
# scanout and doubles with the SPICE host cursor. GL runs on a
# software-only virtio-gpu via llvmpipe-over-GBM (Mesa 26.1.0); the old
# "pixman required" rationale is stale. See
# todo/issues/qdwin/vm-double-cursor.md.
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_SESSION_TYPE=wayland
# qdwin needs a small libweston patch for layer-shell clients that
# create xdg_popup with parent=NULL and attach it later through
# zwlr_layer_surface_v1.get_popup. Keep the patch private to this
# compositor service. The DRM backend + GL renderer come from the
# vendored tree too: the vendored drm-backend.so carries the
# virtio-gpu cursor-hotspot fix (DRM_CLIENT_CAP_CURSOR_PLANE_HOTSPOT +
# HOTSPOT_X/Y), and it must run against the vendored core it was built
# against. The remaining backends stay on the distro copies (packaged
# drivers); they don't touch the cursor path.
Environment=LD_LIBRARY_PATH=/usr/libexec/qdistro/qdwin-libweston/lib64
Environment=WESTON_MODULE_MAP=drm-backend.so=/usr/libexec/qdistro/qdwin-libweston/lib64/libweston-16/drm-backend.so;gl-renderer.so=/usr/libexec/qdistro/qdwin-libweston/lib64/libweston-16/gl-renderer.so;color-lcms.so=/usr/lib64/libweston-16/color-lcms.so;headless-backend.so=/usr/lib64/libweston-16/headless-backend.so;pipewire-backend.so=/usr/lib64/libweston-16/pipewire-backend.so;rdp-backend.so=/usr/lib64/libweston-16/rdp-backend.so;wayland-backend.so=/usr/lib64/libweston-16/wayland-backend.so;x11-backend.so=/usr/lib64/libweston-16/x11-backend.so;xwayland.so=/usr/lib64/libweston-16/xwayland.so
# qdwin's protocol surface (qdwin_shell_v1 v14, qdwin_locker_v1,
# wp_security_context_v1) is compiled into qdwin-shell.so; weston
# loads it as a plugin via shell= in weston.ini.
# weston --backend takes a single plugin, but view_stream needs a pipewire
# display backend loaded ALONGSIDE drm. Both are loaded via weston.ini
# `[core] backend=drm-backend.so,pipewire-backend.so` (drm primary console,
# pipewire secondary off-screen capture outputs); the [pipewire] section only
# configures the already-loaded backend. A --backend cmdline would override
# that list, so it is intentionally omitted here.
ExecStart=/usr/bin/weston \
    --config=%h/weston.ini \
    --socket=wayland-1
Restart=on-failure
RestartSec=2
