[Unit]
Description=qdwin compositor (libweston + qdwin-shell.so)
Documentation=https://codeberg.org/qdistro/qdwin
PartOf=qdwin-session.target

[Service]
Type=simple
# Pixman renderer is required for the VM target (virtio-gpu without
# accel3d). On bare-metal with a real GPU drop renderer=pixman from
# weston.ini and let weston pick the GL renderer.
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_SESSION_TYPE=wayland
# qdwin's protocol surface (qdwin_shell_v1 v14, qdwin_locker_v1,
# wp_security_context_v1) is compiled into qdwin-shell.so; weston
# loads it as a plugin via shell= in weston.ini.
# weston --backend takes a single plugin; pipewire is not a display
# backend — view_stream output goes through weston.ini's [pipewire]
# section, not the cmdline.
ExecStart=/usr/bin/weston \
    --backend=drm-backend.so \
    --config=%h/weston.ini \
    --socket=wayland-1
Restart=on-failure
RestartSec=2
