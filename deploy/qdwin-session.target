[Unit]
Description=qdistro desktop session (qdwin compositor + qdshell)
Documentation=https://github.com/qdistro/qdistro
# qdwin-session.target is what greetd's [default_session].command
# resolves to (via deploy/qdwin-session-launcher.sh). It wants both
# the compositor and the shell; the compositor starts first, the
# shell binds qdwin_shell_v1 once the wayland socket appears.
#
# qdshell's death must not bring down the compositor — the user
# may need to retry an unlock, kill a wedged frame, etc. — so
# qdshell is a Wants= (recoverable) and qdwin is Requires= (the
# whole target dies if the compositor dies). qdshell.service has
# Restart=on-failure inside the unit; the target itself stays up.
Wants=qdshell.service
# qdlocker is a first-class session member: the screen locker must be
# running and bound to qdwin_locker_v1 for panel lock actions and
# compositor-driven lock requests to work. Wants= (not Requires=) so a
# locker crash does not tear down the desktop — qdlocker.service has
# Restart=always and re-binds. Ordered After= the compositor so the
# qdwin_locker_v1 global is advertised before the locker connects.
Wants=qdlocker.service
Requires=qdwin-compositor.service
After=qdwin-compositor.service

[Install]
WantedBy=default.target
