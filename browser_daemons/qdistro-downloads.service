[Unit]
Description=qdistro browser download-notification daemon (Bridge Phase-9e)
# Per-user session daemon. Raises a desktop notification on a completed
# browser download; "Open folder" launches the user's file manager on
# the download's containing directory.
After=dbus.socket
Requires=dbus.socket
# qdwin-session.target, not graphical-session.target: qdistro never
# reaches the latter (deploy/qdwin-session.target is the desktop
# session), so this PartOf= never stopped the daemon at logout — it
# lingered for the life of the user manager.
#
# Retargeting PartOf= ALONE would have been a regression, not a fix:
# qdwin-session-launcher.sh stops the target when the session ends, so
# the daemons would have been stopped and — being started only by
# default.target, which the user manager reached long before, and
# having no D-Bus activation file — never restarted until reboot. The
# second WantedBy= below is what makes the session-scoped lifecycle
# whole: stopped with the session, started again with the next one.
PartOf=qdwin-session.target

[Service]
Type=dbus
BusName=org.qdistro.Downloads
ExecStart=/usr/bin/python3 /usr/libexec/qdistro/qdistro_downloads_daemon.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
# The "Open folder" path execs the user's own file manager as the user;
# it never needs to write outside the session, but it must be able to
# exec a file manager, so ProtectSystem stays at the lighter setting.
ProtectSystem=yes
ProtectHome=read-only
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=default.target
# Also wanted by the desktop session, so the PartOf= stop above has a
# matching start. Harmless for uids that never reach the target (a
# silo): default.target still starts the daemon there.
WantedBy=qdwin-session.target
