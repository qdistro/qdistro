#!/usr/bin/env python3
"""qci-claude — qdistro CI orchestrator with Claude Sonnet subagents.

Drop-in replacement for qci (bash). Same run-directory layout, same
results.tsv / manifest.txt contract, same report.py integration.

Key differences from qci:
  - GUI scenario agent is Claude Sonnet via `claude` CLI (not Codex).
  - Between-scenario VM drain is built into the GUI gate.
  - VM template auto-detection (no hard-coded qdistro-template default).
  - Python subprocess management with proper timeout handling.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
import time
from pathlib import Path

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

PROJECTS = [
    "qdistro", "qdwin", "qdshell", "qdbrowser",
    "qdchrome-extension", "qdfirefox-extension", "qdgreeter",
    "qdistro-site", "qdlocker", "qfileman", "qnotebook", "qterminator",
]

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_PREFLIGHT = 10
EXIT_BUILD = 20
EXIT_HOST = 30
EXIT_BATS = 35
EXIT_VM_PROVISION = 40
EXIT_VM_BOOT = 50
EXIT_SERVICE = 60
EXIT_GUI = 70
EXIT_VISUAL = 80
EXIT_RUNNER = 90

EXIT_CLASS = {
    0: "pass", 10: "preflight", 20: "build", 30: "host", 35: "bats",
    40: "vm_provision", 50: "vm_boot", 60: "service", 70: "gui",
    80: "visual", 90: "runner",
}

KNOWN_EXITS = set(EXIT_CLASS)

VIRSH = ["virsh", "-c", "qemu:///session"]

# Scenario timeout: 8 minutes per scenario (Codex used unlimited; we cap it).
SCENARIO_TIMEOUT = 480
# Budget cap per scenario in USD.
SCENARIO_BUDGET = 0.80

# ---------------------------------------------------------------------------
# Paths (resolved at startup)
# ---------------------------------------------------------------------------

SELF = Path(__file__).resolve()
QCI_BIN_DIR = SELF.parent
QCI_DIR = QCI_BIN_DIR.parent
QDISTRO_REPO = QCI_DIR.parent
WORKSPACE = QDISTRO_REPO.parent
RUNS_DIR = Path(os.environ.get("QCI_RUNS_DIR", QCI_DIR / "runs"))
REPORT_PY = QCI_DIR / "lib" / "report.py"
VM_TOOLS = QDISTRO_REPO / "scripts" / "vm"
IMG_DIR = Path(os.environ.get(
    "QDWIN_IMG_DIR",
    Path.home() / ".local" / "share" / "libvirt" / "images",
))

# ---------------------------------------------------------------------------
# Utilities
# ---------------------------------------------------------------------------

def now_utc() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def stamp() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")

def log(msg: str) -> None:
    print(f"[qci-claude] {msg}", file=sys.stderr, flush=True)

def safe_name(s: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]", "_", s.replace("/", "_").replace(":", "_").replace(" ", "_").replace("@", "_"))

def exit_class_name(code: int) -> str:
    return EXIT_CLASS.get(code, f"unknown({code})")

def map_rc(rc: int, default: int) -> int:
    return rc if rc in KNOWN_EXITS else default

def run_cmd(
    cmd: str | list[str],
    cwd: str | Path | None = None,
    env: dict | None = None,
    timeout: int | None = None,
    capture: bool = True,
) -> subprocess.CompletedProcess:
    merged_env = {**os.environ, **(env or {})}
    merged_env["LIBVIRT_DEFAULT_URI"] = "qemu:///session"
    merged_env.setdefault("QT_QPA_PLATFORM", "offscreen")
    if isinstance(cmd, str):
        return subprocess.run(
            cmd, shell=True, cwd=cwd, env=merged_env,
            capture_output=capture, text=True, timeout=timeout,
        )
    return subprocess.run(
        cmd, cwd=cwd, env=merged_env,
        capture_output=capture, text=True, timeout=timeout,
    )


# ---------------------------------------------------------------------------
# CIRun — manages one run's state and artifact directory
# ---------------------------------------------------------------------------

class CIRun:
    def __init__(self, gate: str, argv: list[str]):
        self.gate = gate
        RUNS_DIR.mkdir(parents=True, exist_ok=True)
        rid = f"{gate}-{stamp()}-{os.getpid()}"
        self.rdir = RUNS_DIR / rid
        for sub in ("agent-notes", "preflight", "host", "vm", "gui",
                     "bats", "repos", "screenshots", "journals", "reports"):
            (self.rdir / sub).mkdir(parents=True, exist_ok=True)
        self.created_vms: list[str] = []
        (self.rdir / "vm" / "created-vms.txt").write_text("")

        with open(self.rdir / "manifest.txt", "w") as f:
            f.write(f"run_id={rid}\n")
            f.write(f"gate={gate}\n")
            f.write(f"started_utc={now_utc()}\n")
            host = subprocess.run(["hostname", "-s"], capture_output=True, text=True).stdout.strip() or "unknown"
            f.write(f"host={host}\n")
            f.write(f"user={os.environ.get('USER', 'unknown')}\n")
            f.write(f"workspace={WORKSPACE}\n")
            f.write(f"qci={SELF}\n")
            cmd_str = shlex.join([str(SELF), gate] + argv)
            f.write(f"command={cmd_str}\n")

        with open(self.rdir / "results.tsv", "w") as f:
            f.write("gate\tsubject\tstatus\texit_code\texit_class\tkind\tlog\tnotes\n")

        with open(self.rdir / "repo-state.tsv", "w") as f:
            f.write("repo\tbranch\thead\tdirty_files\tstatus_log\n")

        self._collect_repo_state()
        log(f"artifacts -> {self.rdir}")

    def kv(self, key: str, value: str) -> None:
        with open(self.rdir / "manifest.txt", "a") as f:
            f.write(f"{key}={value}\n")

    def record(
        self, gate: str, subject: str, status: str, exit_code: int,
        exit_class: str, kind: str, log_path: str = "", notes: str = "",
    ) -> None:
        notes = notes.replace("\t", " ").replace("\n", " ")
        rel = self._rel(log_path)
        with open(self.rdir / "results.tsv", "a") as f:
            f.write(f"{gate}\t{subject}\t{status}\t{exit_code}\t{exit_class}\t{kind}\t{rel}\t{notes}\n")

    def record_pass(self, gate: str, subject: str, kind: str, log_path: str = "", notes: str = "") -> None:
        self.record(gate, subject, "pass", 0, "pass", kind, log_path, notes)

    def record_fail(self, gate: str, subject: str, exit_code: int, kind: str, log_path: str = "", notes: str = "") -> None:
        self.record(gate, subject, "fail", exit_code, exit_class_name(exit_code), kind, log_path, notes)

    def record_skip(self, gate: str, subject: str, kind: str, notes: str = "", log_path: str = "") -> None:
        self.record(gate, subject, "skip", 0, "pass", kind, log_path, notes)

    def record_blocked(self, gate: str, subject: str, exit_code: int, kind: str, notes: str = "", log_path: str = "") -> None:
        self.record(gate, subject, "blocked", exit_code, exit_class_name(exit_code), kind, log_path, notes)

    def run_logged(
        self, gate: str, subject: str, default_class: int, kind: str,
        workdir: Path, cmd: str, notes: str = "", timeout: int | None = None,
    ) -> int:
        safe = safe_name(subject)
        log_path = self.rdir / gate / f"{safe}.log"
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with open(log_path, "w") as f:
            f.write(f"cwd={workdir}\n")
            f.write(f"cmd={cmd}\n")
            f.write(f"started_utc={now_utc()}\n\n")
        log(f"{gate}/{subject}")
        try:
            result = run_cmd(
                f"bash -lc {shlex.quote(cmd)}",
                cwd=workdir, timeout=timeout,
            )
            rc = result.returncode
            output = (result.stdout or "") + (result.stderr or "")
        except subprocess.TimeoutExpired:
            rc = default_class
            output = f"\n[qci-claude] TIMEOUT after {timeout}s\n"
        except Exception as e:
            rc = default_class
            output = f"\n[qci-claude] EXCEPTION: {e}\n"

        with open(log_path, "a") as f:
            f.write(output)
            f.write(f"\nfinished_utc={now_utc()}\n")
            f.write(f"raw_exit_code={rc}\n")

        mapped = map_rc(rc, default_class)
        with open(log_path, "a") as f:
            f.write(f"qci_exit_code={mapped}\n")

        if mapped == 0:
            self.record_pass(gate, subject, kind, str(log_path), notes)
        else:
            self.record_fail(gate, subject, mapped, kind, str(log_path), notes)
        return mapped

    def finish(self, rc: int) -> None:
        self.kv("finished_utc", now_utc())
        self.kv("exit_code", str(rc))
        self.kv("exit_class", exit_class_name(rc))
        (self.rdir / "exit-code.txt").write_text(f"{rc}\n")
        if REPORT_PY.exists():
            try:
                result = run_cmd(
                    [sys.executable, str(REPORT_PY), str(self.rdir)],
                    timeout=30,
                )
                (self.rdir / "reports" / "report-generator.log").write_text(
                    (result.stdout or "") + (result.stderr or "")
                )
            except Exception as e:
                log(f"report generation failed: {e}")
        log(f"run {self.rdir.name} exit={rc} class={exit_class_name(rc)}")
        if (self.rdir / "report.md").exists():
            log(f"report: {self.rdir / 'report.md'}")
        if (self.rdir / "report.html").exists():
            log(f"html:   {self.rdir / 'report.html'}")

    def _rel(self, path: str) -> str:
        if not path:
            return ""
        p = Path(path)
        try:
            return str(p.relative_to(self.rdir))
        except ValueError:
            return path

    def _collect_repo_state(self) -> None:
        for project in PROJECTS:
            repo = WORKSPACE / project
            if not (repo / ".git").is_dir():
                continue
            status_log = self.rdir / "repos" / f"{project}.status.txt"
            try:
                branch = run_cmd(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=repo).stdout.strip() or "?"
                head = run_cmd(["git", "rev-parse", "--short", "HEAD"], cwd=repo).stdout.strip() or "?"
                dirty = run_cmd(["git", "status", "--short"], cwd=repo).stdout.strip()
                dirty_count = str(len(dirty.splitlines())) if dirty else "0"
                status_text = run_cmd(["git", "status", "--short", "--branch"], cwd=repo).stdout
                log_text = run_cmd(["git", "log", "-1", "--oneline"], cwd=repo).stdout
                status_log.write_text(f"{status_text}\n{log_text}")
            except Exception:
                branch = head = "?"
                dirty_count = "?"
            with open(self.rdir / "repo-state.tsv", "a") as f:
                f.write(f"{project}\t{branch}\t{head}\t{dirty_count}\t{self._rel(str(status_log))}\n")


# ---------------------------------------------------------------------------
# VM management
# ---------------------------------------------------------------------------

def vm_exists(name: str) -> bool:
    return run_cmd(VIRSH + ["dominfo", name]).returncode == 0

def vm_is_running(name: str) -> bool:
    r = run_cmd(VIRSH + ["domstate", name])
    return r.returncode == 0 and "running" in r.stdout.lower()

def is_protected_vm(name: str) -> bool:
    return name.startswith("qdistro-daily")

def vm_disk_path(name: str) -> str | None:
    r = run_cmd(VIRSH + ["domblklist", name, "--details"])
    if r.returncode != 0:
        return None
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[1] == "disk" and parts[3].startswith("/"):
            return parts[3]
    r = run_cmd(VIRSH + ["domblklist", name, "--details", "--inactive"])
    if r.returncode != 0:
        return None
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[1] == "disk" and parts[3].startswith("/"):
            return parts[3]
    return None

def find_vm_template() -> str | None:
    """Auto-detect a usable VM template from available domains."""
    template = os.environ.get("QDWIN_VM_TEMPLATE", "")
    if template and vm_exists(template):
        return template
    if vm_exists("qdistro-template"):
        return "qdistro-template"
    r = run_cmd(VIRSH + ["list", "--all", "--name"])
    if r.returncode != 0:
        return None
    for name in r.stdout.strip().splitlines():
        name = name.strip()
        if not name:
            continue
        if name.startswith("qci-") or name.startswith("qdistro-daily"):
            if vm_exists(name):
                return name
    return None

def vm_exec(vm: str, cmd: str, timeout: int = 120) -> subprocess.CompletedProcess:
    return run_cmd([str(VM_TOOLS / "vm-exec"), vm, cmd], timeout=timeout)

def vm_gui(vm: str, *args: str, timeout: int = 30) -> subprocess.CompletedProcess:
    return run_cmd([str(VM_TOOLS / "vm-gui"), vm] + list(args), timeout=timeout)

def acquire_vm(run: CIRun, gate: str, explicit: str = "") -> str | None:
    """Provision or validate a VM. Returns the VM name, or None on failure."""
    if explicit:
        if not vm_exists(explicit):
            log(f"VM '{explicit}' not found")
            return None
        if is_protected_vm(explicit) and os.environ.get("QCI_FORCE_PROTECTED_VM") != "1":
            log(f"refusing protected VM '{explicit}'; set QCI_FORCE_PROTECTED_VM=1")
            return None
        if not vm_is_running(explicit):
            log(f"starting VM '{explicit}'")
            run_cmd(VIRSH + ["start", explicit])
            run_cmd([str(VM_TOOLS / "vm-start-and-wait"), explicit], timeout=120)
        return explicit

    pw = os.environ.get("QDISTRO_VM_PASSWORD", "")
    if not pw:
        log("QDISTRO_VM_PASSWORD is required to create a disposable VM")
        return None

    template = find_vm_template()
    if template:
        os.environ["QDWIN_VM_TEMPLATE"] = template
        log(f"using VM template: {template}")

    spinner = "spin-test-vm-gui.sh" if gate == "gui" else "spin-test-vm.sh"
    log_path = run.rdir / "vm" / f"spin-{gate}.log"
    log(f"creating disposable VM for {gate} via {spinner}")

    try:
        result = run_cmd(
            [str(VM_TOOLS / spinner), f"qci-{gate}"],
            env={"QDISTRO_VM_PASSWORD": pw},
            timeout=900,  # 15 min for full provision
        )
        output = (result.stdout or "") + (result.stderr or "")
        log_path.write_text(output)
        if result.returncode != 0:
            run.record_fail(gate, spinner, EXIT_VM_PROVISION, "vm", str(log_path), "VM creation failed")
            return None
    except subprocess.TimeoutExpired:
        log_path.write_text("TIMEOUT: VM provisioning exceeded 15 minutes\n")
        run.record_fail(gate, spinner, EXIT_VM_PROVISION, "vm", str(log_path), "VM creation timed out")
        return None

    # Extract VM name from output (last line matching qci-<gate>-*)
    vm_name = ""
    for line in reversed(output.splitlines()):
        line = line.strip()
        if line.startswith(f"qci-{gate}") and re.match(r"^qci-[A-Za-z0-9._-]+$", line):
            vm_name = line
            break
    if not vm_name:
        # Fallback: last non-empty line
        for line in reversed(output.splitlines()):
            line = line.strip()
            if line:
                vm_name = line
                break
    if not vm_name:
        run.record_fail(gate, spinner, EXIT_VM_PROVISION, "vm", str(log_path), f"{spinner} produced no VM name")
        return None

    run.created_vms.append(vm_name)
    with open(run.rdir / "vm" / "created-vms.txt", "a") as f:
        f.write(f"{vm_name}\n")
    run.kv(f"vm_{gate}", vm_name)
    return vm_name

def release_vm(run: CIRun, vm: str, rc: int) -> None:
    if not vm:
        return
    if is_protected_vm(vm):
        log(f"preserving protected VM {vm}")
        return
    if vm not in run.created_vms:
        created_file = run.rdir / "vm" / "created-vms.txt"
        if not created_file.exists() or vm not in created_file.read_text():
            log(f"preserving pre-existing VM {vm}")
            return

    keep_failed = os.environ.get("QCI_KEEP_FAILED_VM", "1")
    delete_failed = os.environ.get("QCI_DELETE_FAILED_VM", "0")
    if rc != 0 and delete_failed != "1" and keep_failed == "1":
        log(f"preserving failed VM {vm}")
        run.kv("preserved_failed_vm", vm)
        run.record_skip("lifecycle", vm, "vm", "failed VM preserved for debugging")
        return

    log(f"destroying VM {vm}")
    disk = vm_disk_path(vm)
    run_cmd(VIRSH + ["destroy", vm])
    r = run_cmd(VIRSH + ["undefine", vm, "--remove-all-storage"])
    if r.returncode != 0:
        run_cmd(VIRSH + ["undefine", vm, "--nvram"])
        if disk and Path(disk).exists():
            Path(disk).unlink(missing_ok=True)

def collect_vm_artifacts(run: CIRun, vm: str, label: str) -> None:
    if not vm:
        return
    outdir = run.rdir / "vm" / label
    outdir.mkdir(parents=True, exist_ok=True)
    (run.rdir / "journals").mkdir(exist_ok=True)
    (run.rdir / "screenshots").mkdir(exist_ok=True)

    run_cmd(VIRSH + ["dumpxml", vm], timeout=10)
    for vcmd, fname in [
        (VIRSH + ["dumpxml", vm], "domain.xml"),
        (VIRSH + ["domblklist", vm, "--details"], "domblklist.txt"),
        (VIRSH + ["dominfo", vm], "dominfo.txt"),
    ]:
        r = run_cmd(vcmd, timeout=10)
        if r.returncode == 0:
            (outdir / fname).write_text(r.stdout or "")

    run_cmd(VIRSH + ["screenshot", vm, str(run.rdir / "screenshots" / f"{label}-final.ppm")], timeout=10)

    vmx = VM_TOOLS / "vm-exec"
    if not vmx.exists():
        return
    for vcmd, fname in [
        ("journalctl -b --no-pager 2>/dev/null | tail -400", f"{label}-system.log"),
        ("journalctl _UID=1000 -b --no-pager 2>/dev/null | tail -400", f"{label}-user-1000.log"),
    ]:
        try:
            r = vm_exec(vm, vcmd, timeout=30)
            (run.rdir / "journals" / fname).write_text((r.stdout or "") + (r.stderr or ""))
        except Exception:
            pass

    for vcmd, fname in [
        (
            "runuser -u admin -- env XDG_RUNTIME_DIR=/run/user/1000 "
            "systemctl --user status qdwin-compositor.service qdshell.service "
            "noctalia-session.service noctalia-shell.service qdlocker.service "
            "qdistro-cursor-sprites.service --no-pager 2>/dev/null || true",
            "systemctl-user-status.txt",
        ),
        (
            "WAYLAND_DISPLAY=wayland-1 XDG_RUNTIME_DIR=/run/user/1000 "
            "runuser -u admin -- wayland-info 2>/dev/null | head -240 || true",
            "wayland-info.txt",
        ),
        (
            "echo list | socat - UNIX-CONNECT:/run/user/1000/qdshell.sock 2>&1 | head -200 || true",
            "qdshell-list.txt",
        ),
    ]:
        try:
            r = vm_exec(vm, vcmd, timeout=30)
            (outdir / fname).write_text((r.stdout or "") + (r.stderr or ""))
        except Exception:
            pass


# ---------------------------------------------------------------------------
# Gate: preflight
# ---------------------------------------------------------------------------

def gate_preflight(run: CIRun) -> int:
    rc = EXIT_OK
    report = run.rdir / "preflight" / "preflight.txt"
    lines: list[str] = []

    def check(label: str, cmd: str, required: bool = True) -> None:
        nonlocal rc
        try:
            r = run_cmd(f"bash -lc {shlex.quote(cmd)}", timeout=10)
            ok = r.returncode == 0
        except Exception:
            ok = False
        if ok:
            lines.append(f"OK\t{label}")
            run.record_pass("preflight", label, "tool", str(report))
        elif required:
            lines.append(f"MISS\t{label}")
            run.record_fail("preflight", label, EXIT_PREFLIGHT, "tool", str(report), "missing required preflight item")
            rc = EXIT_PREFLIGHT
        else:
            lines.append(f"WARN\t{label}")
            run.record_skip("preflight", label, "tool", "optional tool missing", str(report))

    for p in PROJECTS:
        check(f"repo {p}", f"[ -d '{WORKSPACE / p}' ]")
    check("python3", "command -v python3")
    check("git", "command -v git")
    check("bash", "command -v bash")
    check("virsh", "command -v virsh")
    check("libvirt session", "virsh -c qemu:///session list >/dev/null")
    check("vm-exec", f"[ -x '{VM_TOOLS / 'vm-exec'}' ]")
    check("vm-start-and-wait", f"[ -x '{VM_TOOLS / 'vm-start-and-wait'}' ]")
    check("spin-test-vm.sh", f"[ -x '{VM_TOOLS / 'spin-test-vm.sh'}' ]")
    check("baseweed-baked image", f"test -f '{IMG_DIR / 'baseweed-baked.qcow2'}'")
    check("QDISTRO_VM_PASSWORD", 'test -n "${QDISTRO_VM_PASSWORD:-}"')
    check("claude CLI", "command -v claude")
    check("bats", "command -v bats", required=False)
    check("meson", "command -v meson", required=False)
    check("ninja", "command -v ninja", required=False)
    check("npm", "command -v npm", required=False)
    check("zola", "command -v zola", required=False)

    # libvirt domain listing
    r = run_cmd(VIRSH + ["list", "--all"], timeout=10)
    lines.append("")
    lines.append("## libvirt domains")
    lines.append(r.stdout or "(none)")
    lines.append("")
    lines.append("## qci overlays")
    overlays = list(IMG_DIR.glob("qci-*.qcow2"))
    lines.extend(str(o) for o in overlays) if overlays else lines.append("(none)")

    # VM template check
    template = find_vm_template()
    if template:
        lines.append(f"\n## VM template: {template}")
    else:
        lines.append("\n## VM template: NONE FOUND")
        log("WARNING: no VM template found; VM provisioning will fail")

    report.write_text("\n".join(lines))
    return rc


# ---------------------------------------------------------------------------
# Gate: host
# ---------------------------------------------------------------------------

def gate_host(run: CIRun) -> int:
    rc = EXIT_OK

    tests = [
        ("qdistro-pytest", EXIT_HOST, "pytest", WORKSPACE / "qdistro",
         "python3 -m pytest tests/unit", "qdistro unit tests"),
        ("qdwin-meson", EXIT_BUILD, "build", WORKSPACE / "qdwin",
         "rm -rf build-qci && meson setup build-qci --prefix=/usr && meson compile -C build-qci && meson test -C build-qci --print-errorlogs",
         "qdwin build and meson tests"),
        ("qdwin-shell-syntax", EXIT_HOST, "syntax", WORKSPACE / "qdwin",
         "find tests -name '*.sh' -print0 | xargs -0 -r -n1 bash -n",
         "syntax check qdwin test helpers"),
        ("qdshell-local", EXIT_HOST, "qml", WORKSPACE / "qdshell",
         f"export PKG_CONFIG_PATH=\"{WORKSPACE / 'qdwin' / 'build-qci' / 'meson-uninstalled'}:${{PKG_CONFIG_PATH:-}}\" && "
         "rm -rf build-qci && meson setup build-qci --prefix=/usr && meson compile -C build-qci && scripts/ci-local.sh --no-int",
         "qdshell build, qmltest, lint, format check"),
        ("qdbrowser-pytest", EXIT_HOST, "pytest", WORKSPACE / "qdbrowser",
         "rc=0; for t in tests/test_*.py; do [ -e \"$t\" ] || continue; python3 -m pytest \"$t\" || rc=1; done; exit \"$rc\"",
         "qdbrowser pytest per file"),
        ("qdgreeter-pytest", EXIT_HOST, "pytest", WORKSPACE / "qdgreeter",
         "python3 -m pytest tests", ""),
        ("qdlocker-pytest", EXIT_HOST, "pytest", WORKSPACE / "qdlocker",
         "python3 -m pytest tests/unit", ""),
        ("qfileman-pytest", EXIT_HOST, "pytest", WORKSPACE / "qfileman",
         "python3 -m pytest", ""),
        ("qnotebook-pytest", EXIT_HOST, "pytest", WORKSPACE / "qnotebook",
         "python3 -m pytest", ""),
        ("qterminator-pytest", EXIT_HOST, "pytest", WORKSPACE / "qterminator",
         "python3 -m pytest", ""),
        ("qdchrome-extension", EXIT_HOST, "npm", WORKSPACE / "qdchrome-extension",
         "npm test && npm run build", ""),
        ("qdfirefox-extension", EXIT_HOST, "npm", WORKSPACE / "qdfirefox-extension",
         "npm test && npm run build", ""),
    ]

    # Zola site
    if os.environ.get("QCI_ZOLA_SKIP_EXTERNAL") == "1":
        zola_cmd = "zola check --skip-external-links && zola build"
    else:
        zola_cmd = "zola check && zola build"
    tests.append(("qdistro-site", EXIT_HOST, "zola", WORKSPACE / "qdistro-site", zola_cmd, ""))

    for subject, default_exit, kind, workdir, cmd, notes in tests:
        if not workdir.is_dir():
            run.record_skip("host", subject, kind, f"directory not found: {workdir}")
            continue
        step_rc = run.run_logged("host", subject, default_exit, kind, workdir, cmd, notes)
        if rc == EXIT_OK and step_rc != EXIT_OK:
            rc = step_rc

    return rc


# ---------------------------------------------------------------------------
# Gate: vm-smoke
# ---------------------------------------------------------------------------

def gate_vm_smoke(run: CIRun, explicit: str = "") -> int:
    vm = acquire_vm(run, "vm-smoke", explicit)
    if not vm:
        return EXIT_VM_PROVISION
    run.kv("vm", vm)

    rc = EXIT_OK
    out = run.rdir / "vm" / "vm-smoke.log"
    lines: list[str] = []

    # Check Wayland socket
    r = vm_exec(vm, "test -S /run/user/1000/wayland-1")
    lines.append(f"wayland-1 check: rc={r.returncode}")
    if r.returncode != 0:
        rc = EXIT_VM_BOOT
    else:
        # Check services
        svc_check = textwrap.dedent("""\
            runuser -u admin -- env XDG_RUNTIME_DIR=/run/user/1000 bash -lc '
            set -u
            check_unit() {
                unit=$1
                state=$(systemctl --user is-active "$unit" 2>/dev/null || true)
                printf "%s %s\\n" "$unit" "${state:-unknown}"
                [ "$state" = active ]
            }
            if systemctl --user list-unit-files qdwin-compositor.service >/dev/null 2>&1; then
                ok=0
                check_unit qdwin-compositor.service || ok=1
                check_unit qdshell.service || ok=1
                check_unit qdistro-cursor-sprites.service || ok=1
                exit "$ok"
            elif systemctl --user list-unit-files noctalia-session.service >/dev/null 2>&1; then
                ok=0
                check_unit noctalia-session.service || ok=1
                check_unit noctalia-shell.service || ok=1
                check_unit qdistro-cursor-sprites.service || ok=1
                exit "$ok"
            else
                echo NO_QDWIN_UNITS
                exit 1
            fi
            '
        """)
        r = vm_exec(vm, svc_check, timeout=30)
        lines.append(r.stdout or "")
        if r.returncode != 0:
            rc = EXIT_SERVICE
        output = (r.stdout or "") + (r.stderr or "")
        if re.search(r"(inactive|failed|unknown)$|^NO_QDWIN_UNITS", output, re.MULTILINE):
            rc = EXIT_SERVICE

    out.write_text("\n".join(lines))
    collect_vm_artifacts(run, vm, "vm-smoke")

    if rc == EXIT_OK:
        run.record_pass("vm-smoke", vm, "vm", str(out), "session smoke passed")
    else:
        run.record_fail("vm-smoke", vm, rc, "vm", str(out), "session smoke failed")

    release_vm(run, vm, rc)
    return rc


# ---------------------------------------------------------------------------
# Gate: bats
# ---------------------------------------------------------------------------

def gate_bats(run: CIRun, explicit: str = "", files: list[str] | None = None) -> int:
    if not files:
        bats_dir = WORKSPACE / "qdistro" / "tests" / "integration" / "vm"
        files = sorted(str(f) for f in bats_dir.glob("*.bats")) if bats_dir.is_dir() else []
    if not files:
        run.record_blocked("bats", "bats", EXIT_PREFLIGHT, "bats", "no .bats files found")
        return EXIT_PREFLIGHT

    if not shutil.which("bats"):
        run.record_blocked("bats", "bats", EXIT_PREFLIGHT, "bats", "bats executable not found")
        return EXIT_PREFLIGHT

    rc = EXIT_OK
    for filepath in files:
        base = Path(filepath).name
        stem = Path(filepath).stem
        if explicit:
            vm = explicit
            if not vm_exists(vm):
                run.record_fail("bats", base, EXIT_VM_PROVISION, "bats", notes="explicit VM not found")
                if rc == EXIT_OK:
                    rc = EXIT_VM_PROVISION
                continue
        else:
            vm = acquire_vm(run, f"bats-{safe_name(stem)}")
            if not vm:
                if rc == EXIT_OK:
                    rc = EXIT_VM_PROVISION
                continue

        log_path = run.rdir / "bats" / f"{base}.log"
        log_path.parent.mkdir(parents=True, exist_ok=True)
        log(f"bats {base} on {vm}")

        try:
            result = run_cmd(
                f"VM_NAME={shlex.quote(vm)} bats {shlex.quote(filepath)}",
                cwd=WORKSPACE / "qdistro",
                timeout=600,
            )
            gate_rc = result.returncode
            log_path.write_text((result.stdout or "") + (result.stderr or ""))
        except subprocess.TimeoutExpired:
            gate_rc = EXIT_BATS
            log_path.write_text("TIMEOUT: bats test exceeded 10 minutes\n")

        collect_vm_artifacts(run, vm, f"bats-{stem}")
        if gate_rc == 0:
            run.record_pass("bats", base, "bats", str(log_path), f"VM={vm}")
        else:
            run.record_fail("bats", base, EXIT_BATS, "bats", str(log_path), f"VM={vm} raw_rc={gate_rc}")
            if rc == EXIT_OK:
                rc = EXIT_BATS
        if not explicit:
            release_vm(run, vm, gate_rc)

    return rc


# ---------------------------------------------------------------------------
# Gate: GUI — agent-assisted scenarios via Claude Sonnet
# ---------------------------------------------------------------------------

def find_agent_scenarios() -> list[Path]:
    """Collect all numbered markdown scenario files."""
    scenarios: list[Path] = []
    for pattern in [
        WORKSPACE / "qdwin" / "tests" / "gui" / "[0-9][0-9]-*.md",
        WORKSPACE / "qdwin" / "tests" / "apps" / "[0-9][0-9]-*.md",
        WORKSPACE / "qdistro" / "tests" / "integration" / "permissions-gui" / "[0-9][0-9]-*.md",
        WORKSPACE / "qdistro" / "tests" / "integration" / "qdwin-noctalia" / "[0-9][0-9]-*.md",
        WORKSPACE / "qdlocker" / "tests" / "gui" / "[0-9][0-9]-*.md",
    ]:
        parent = pattern.parent
        glob_pat = pattern.name
        if parent.is_dir():
            scenarios.extend(sorted(parent.glob(glob_pat)))
    return scenarios

def find_nearest_agents_md(scenario: Path) -> Path | None:
    d = scenario.parent
    while d != d.parent:
        candidate = d / "AGENTS.md"
        if candidate.exists():
            return candidate
        d = d.parent
    return None

def drain_vm_state(vm: str) -> None:
    """Clean VM state between scenarios per AGENTS.md 'Between scenarios' block."""
    drain_script = textwrap.dedent("""\
        pkill -u admin -f qdistro_admin_app 2>/dev/null || true
        pkill -u admin -f qdistro_admin_tui 2>/dev/null || true
        pkill -u admin qterminal 2>/dev/null || true
        pkill -u work -f qdistro-test-permission 2>/dev/null || true
        pkill -u work -f dbus-send 2>/dev/null || true
        pkill -f "dbus-monitor.*qdistro" 2>/dev/null || true
        rm -f /etc/qdistro/rules.d/[0-9][0-9]*.yaml 2>/dev/null || true
        systemctl restart qdistro-admin-broker.service 2>/dev/null || true
        sleep 2
        sqlite3 /var/lib/qdistro/approvals/approvals.sqlite "DELETE FROM approvals;" 2>/dev/null || true
        sqlite3 /var/lib/qdistro/audit/audit.sqlite "DELETE FROM audit WHERE source IN ('revoke','clipboard_default_deny','clipboard_rule','clipboard_same_silo') OR action LIKE 'test.%' OR action LIKE 'multi.%' OR action LIKE 'scenario%' OR action LIKE 'qdistro.clipboard.transfer:%';" 2>/dev/null || true
    """)
    import base64
    b64 = base64.b64encode(drain_script.encode()).decode()
    try:
        vm_exec(vm, f"echo {b64} | base64 -d | bash", timeout=30)
    except Exception as e:
        log(f"drain warning: {e}")

def classify_scenario(rel: str, vm: str) -> str | None:
    """Return a skip reason if the scenario should be skipped, or None to run it."""
    # Legacy qdshell ctrl-socket scenarios
    if re.match(r"qdwin/tests/(gui|apps)/\d\d-.*\.md$", rel):
        r = vm_exec(vm, "test -S /run/user/1000/qdshell.sock")
        if r.returncode != 0:
            return "legacy qdshell ctrl-socket not available"
    # Nested KVM scenarios
    nested_kvm_scenarios = {
        "qdistro/tests/integration/permissions-gui/20-tier5-vm-cold-start.md",
        "qdistro/tests/integration/permissions-gui/21-tier5-close-cleanup.md",
        "qdistro/tests/integration/permissions-gui/56-tier4-rdp-window-visible.md",
        "qdistro/tests/integration/permissions-gui/57-tier4-rdp-close-cleanup.md",
    }
    if rel in nested_kvm_scenarios:
        r = vm_exec(vm, "test -e /dev/kvm")
        if r.returncode != 0:
            return "nested KVM not available in VM"
    # Noctalia scenarios
    noctalia_patterns = [
        r"qdistro/tests/integration/permissions-gui/1[89]-",
        r"qdistro/tests/integration/qdwin-noctalia/\d\d-",
        r"qdlocker/tests/gui/\d\d-",
    ]
    if any(re.match(p, rel) for p in noctalia_patterns):
        r = vm_exec(vm, "test -S /run/user/1000/wayland-1 && pgrep -a noctalia-shell >/dev/null")
        if r.returncode != 0:
            return "noctalia/qdshell session not active in this VM profile"
    # SSH-only SELinux scenario
    if rel == "qdistro/tests/integration/permissions-gui/55-qsu-selinux-enforcing.md":
        if not os.environ.get("VM_SSH_PORT"):
            return "VM_SSH_PORT not set for SSH-only SELinux scenario"
    return None

def build_scenario_prompt(vm: str, scenario: Path, run: CIRun, agents_md: Path | None) -> str:
    """Assemble the full prompt for a Claude Sonnet scenario runner."""
    rel = str(scenario.relative_to(WORKSPACE))
    artifact_dir = run.rdir / "gui" / safe_name(rel)
    artifact_dir.mkdir(parents=True, exist_ok=True)

    agents_content = ""
    if agents_md and agents_md.exists():
        agents_content = agents_md.read_text(errors="replace")

    scenario_content = scenario.read_text(errors="replace")

    prompt = textwrap.dedent(f"""\
        You are a graphic-aware UI test runner for qdistro. Execute a single
        GUI scenario end-to-end against a live VM and return a PASS/FAIL report.

        ## Critical environment setup
        Export LIBVIRT_DEFAULT_URI=qemu:///session before ANY virsh, vm-gui,
        or vm-exec command. Every shell command must have this set.

        ## VM
        VMNAME={vm}

        ## Tools (absolute paths — not on $PATH)
        - {VM_TOOLS}/vm-exec {vm} '<command>' — run shell as root in VM.
        - {VM_TOOLS}/vm-gui {vm} screenshot /tmp/<name>.png — take screenshot, then Read the PNG to see it.
        - {VM_TOOLS}/vm-gui {vm} click <x> <y> — left-click at coordinates.
        - {VM_TOOLS}/vm-gui {vm} type <text> — type text.
        - {VM_TOOLS}/vm-gui {vm} key <keysym> — send key.
        - virsh send-key {vm} --codeset linux KEY_... — for modifier chords (preferred over vm-gui key for reliability).
        - For scripts with embedded quotes, base64-wrap them:
          B64=$(base64 -w0 <<'EOF'
          <script>
          EOF
          )
          {VM_TOOLS}/vm-exec {vm} "echo $B64 | base64 -d | bash"

        ## Artifact directory
        Save all screenshots, logs, and notes under:
        {artifact_dir}/

        ## Status file (REQUIRED)
        Before returning, write exactly one word (PASS, FAIL, ERROR, or SKIP) to:
        {artifact_dir}/status.txt

        ## Execution contract
        1. Execute Setup, Steps, Assertions, and Cleanup exactly once, serially.
        2. Take a screenshot after every GUI action that changes state.
        3. Read each screenshot (the Read tool can view images) to judge assertions.
        4. Each Assert bullet → PASS or FAIL with concrete justification referencing the screenshot.
        5. Tear down even on failure.
        6. Do NOT modify repo files. Do NOT fix bugs — report them.
        7. Exit nonzero for FAIL or ERROR. Exit 0 only when all assertions pass.

        ## Report format
        After execution, write a report to {artifact_dir}/report.md:
        ```
        # {scenario.name} — <PASS|FAIL|ERROR>

        ## Assertions
        - [PASS|FAIL] <assertion text> — <one-line justification>

        ## Evidence
        - <screenshot path> — <what it proves>

        ## Recommendation
        <minimal next fix or probe if FAIL/ERROR>
        ```
    """)

    if agents_content:
        prompt += f"\n## Runner orientation (AGENTS.md — read carefully)\n\n{agents_content}\n"

    prompt += f"\n## Scenario file: {scenario}\n\n{scenario_content}\n"

    return prompt

def run_scenario_with_claude(
    vm: str, scenario: Path, run: CIRun, agents_md: Path | None,
) -> tuple[str, int]:
    """Run a single scenario via claude CLI with Sonnet. Returns (status, exit_code)."""
    rel = str(scenario.relative_to(WORKSPACE))
    safe_rel = safe_name(rel)
    artifact_dir = run.rdir / "gui" / safe_rel
    artifact_dir.mkdir(parents=True, exist_ok=True)
    log_path = run.rdir / "gui" / f"{safe_rel}.agent.log"
    prompt_path = run.rdir / "agent-notes" / f"{safe_rel}.prompt.md"

    prompt = build_scenario_prompt(vm, scenario, run, agents_md)
    prompt_path.write_text(prompt)

    claude_cmd = [
        "claude",
        "--model", "sonnet",
        "--dangerously-skip-permissions",
        "--no-session-persistence",
        "--max-budget-usd", str(SCENARIO_BUDGET),
        "-p", prompt,
    ]

    log(f"agent scenario {rel}")
    try:
        result = subprocess.run(
            claude_cmd,
            capture_output=True, text=True,
            timeout=SCENARIO_TIMEOUT,
            env={**os.environ, "LIBVIRT_DEFAULT_URI": "qemu:///session"},
        )
        agent_rc = result.returncode
        output = (result.stdout or "") + "\n" + (result.stderr or "")
        log_path.write_text(output)
    except subprocess.TimeoutExpired:
        agent_rc = 1
        log_path.write_text(f"TIMEOUT: scenario exceeded {SCENARIO_TIMEOUT}s\n")
    except Exception as e:
        agent_rc = 1
        log_path.write_text(f"EXCEPTION: {e}\n")

    # Read status.txt
    status_file = artifact_dir / "status.txt"
    status = "UNKNOWN"
    if status_file.exists():
        raw = status_file.read_text().strip().upper().splitlines()
        if raw:
            word = raw[0].strip()
            if word in ("PASS", "FAIL", "ERROR", "SKIP"):
                status = word

    return status, agent_rc

def run_executable_gui_smokes(run: CIRun, vm: str) -> int:
    """Run the qdwin executable GUI smoke scripts."""
    rc = EXIT_OK

    # Check if qdwin production session is active
    check = vm_exec(
        vm,
        "test -S /run/user/1000/wayland-1 && ! pgrep -x labwc >/dev/null && "
        "runuser -u admin -- env XDG_RUNTIME_DIR=/run/user/1000 "
        "systemctl --user is-active qdwin-compositor.service qdshell.service "
        "qdistro-cursor-sprites.service >/dev/null",
    )
    smokes = [
        "agent-mvp-session-smoke.sh",
        "agent-protocol-audit.sh",
        "agent-cursor-clickthrough-smoke.sh",
        "agent-click-smoke.sh",
    ]
    if check.returncode != 0:
        for s in smokes:
            run.record_skip("gui", f"qdwin-{s}", "gui", "qdwin production session not active in this VM profile")
        return EXIT_OK

    for s in smokes:
        script = WORKSPACE / "qdwin" / "tests" / "gui" / s
        if not script.exists() or not os.access(script, os.X_OK):
            run.record_blocked("gui", s, EXIT_GUI, "gui", "scenario script missing or not executable")
            if rc == EXIT_OK:
                rc = EXIT_GUI
            continue
        step_rc = run.run_logged(
            "gui", f"qdwin-{s}", EXIT_GUI, "gui",
            WORKSPACE / "qdwin",
            f"VMNAME={shlex.quote(vm)} '{script}'",
        )
        if rc == EXIT_OK and step_rc != EXIT_OK:
            rc = step_rc
    return rc

def gate_gui(run: CIRun, explicit: str = "", scenario_filter: list[str] | None = None) -> int:
    vm = acquire_vm(run, "gui", explicit)
    if not vm:
        return EXIT_VM_PROVISION
    run.kv("vm", vm)

    rc = EXIT_OK
    require = os.environ.get("QCI_REQUIRE_AGENT_GUI", "1") == "1"

    # Probe VM capabilities
    legacy_ctrl = vm_exec(vm, "test -S /run/user/1000/qdshell.sock").returncode == 0
    nested_kvm = vm_exec(vm, "test -e /dev/kvm").returncode == 0
    noctalia = vm_exec(vm, "test -S /run/user/1000/wayland-1 && pgrep -a noctalia-shell >/dev/null").returncode == 0

    # 1. Executable qdwin GUI smokes
    step_rc = run_executable_gui_smokes(run, vm)
    if rc == EXIT_OK and step_rc != EXIT_OK:
        rc = step_rc

    # 2. qdshell UI vision pytest
    qdshell_cmd = "QDSHELL_UI_TESTS=1 python3 -m pytest tests/ui -v"
    step_rc = run.run_logged("gui", "qdshell-ui", EXIT_VISUAL, "vision", WORKSPACE / "qdshell", qdshell_cmd, "qdshell agent-assisted UI pytest")
    if step_rc != EXIT_OK:
        qdshell_artifacts = WORKSPACE / "qdshell" / "tests" / "ui" / "artifacts"
        if qdshell_artifacts.is_dir():
            dest = run.rdir / "gui" / "qdshell-ui-artifacts"
            dest.mkdir(exist_ok=True)
            shutil.copytree(qdshell_artifacts, dest, dirs_exist_ok=True)
    if rc == EXIT_OK and step_rc != EXIT_OK:
        rc = step_rc

    # 3. Markdown scenarios via Claude Sonnet
    if scenario_filter:
        scenarios = [Path(s) for s in scenario_filter]
    else:
        scenarios = find_agent_scenarios()

    if not shutil.which("claude"):
        log("claude CLI not found; marking agent scenarios blocked")
        for s in scenarios:
            rel = str(s.relative_to(WORKSPACE))
            run.record_blocked("gui", rel, EXIT_GUI, "agent", "claude CLI not found")
        if require and scenarios:
            rc = EXIT_GUI
        collect_vm_artifacts(run, vm, "gui")
        release_vm(run, vm, rc)
        return rc

    for scenario in scenarios:
        rel = str(scenario.relative_to(WORKSPACE))
        safe_rel = safe_name(rel)
        log_path = run.rdir / "gui" / f"{safe_rel}.agent.log"

        # Check skip conditions
        skip_reason = classify_scenario(rel, vm)
        if skip_reason:
            log_path.write_text(f"Skipped: {skip_reason}\nVM: {vm}\nScenario: {scenario}\n")
            run.record_skip("gui", rel, "agent", skip_reason, str(log_path))
            continue

        # Drain VM state before each scenario
        drain_vm_state(vm)

        agents_md = find_nearest_agents_md(scenario)
        status, agent_rc = run_scenario_with_claude(vm, scenario, run, agents_md)

        if status == "PASS":
            run.record_pass("gui", rel, "agent", str(log_path), "agent scenario passed")
        elif status == "SKIP":
            run.record_skip("gui", rel, "agent", "agent scenario skipped", str(log_path))
        elif status == "UNKNOWN" and agent_rc == 0:
            run.record_pass("gui", rel, "agent", str(log_path), "agent scenario passed (no status.txt)")
        else:
            run.record_fail("gui", rel, EXIT_GUI, "agent", str(log_path),
                            f"agent status={status} rc={agent_rc}")
            if rc == EXIT_OK:
                rc = EXIT_GUI

    collect_vm_artifacts(run, vm, "gui")
    release_vm(run, vm, rc)
    return rc


# ---------------------------------------------------------------------------
# Gate: full
# ---------------------------------------------------------------------------

def gate_full(run: CIRun) -> int:
    rc = gate_preflight(run)
    if rc != EXIT_OK:
        return rc

    for gate_fn in [gate_host, lambda r: gate_vm_smoke(r), lambda r: gate_bats(r), lambda r: gate_gui(r)]:
        step_rc = gate_fn(run)
        if rc == EXIT_OK and step_rc != EXIT_OK:
            rc = step_rc
    return rc


# ---------------------------------------------------------------------------
# Gate: snapshot-daily
# ---------------------------------------------------------------------------

def gate_snapshot_daily(run: CIRun, date_arg: str = "", name_arg: str = "") -> int:
    date_arg = date_arg or datetime.date.today().isoformat()
    new_name = name_arg or f"qdistro-daily-{date_arg}"

    if vm_exists(new_name):
        run.record_blocked("snapshot-daily", new_name, EXIT_VM_PROVISION, "vm", "target VM already exists")
        return EXIT_VM_PROVISION
    target_disk = IMG_DIR / f"{new_name}.qcow2"
    if target_disk.exists():
        run.record_blocked("snapshot-daily", new_name, EXIT_VM_PROVISION, "vm", "target disk already exists")
        return EXIT_VM_PROVISION

    vm = acquire_vm(run, "snapshot-daily")
    if not vm:
        return EXIT_VM_PROVISION

    collect_vm_artifacts(run, vm, "snapshot-source")
    run_cmd(VIRSH + ["destroy", vm])

    old_disk = vm_disk_path(vm)
    xml_result = run_cmd(VIRSH + ["dumpxml", vm, "--inactive"])
    if not xml_result.stdout or not old_disk or not Path(old_disk).exists():
        run.record_blocked("snapshot-daily", new_name, EXIT_VM_PROVISION, "vm", "could not read VM XML or disk")
        return EXIT_VM_PROVISION

    # Undefine temp VM
    r = run_cmd(VIRSH + ["undefine", vm, "--nvram"])
    if r.returncode != 0:
        run_cmd(VIRSH + ["undefine", vm])

    # Rename disk
    shutil.move(old_disk, str(target_disk))

    # Redefine with new name
    xml = xml_result.stdout
    xml = re.sub(rf"<name>{re.escape(vm)}</name>", f"<name>{new_name}</name>", xml)
    xml = re.sub(r"<uuid>.*?</uuid>", "", xml)
    xml = xml.replace(old_disk, str(target_disk))

    define_log = run.rdir / "vm" / "snapshot-define.log"
    r = subprocess.run(
        VIRSH + ["define", "/dev/stdin"],
        input=xml, capture_output=True, text=True,
    )
    define_log.write_text((r.stdout or "") + (r.stderr or ""))
    if r.returncode != 0:
        run.record_fail("snapshot-daily", new_name, EXIT_VM_PROVISION, "vm", str(define_log), "virsh define failed")
        return EXIT_VM_PROVISION

    r = run_cmd(VIRSH + ["start", new_name])
    if r.returncode != 0:
        run.record_fail("snapshot-daily", new_name, EXIT_VM_BOOT, "vm", str(define_log), "virsh start failed")
        return EXIT_VM_BOOT

    r = run_cmd([str(VM_TOOLS / "vm-start-and-wait"), new_name], timeout=120)
    if r.returncode != 0:
        run.record_fail("snapshot-daily", new_name, EXIT_VM_BOOT, "vm", str(define_log), "daily VM did not become ready")
        return EXIT_VM_BOOT

    run.kv("daily_vm", new_name)
    run.kv("daily_vm_date", date_arg)
    collect_vm_artifacts(run, new_name, "snapshot-daily")
    run.record_pass("snapshot-daily", new_name, "vm", str(define_log), "daily VM captures current source state")
    return EXIT_OK


# ---------------------------------------------------------------------------
# Gate: cleanup
# ---------------------------------------------------------------------------

def gate_cleanup(run: CIRun, dry: bool = False, age_hours: int = 24) -> int:
    rc = EXIT_OK
    log_path = run.rdir / "host" / "cleanup.log"
    lines: list[str] = []
    now = time.time()
    cutoff = now - age_hours * 3600

    r = run_cmd(VIRSH + ["list", "--all", "--name"])
    for name in r.stdout.strip().splitlines():
        name = name.strip()
        if not name or not name.startswith("qci-"):
            continue
        if is_protected_vm(name):
            lines.append(f"skip protected {name}")
            continue
        disk = vm_disk_path(name)
        if not disk or not Path(disk).exists():
            lines.append(f"keep {name} (disk path unknown)")
            continue
        try:
            mtime = Path(disk).stat().st_mtime
        except OSError:
            lines.append(f"keep {name} (could not stat disk)")
            continue
        if mtime >= cutoff:
            lines.append(f"keep recent {name} mtime={int(mtime)}")
            continue
        if dry:
            lines.append(f"would destroy {name} disk={disk}")
        else:
            run_cmd(VIRSH + ["destroy", name])
            r2 = run_cmd(VIRSH + ["undefine", name, "--remove-all-storage"])
            if r2.returncode != 0:
                lines.append(f"FAIL undefine {name}")
                rc = EXIT_RUNNER
            else:
                lines.append(f"destroyed {name}")

    log_path.write_text("\n".join(lines))
    if rc == EXIT_OK:
        run.record_pass("cleanup", "qci-vms", "vm", str(log_path), f"age_hours={age_hours} dry_run={dry}")
    else:
        run.record_fail("cleanup", "qci-vms", rc, "vm", str(log_path), f"age_hours={age_hours} dry_run={dry}")
    return rc


# ---------------------------------------------------------------------------
# Report / triage / list-runs
# ---------------------------------------------------------------------------

def latest_run() -> Path | None:
    if not RUNS_DIR.is_dir():
        return None
    runs = sorted(RUNS_DIR.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
    return runs[0] if runs else None

def cmd_report(run_dir: Path) -> None:
    if REPORT_PY.exists():
        run_cmd([sys.executable, str(REPORT_PY), str(run_dir)])

def cmd_triage(run_dir: Path) -> None:
    report_md = run_dir / "report.md"
    if not report_md.exists() and REPORT_PY.exists():
        run_cmd([sys.executable, str(REPORT_PY), str(run_dir)])
    if report_md.exists():
        lines = report_md.read_text().splitlines()
        print("\n".join(lines[:220]))
    print(f"\nArtifacts: {run_dir}")

def cmd_list_runs() -> None:
    if not RUNS_DIR.is_dir():
        print("(no runs)")
        return
    for d in sorted(RUNS_DIR.iterdir()):
        if d.is_dir():
            mtime = datetime.datetime.fromtimestamp(d.stat().st_mtime)
            print(f"{mtime:%Y-%m-%d %H:%M} {d}")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main() -> int:
    os.environ["LIBVIRT_DEFAULT_URI"] = "qemu:///session"

    parser = argparse.ArgumentParser(
        prog="qci-claude",
        description="qdistro CI orchestrator with Claude Sonnet subagents",
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("preflight")
    sub.add_parser("host")

    p = sub.add_parser("vm-smoke")
    p.add_argument("--vm", default="")

    p = sub.add_parser("bats")
    p.add_argument("--vm", default="")
    p.add_argument("--file", action="append", dest="files", default=[])

    p = sub.add_parser("gui")
    p.add_argument("--vm", default="")
    p.add_argument("--scenario", action="append", dest="scenarios", default=[])
    p.add_argument("--no-require-agent", action="store_true")

    p = sub.add_parser("full")
    p.add_argument("--keep-on-fail", action="store_true")
    p.add_argument("--delete-failed-vm", action="store_true")
    p.add_argument("--no-require-agent", action="store_true")

    p = sub.add_parser("snapshot-daily")
    p.add_argument("--date", default="")
    p.add_argument("--name", default="")

    p = sub.add_parser("cleanup")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--age-hours", type=int, default=24)

    p = sub.add_parser("report")
    p.add_argument("--latest", action="store_true")
    p.add_argument("--run", default="")

    p = sub.add_parser("triage")
    p.add_argument("--latest", action="store_true")
    p.add_argument("--run", default="")

    sub.add_parser("list-runs")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return EXIT_USAGE

    # Non-run commands
    if args.command == "list-runs":
        cmd_list_runs()
        return EXIT_OK
    if args.command in ("report", "triage"):
        if args.latest:
            rd = latest_run()
        elif args.run:
            rd = Path(args.run)
        else:
            print("set --latest or --run", file=sys.stderr)
            return EXIT_USAGE
        if not rd or not rd.is_dir():
            print(f"no such run: {rd}", file=sys.stderr)
            return EXIT_USAGE
        if args.command == "report":
            cmd_report(rd)
        else:
            cmd_triage(rd)
        return EXIT_OK

    # Run commands — create a CIRun
    run = CIRun(args.command, sys.argv[2:])

    try:
        if args.command == "preflight":
            rc = gate_preflight(run)
        elif args.command == "host":
            rc = gate_host(run)
        elif args.command == "vm-smoke":
            rc = gate_vm_smoke(run, args.vm)
        elif args.command == "bats":
            rc = gate_bats(run, args.vm, args.files or None)
        elif args.command == "gui":
            if args.no_require_agent:
                os.environ["QCI_REQUIRE_AGENT_GUI"] = "0"
            rc = gate_gui(run, args.vm, args.scenarios or None)
        elif args.command == "full":
            if args.keep_on_fail:
                os.environ["QCI_KEEP_FAILED_VM"] = "1"
            if args.delete_failed_vm:
                os.environ["QCI_DELETE_FAILED_VM"] = "1"
            if args.no_require_agent:
                os.environ["QCI_REQUIRE_AGENT_GUI"] = "0"
            rc = gate_full(run)
        elif args.command == "snapshot-daily":
            rc = gate_snapshot_daily(run, args.date, args.name)
        elif args.command == "cleanup":
            rc = gate_cleanup(run, args.dry_run, args.age_hours)
        else:
            rc = EXIT_USAGE
    except KeyboardInterrupt:
        log("interrupted")
        rc = EXIT_RUNNER
    except Exception as e:
        log(f"unhandled exception: {e}")
        import traceback
        traceback.print_exc()
        rc = EXIT_RUNNER

    run.finish(rc)
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
