#!/usr/bin/env bash
# qci - qdistro local CI runner (thin dispatcher).
#
# This is intentionally local-first CI: it runs sibling-repo host tests,
# disposable VM gates, bats integration tests, and agent-assisted GUI
# scenarios, then writes Markdown and HTML reports into qdistro/ci/runs/.
#
# The heavy lifting lives in sourced bash modules under ci/lib/ (one file per
# gate, plus the run/VM engine); this entrypoint owns ONLY path resolution,
# module sourcing order, and the dispatch call. The whole run executes in ONE
# process so the gates share RDIR, the results.tsv, CREATED_VMS, the per-run
# golden disks, the INT/TERM trap, and the accumulated exit class. See
# ci/AGENTS.md for the module map. The `justfile` is the preferred human
# surface and delegates to this CLI; this CLI is the stable machine contract.

set -uo pipefail

export LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///session}"

SELF=$(readlink -f "$0")
QCI_BIN_DIR=$(cd "$(dirname "$SELF")" && pwd)
QCI_DIR=$(cd "$QCI_BIN_DIR/.." && pwd)
QDISTRO_REPO=$(cd "$QCI_DIR/.." && pwd)
WORKSPACE=$(cd "$QDISTRO_REPO/.." && pwd)
RUNS_DIR=${QCI_RUNS_DIR:-$QCI_DIR/runs}
REPORT_PY="$QCI_DIR/lib/report.py"
VM_TOOLS="$QDISTRO_REPO/scripts/vm"
IMAGE_DIR="$QDISTRO_REPO/image"
REGISTRY_TSV="$QDISTRO_REPO/tests/registry.tsv"
VIRSH=(virsh -c qemu:///session)

QCI_LIB="$QCI_DIR/lib"

# Source order note: bash resolves function names at CALL time, so the order
# below matters only for the handful of top-level statements in these modules
# (bootstrap's env exports, run.sh's trap install, the const assignments in
# affected.sh/edit_guard.sh) — all of which depend only on definitions earlier
# in their own file. Everything is loaded before main() runs, so cross-module
# calls always resolve.
. "$QCI_LIB/bootstrap.sh"     # exit-class table, PROJECTS, run state, env knobs
. "$QCI_LIB/core.sh"          # log/stamp/safe_name/exit_class_name/map_rc/rel_path/kv
. "$QCI_LIB/usage.sh"         # usage()
. "$QCI_LIB/assert.sh"        # precondition helpers
. "$QCI_LIB/run.sh"           # init_run/finish_run/abort_run/record_*/run_logged + traps
. "$QCI_LIB/vm.sh"            # acquire/release VM, golden disks, artifacts
. "$QCI_LIB/affected.sh"      # registry + changed-path -> gate selection
. "$QCI_LIB/edit_guard.sh"    # protected-path edit guard
for _qci_gate in "$QCI_LIB"/gates/*.sh; do . "$_qci_gate"; done
unset _qci_gate
. "$QCI_LIB/dispatch.sh"      # gate_full, triage helpers, main()

main "$@"
