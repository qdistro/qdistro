#!/usr/bin/env python3
"""List or run measured QCI development lanes without changing qci full."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[2]
QCI = ROOT / "ci/bin/qci"
REGISTRY = ROOT / "tests/registry.tsv"
SLOW_BATS = {
    "tiered-isolation.bats",
    "templates-browser.bats",
    "disposables-e2e.bats",
    "vt-escape-lockdown.bats",
    "templates-promotion.bats",
}
GUI_DIRS = {
    "gui-permissions": "tests/integration/permissions-gui",
    "gui-locker": "qdlocker/tests/gui",
    "gui-noctalia": "tests/integration/qdwin-noctalia",
    "gui-qdwin": "qdwin/tests/gui",
    "gui-apps": "qdwin/tests/apps",
    "gui-workflow": "tests/integration/workflow-gui",
    "gui-presentation": "tests/integration/presentation-gui",
}
LANES = ("bats-fast", "bats-slow", *GUI_DIRS)


def discover() -> dict[str, list[Path]]:
    bats = sorted((ROOT / "tests/integration/vm").glob("*.bats"))
    bats += sorted(ROOT.glob("*/tests/integration/vm/*.bats"))
    names = [p.name for p in bats]
    if len(names) != len(set(names)):
        raise ValueError("duplicate Bats basename; qci results would collide")
    missing_slow = SLOW_BATS - set(names)
    if missing_slow:
        raise ValueError(f"slow Bats files missing: {', '.join(sorted(missing_slow))}")
    lanes = {
        "bats-fast": [p for p in bats if p.name not in SLOW_BATS],
        "bats-slow": [p for p in bats if p.name in SLOW_BATS],
    }
    for lane, directory in GUI_DIRS.items():
        lanes[lane] = sorted((ROOT / directory).glob("[0-9][0-9]-*.md"))
    empty = [lane for lane, paths in lanes.items() if not paths]
    if empty:
        raise ValueError(f"empty lane(s): {', '.join(empty)}")
    return lanes


def verify_qci_discovery(lanes: dict[str, list[Path]]) -> None:
    """Refuse a partial lane if qci's authoritative discovery has drifted."""
    env = os.environ.copy()
    env.update(WORKSPACE=str(ROOT), QDISTRO_REPO=str(ROOT))
    for kind, module, function, names in (
        ("bats", "bats", "bats_discover_files", ("bats-fast", "bats-slow")),
        ("gui", "gui", "agent_scenarios", tuple(GUI_DIRS)),
    ):
        script = f". ci/lib/bootstrap.sh; . ci/lib/gates/{module}.sh; {function}"
        result = subprocess.run(
            ["bash", "-c", script], cwd=ROOT, env=env,
            capture_output=True, text=True, check=True,
        )
        actual = {Path(line).resolve() for line in result.stdout.splitlines() if line}
        selected = {path.resolve() for name in names for path in lanes[name]}
        if actual != selected:
            missing = sorted(str(p) for p in actual - selected)
            extra = sorted(str(p) for p in selected - actual)
            raise ValueError(
                f"{kind} lanes differ from qci discovery; missing={missing[:5]} extra={extra[:5]}"
            )


def audit_registry(lanes: dict[str, list[Path]]) -> None:
    registered = set()
    for line in REGISTRY.read_text().splitlines():
        if not line or line.startswith("#") or line.startswith("path\t"):
            continue
        registered.add(line.split("\t", 1)[0])
    for kind, names in (
        ("bats", ("bats-fast", "bats-slow")),
        ("gui", tuple(GUI_DIRS)),
    ):
        paths = {p.relative_to(ROOT).as_posix() for name in names for p in lanes[name]}
        missing = sorted(paths - registered)
        print(f"{kind}: {len(paths)} discovered, {len(paths) - len(missing)} registered, {len(missing)} missing")
        for path in missing:
            print(f"  {path}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("check", "audit", "list", "run"))
    parser.add_argument("lane", nargs="?", choices=LANES)
    parser.add_argument("--vm", help="reuse a named VM (serial execution)")
    args = parser.parse_args()
    if args.action in ("check", "audit"):
        if args.lane or args.vm:
            parser.error(f"{args.action} takes no lane or VM")
    elif not args.lane:
        parser.error(f"{args.action} requires a lane")
    elif args.action == "list" and args.vm:
        parser.error("list takes no VM")

    try:
        lanes = discover()
        verify_qci_discovery(lanes)
    except (ValueError, subprocess.CalledProcessError) as exc:
        parser.error(str(exc))
    if args.action == "check":
        for lane, paths in lanes.items():
            print(f"{lane}: {len(paths)} files")
        return 0
    if args.action == "audit":
        audit_registry(lanes)
        return 0
    selected = [p.relative_to(ROOT).as_posix() for p in lanes[args.lane]]
    if args.action == "list":
        print("\n".join(selected))
        return 0
    if os.environ.get("QCI_RELEASE") == "1":
        parser.error("partial lanes are not release verdicts; run qci full")
    kind = "bats" if args.lane.startswith("bats-") else "gui"
    option = "--file" if kind == "bats" else "--scenario"
    command = [str(QCI), kind]
    if args.vm:
        command += ["--vm", args.vm]
    for path in selected:
        command += [option, path]
    print(f"qci-lane {args.lane}: {len(selected)} files", file=sys.stderr, flush=True)
    os.chdir(ROOT)
    env = os.environ.copy()
    env["QCI_TEST_LANE"] = args.lane
    if args.lane == "gui-apps":
        # The periodic gui-apps lane: opt into the third-party app scenarios
        # (qdwin/tests/apps/01, 05-11) and bake their packages into the golden.
        env["QCI_GUI_APPS"] = "1"
    os.execve(QCI, command, env)


if __name__ == "__main__":
    raise SystemExit(main())
