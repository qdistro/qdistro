#!/usr/bin/env bash
# Check orchestration prerequisites; build/test dependencies live in Podman.
set -uo pipefail
case "${1:---check}" in
    --check|-c) ;;
    --help|-h) echo 'Usage: qci-host-deps [--check]. Build dependencies are installed only in the qci host container.'; exit 0 ;;
    *) echo 'Use --check. Host package installation is no longer needed for builds.' >&2; exit 2 ;;
esac
rc=0
for tool in podman bash git python3 bats virsh; do
    if command -v "$tool" >/dev/null; then echo "OK $tool"
    else echo "MISSING orchestration prerequisite: $tool"; rc=1; fi
done
exit "$rc"
