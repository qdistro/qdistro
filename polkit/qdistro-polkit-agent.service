[Unit]
Description=qdistro polkit authentication agent (PAM / fprintd / broker)
Documentation=https://qdistro.invalid/spec/13
# Runs in the admin's user session so it can register with polkitd
# scoped to that session. Needs the user session bus + the qdistro
# admin broker (broker delegation method).
After=graphical-session-pre.target xdg-desktop-portal.service
Wants=qdistro-admin-broker.service
# qdwin-session.target, not graphical-session.target: nothing in a
# qdistro install ever reaches graphical-session.target (see
# deploy/qdwin-session.target), so both directives were inert. The
# installer's `systemctl --user enable --now` masked this — the agent
# started at install time and then never came back after a reboot,
# because the .wants symlink hung off a target nothing activates.
PartOf=qdwin-session.target

[Service]
Type=simple
# -I isolates interpreter startup: PYTHONPATH/PYTHONHOME/
# sitecustomize/usercustomize are ignored and the script dir is not
# added to sys.path. The user manager's environment is writable by any
# same-uid process (`systemctl --user set-environment` + restart), and
# injected startup code would share the agent's D-Bus connection — the
# connection the broker's cookie ownership binding trusts (sol r165).
# The broker additionally rejects peers whose environ carries
# injection-capable variables.
ExecStart=/usr/bin/python3 -I /usr/libexec/qdistro/qdistro_polkit_agent.py
# The agent no longer exits when the admin has no login session yet (the
# lingering user manager starts it at boot, before greetd's login): it waits
# for logind and registers then. on-failure is for real crashes only.
Restart=on-failure
RestartSec=3
# Subprocess prompt path — agent spawns this on PAM auth.
Environment=QDISTRO_POLKIT_PROMPT_BIN=/usr/local/bin/qdistro-polkit-prompt
# The agent honours QDISTRO_POLKIT_NONINTERACTIVE=allow as a test seam.
# The user manager environment is writable by any same-UID process
# (`systemctl --user set-environment` + restart), so never inherit it
# into the production unit (iso2 `17` E9).
#
# UnsetEnvironment= applies AFTER all Environment=/EnvironmentFile=
# assignments — including same-uid drop-ins — per systemd.exec(5), so
# this list is also the env-injection denylist: loader preloads
# (LD_*/GLIBC_TUNABLES) would run attacker code in the agent process
# before -I takes effect, and their entries could be scrubbed from
# /proc/<pid>/environ before the broker ever reads it (sol r168).
UnsetEnvironment=QDISTRO_POLKIT_NONINTERACTIVE LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH LD_ORIGIN_PATH LD_PROFILE LD_USE_LOAD_BIAS LD_DYNAMIC_WEAK LD_DEBUG_OUTPUT LD_HWCAP_MASK GLIBC_TUNABLES PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT PYTHONBREAKPOINT PYTHONEXECUTABLE PYTHONUSERBASE PYTHONWARNINGS BASH_ENV ENV CDPATH IFS

# TCB no-network discipline. The agent talks to polkitd, qdistro-broker,
# fprintd/PAM, and its local prompt over AF_UNIX/system facilities only;
# it has no legitimate IP/vsock egress path.
#
# No IPAddressDeny=: this is a USER unit, and IP firewalling needs the
# system manager (BPF); the user manager only logs "unit configures an IP
# firewall, but not running as root" and applies nothing. The private
# network namespace plus the address-family allowlist are what enforce it.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=qdwin-session.target
