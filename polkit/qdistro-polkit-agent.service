[Unit]
Description=qdistro polkit authentication agent (PAM / fprintd / broker)
Documentation=https://qdistro.invalid/spec/13
# System service running as the admin uid — deliberately NOT a user
# unit. A user unit cannot seal its own launch environment: every
# same-uid process can push manager variables (`systemctl --user
# set-environment` + restart) or write drop-ins, and an empty drop-in
# `UnsetEnvironment=` RESETS this unit's denylist outright
# (systemd.exec(5)) — sol r169. As a system unit the unit file, its
# drop-in dirs, the manager environment and the unit's cgroup under
# system.slice are all root-owned; uid 1000 cannot inject into the
# agent's environment or argv at all. The agent registers with polkitd
# scoped to the admin's login session.
After=user@1000.service qdistro-admin-broker.service
Wants=qdistro-admin-broker.service

[Service]
Type=simple
User=admin
# -I isolates interpreter startup: PYTHONPATH/PYTHONHOME/
# sitecustomize/usercustomize are ignored and the script dir is not
# added to sys.path. The broker additionally verifies exe/argv, the
# system.slice cgroup, PPID=1 and — decisively — that the peer pid IS
# this unit's MainPID per systemd, which no descendant or foreign
# process can satisfy (sol r161/r162/r164/r167/r169, astra r172).
ExecStart=/usr/bin/python3 -I /usr/libexec/qdistro/qdistro_polkit_agent.py
# The agent does not exit when the admin has no login session yet: it
# waits for logind and registers then. on-failure is for real crashes
# (and for the session bus being briefly unavailable at early boot).
Restart=on-failure
RestartSec=3
# Session plumbing the user-unit form used to inherit from the manager
# environment. The session-bus connection is only the per-session
# singleton guard; XDG_RUNTIME_DIR/WAYLAND_DISPLAY let the Qt prompt
# subprocess reach the admin compositor. Linger keeps user@1000 (and
# /run/user/1000) up from early boot.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=XDG_RUNTIME_DIR=/run/user/1000
# The qdwin compositor pins --socket=wayland-1 (deploy/qdwin-compositor.service).
Environment=WAYLAND_DISPLAY=wayland-1
# Subprocess prompt path — agent spawns this on PAM auth.
Environment=QDISTRO_POLKIT_PROMPT_BIN=/usr/local/bin/qdistro-polkit-prompt
# Denylist kept as defence-in-depth: on a system unit no same-uid
# process can inject these, but the belt-and-suspenders unset also
# neutralises a future mis-edit of this file. The agent honours
# QDISTRO_POLKIT_NONINTERACTIVE=allow as a test seam — it must never be
# set in production (iso2 `17` E9).
UnsetEnvironment=QDISTRO_POLKIT_NONINTERACTIVE QDISTRO_POLKIT_METHOD QDISTRO_POLKIT_SESSION_ID LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH LD_ORIGIN_PATH LD_PROFILE LD_USE_LOAD_BIAS LD_DYNAMIC_WEAK LD_DEBUG_OUTPUT LD_HWCAP_MASK GLIBC_TUNABLES PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT PYTHONBREAKPOINT PYTHONEXECUTABLE PYTHONUSERBASE PYTHONWARNINGS BASH_ENV ENV CDPATH IFS

# TCB no-network discipline. The agent talks to polkitd, qdistro-broker,
# fprintd/PAM, and its local prompt over AF_UNIX/system facilities only;
# it has no legitimate IP/vsock egress path.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
