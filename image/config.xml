<?xml version="1.0" encoding="utf-8"?>

<!--
  qdistro kiwi description.
  Builds a Tumbleweed-derived OEM disk image that lays itself onto
  internal storage on first boot. See build.sh.
-->

<image schemaversion="8.4" name="qdistro">
  <description type="system">
    <author>qdistro contributors</author>
    <contact>kjan80@gmail.com</contact>
    <specification>qdistro desktop (Tumbleweed remix)</specification>
  </description>

  <preferences>
    <version>0.1.0</version>
    <packagemanager>zypper</packagemanager>
    <bootsplash-theme>bgrt</bootsplash-theme>
    <locale>en_US</locale>
    <keytable>us</keytable>
    <timezone>UTC</timezone>
    <rpm-excludedocs>true</rpm-excludedocs>

    <type image="oem"
          filesystem="btrfs"
          firmware="uefi"
          installiso="true"
          installboot="harddisk"
          kernelcmdline="quiet systemd.default_vt=3"
          efipartsize="512">
      <!-- timeout=30 gives a human time to read the menu; the install
           ISO's default entry is "Boot from Hard Disk" (installboot=
           harddisk), so a timeout expiry never auto-installs. kiwi-
           oem-dump *additionally* asks "Destroying ALL data on
           /dev/vda? <Yes>/<No>" before writing — that prompt is
           unconditional unless oem-unattended is set (we don't). -->
      <bootloader name="grub2" timeout="30" timeout_style="menu"/>
      <oemconfig>
        <oem-systemsize>20480</oem-systemsize>
        <oem-swap>true</oem-swap>
        <oem-swapsize>2048</oem-swapsize>
        <oem-skip-verify>true</oem-skip-verify>
      </oemconfig>
      <size unit="M">20480</size>
      <systemdisk name="qdistro">
        <volume name="home"/>
        <volume name="root" copy_on_write="false"/>
        <volume name="opt"/>
        <volume name="srv"/>
        <volume name="tmp"/>
        <volume name="usr/local"/>
        <volume name="var" copy_on_write="false"/>
      </systemdisk>
    </type>
  </preferences>

  <users>
    <user name="root"  password="$6$PMKXCoJ3YkAcBLHW$sDLRaPFepJ6L.UL/zvjDpIiSwcRbewvCXRGbbRaqS7MMy20OKGefi/HRlp7RC9xMV/TpmblrRhhIsS4DAr6Jl/" pwdformat="encrypted" home="/root"/>
    <user name="admin" password="$6$PMKXCoJ3YkAcBLHW$sDLRaPFepJ6L.UL/zvjDpIiSwcRbewvCXRGbbRaqS7MMy20OKGefi/HRlp7RC9xMV/TpmblrRhhIsS4DAr6Jl/" pwdformat="encrypted"
          home="/home/admin" id="1000" groups="users,wheel,video,audio,input,kvm,libvirt"/>
    <user name="user"  password="$6$PMKXCoJ3YkAcBLHW$sDLRaPFepJ6L.UL/zvjDpIiSwcRbewvCXRGbbRaqS7MMy20OKGefi/HRlp7RC9xMV/TpmblrRhhIsS4DAr6Jl/" pwdformat="encrypted"
