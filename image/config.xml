<!--
  qdistro kiwi description.
  Builds the qdistro disk image: a Tumbleweed-derived OEM raw that boots
  as-is from a USB stick or as a VM disk (todo/iso/13). See build.sh.
-->

<image schemaversion="8.4" name="qdistro">
  <!-- ===== TUMBLEWEED SNAPSHOT PIN ==========================================
       The build is pinned to one Tumbleweed snapshot so a rebuild inside
       download.opensuse.org's ~4-week history window is exact, and a bug
       report can name the snapshot it ran (todo/iso/13, decided 2026-09-04).
       Bump the id deliberately per tester release: it is the 8-digit
       directory under https://download.opensuse.org/history/ and MUST be the
       same in both source paths below. build.sh reads it from here (the
       only place it is written) for the artifact name and /etc/qdistro/release,
       and refuses to build if the two paths disagree. kiwi's XML parser
       rejects entities, so there is no way to spell it once.
       HTTPS transport (J25): plain http:// leaves repo metadata + RPMs open
       to a MITM/poisoned-mirror substituting a trojaned package into the
       baked image. kiwi still verifies the openSUSE repo GPG signatures;
       https adds transport integrity + confidentiality on top.
       ====================================================================== -->
  <repository type="rpm-md" alias="Tumbleweed-OSS">
    <source path="https://download.opensuse.org/history/20260902/tumbleweed/repo/oss/"/>
  </repository>
  <repository type="rpm-md" alias="Tumbleweed-NonOSS">
    <source path="https://download.opensuse.org/history/20260902/tumbleweed/repo/non-oss/"/>
  </repository>

  <description type="system">
    <author>qdistro contributors</author>
    <contact>kjan80@gmail.com</contact>
    <specification>qdistro desktop (Tumbleweed remix)</specification>
  </description>

  <!-- kiwi XML profiles (todo/iso/14 Phase G). Orthogonal to QDISTRO_PROFILE
       (dev/release, the bootstrap chain). tester is the published stick/VM
       image (import=true: the default build). ci is additive: extra test
       packages plus config.sh masks greetd so admin's user manager starts
       the compositor the way fresh-vm-bootstrap.sh does. Pass
       QDISTRO_KIWI_PROFILE=ci to build.sh / build-in-vm.sh. -->
  <profiles>
    <profile name="tester" description="Tester USB and VM raw image" import="true"/>
    <profile name="ci" description="CI golden base: tester plus bats/ydotool extras; greetd masked"/>
  </profiles>

  <preferences>
    <version>0.1.0</version>
    <packagemanager>zypper</packagemanager>
    <bootsplash-theme>bgrt</bootsplash-theme>
    <locale>en_US</locale>
    <keytable>us</keytable>
    <timezone>UTC</timezone>
    <rpm-excludedocs>true</rpm-excludedocs>

    <!-- installiso="false": the tester release is the raw alone (todo/iso/13).
         A tester who boots an install ISO from a stick is offered a wipe of
         their internal disk. The installable ISO is post-v1 and gets a kiwi
         profile when it returns; installboot and install-test.sh stay for it.
         bundle_format names the release artifact <name>-<version>-<id>.raw.xz
         when build.sh runs `kiwi-ng result bundle` with the snapshot as bundle id. -->
    <!-- firmware="uefi": tester images are UEFI-only (todo/iso/14 Phase E).
         Legacy BIOS/CSM is out of scope, stated on the download page.
         target_removable="true": the product is a USB stick; grub2-install
         (removable) writes EFI/BOOT/bootx64.efi (the firmware fallback
         path) and does not create a machine NVRAM boot entry that would
         not travel with the stick. Run 30 already had that path without
         the attribute (shim); setting it makes the intent explicit. -->
    <type image="oem"
          filesystem="btrfs"
          firmware="uefi"
          target_removable="true"
          installiso="false"
          installboot="install"
          bundle_format="%N-%v-%I"
          kernelcmdline="quiet"
          efipartsize="512">
      <!-- kernelcmdline deliberately does NOT carry a systemd.default_vt
           setting. That is not a systemd option (no such key in logind's
           config parser, kernel-command-line(7), or the systemd binaries),
           so it was inert and only made it look as though the boot VT was
           pinned by the kernel cmdline. Boot lands on tty3 because greetd's
           [terminal] vt = 3 (deploy/greetd-config.toml) puts it there. -->
      <!-- installboot="install" makes "Install qdistro" the *default*
           (pre-highlighted) GRUB entry on the install ISO, so the
           unattended install-test driver no longer has to send a Down
           keypress to move off "Boot from Hard Disk" — a single Enter
           at the GRUB menu starts the install. The real safety gate is
           kiwi-oem-dump's unconditional "Destroying ALL data on
           /dev/vda? <Yes>/<No>" prompt, which always blocks the actual
           disk write (oem-unattended is NOT set), so a human medium
           still gets one explicit confirmation before anything is
           overwritten. timeout=30 (timeout_style=menu) gives a human
           time to read the menu; on timeout expiry GRUB proceeds to the
           default Install entry, but the destroy-confirm still stops it
           short of touching the disk. -->
      <bootloader name="grub2" timeout="30" timeout_style="menu"/>
      <!-- Sizes (todo/iso/13, decided 2026-09-04): the raw is 28 GiB
           (28672 MiB = 30,064,771,072 bytes) so it fits nominal "32 GB"
           media (~31.0 GB usable) with ~0.9 GB to spare, and a VM booting
           the raw directly gets that filesystem without first-boot repart.
           No oem-systemsize: it capped the root at 20 GiB on first boot and
           left the rest of the stick unpartitioned; with the raw at 28 GiB,
           repart's only job is growing onto a bigger stick. oem-resize is
           left at its default, which runs on EVERY boot (kiwi's opt-out is
           the counter-intuitive <oem-resize-once>false</oem-resize-once>):
           harmless when there is nothing to grow, and a stick copied to a
           larger one grows again. 2 GiB swap is created by kiwi at build
           time, not after repart. kiwi's `compressed` attribute is valid
           only for pxe/kis types, so build.sh xz-compresses the raw via
           `kiwi-ng result bundle` instead. -->
      <oemconfig>
        <oem-swap>true</oem-swap>
        <oem-swapsize>2048</oem-swapsize>
        <oem-skip-verify>true</oem-skip-verify>
      </oemconfig>
      <size unit="M">28672</size>
      <systemdisk name="qdistro">
        <volume name="home"/>
        <volume name="root" copy_on_write="false"/>
        <volume name="opt"/>
        <volume name="srv"/>
        <volume name="tmp"/>
        <volume name="usr/local"/>
        <volume name="var" copy_on_write="false"/>
      </systemdisk>
    </type>
  </preferences>

