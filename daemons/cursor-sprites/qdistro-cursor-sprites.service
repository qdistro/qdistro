[Unit]
Description=qdistro cursor sprite supplier for qdwin
Documentation=https://github.com/qdistro
After=noctalia-shell.service
PartOf=noctalia-shell.service

[Service]
Type=simple
ExecStart=/usr/bin/qdistro-cursor-sprites
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XCURSOR_THEME=Adwaita
Environment=XCURSOR_SIZE=24
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=noctalia-shell.service
