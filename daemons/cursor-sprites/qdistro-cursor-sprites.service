[Unit]
Description=qdistro cursor sprite supplier for qdwin
Documentation=https://codeberg.org/qdistro/qdistro
# The qdshell user session is shipped as noctalia-shell.service on the
# current image (formerly qdshell.service). List both so the dependency
# resolves on either the old or the new image without a second drop-in.
After=noctalia-shell.service qdshell.service
PartOf=noctalia-shell.service qdshell.service

[Service]
Type=simple
ExecStart=/usr/bin/qdistro-cursor-sprites
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XCURSOR_THEME=Adwaita
Environment=XCURSOR_SIZE=24
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
# WantedBy accepts multiple space-separated targets. systemctl enable
# will create a *.wants/ symlink under whichever of these units actually
# exists; the non-existent one is logged as a warning but does not fail
# the enable (and on a future image where the unit is renamed back, the
# other symlink takes over automatically).
WantedBy=noctalia-shell.service qdshell.service
