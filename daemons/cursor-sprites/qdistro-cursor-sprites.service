[Unit]
Description=qdistro cursor sprite supplier for qdwin
Documentation=https://github.com/qdistro/qdistro
# The qdshell user session ships as qdshell.service (the deploy-named
# unit; the legacy noctalia-shell.service alias was retired 2026-06-16).
After=qdshell.service
PartOf=qdshell.service

[Service]
Type=simple
ExecStart=/usr/bin/qdistro-cursor-sprites
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XCURSOR_THEME=Adwaita
Environment=XCURSOR_SIZE=24
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
# Enabled alongside the shell: systemctl enable creates a
# qdshell.service.wants/ symlink so the sprite supplier comes up with the
# qdshell session.
WantedBy=qdshell.service
