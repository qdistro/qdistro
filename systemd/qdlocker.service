[Unit]
Description=qdistro screen locker (qdlocker)
Documentation=https://codeberg.org/qdistro/qdlocker
# Peer to the shell — comes up alongside it, not after it. We use
# After= (ordering only, not a hard dep) on the user-session unit
# because qdshell may be slow to start and we don't want to block the
# locker behind it. Requires= on a system unit (qdwin.service) from a
# --user unit is silently ignored by systemd, so we don't bother.
# Wants= makes systemd actually try to start us when the session
# target is activated; PartOf= propagates stop/restart so we go
# down cleanly on logout.
Wants=graphical-session.target
PartOf=graphical-session.target
# Ordering: come up after qdwin's compositor unit has advertised the
# qdwin_locker_v1 global. The Requires= form is intentionally NOT
# used — qdlocker has Restart=always and will re-attempt the
# connection if qdwin isn't ready, which is the documented fail-safe.
# qdlocker exits non-zero when it cannot bind qdwin_locker_v1 (a
# locker that never bound cannot drive the lock), so Restart=always +
# RestartSec below provide exactly this backoff-retry; a persistent
# bind failure stays visible in the journal instead of a live-but-
# useless detached process masking the breakage.
After=graphical-session.target qdwin-compositor.service
# Disable systemd's start-limit-hit gate. Qt's wayland platform plugin
# qFatals (SIGABRT) when $WAYLAND_DISPLAY isn't accepting connections
# at QGuiApplication() construction — a transient condition during
# session bring-up and any restart that races qdwin/weston. With the
# default StartLimitBurst=5 / StartLimitIntervalSec=10s, five such
# crashes within 10 s permanently park the unit in `failed
# (start-limit-hit)` until a manual `systemctl reset-failed`, which
# silently breaks the "Restart=always re-attempts forever" contract
# the [Service] block below relies on. Setting
# StartLimitIntervalSec=0 disables the gate entirely; the unit will
# keep retrying every RestartSec=2s indefinitely, which matches the
# stated fail-safe and prevents s103-locker-idle from observing a
# stale ctrl socket after Test 1's restart hop.
StartLimitIntervalSec=0

[Service]
# Type=simple — we don't sd_notify until a later iteration wires the
# READY=1 + STATUS= path. Earlier drafts used Type=notify but the
# process never notified, so systemd held the unit `activating` until
# TimeoutStartSec.
Type=simple
# CANONICAL ExecStart for an unprefixed `pip install` (--prefix=/usr/local).
# qdistro's installers pip-install qdlocker with --prefix=/usr, which lands the
# console_script at /usr/bin/qdlocker, so BOTH installers MUST rewrite this line
# rather than copy the unit verbatim:
#   - qdistro/scripts/install/qdistro-bootstrap.sh (sed /usr/local/bin -> /usr/bin)
#   - qdistro/image/config.sh                      (same sed; fail-closed if the
#                                                    rewritten ExecStart is not
#                                                    an executable in the image)
# Copying this unit verbatim into a --prefix=/usr install makes qdlocker.service
# die 203/EXEC at boot — the locker silently never starts. Do NOT repoint this
# at /usr/bin here: that would break the standalone --prefix=/usr/local path and
# the installers' sed contract. The installers are authoritative for the
# deployed ExecStart path.
ExecStart=/usr/local/bin/qdlocker
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_LOGGING_RULES=qt.qpa.wayland.debug=false
# PYTHONNOUSERSITE=1: refuse to load user-site shims (a malicious
# ~/.local/.../site-packages/pam.py would otherwise shadow the system
# python-pam at import time). PYTHONPATH override removed — the
# packaged qdlocker is installed at a system-Python-discoverable
# location; hardcoding /usr/lib/python3.11 broke on Python 3.13.
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Dedicated /etc/pam.d/qdlocker service (shipped from this repo's pam/
# dir): it `include`s common-account for well-formed account management
# (a standalone common-auth fragment fails account management on its own)
# and adds an explicit pam_faillock brute-force lockout. Decoupling from
# the borrowed `login` stack makes the unlock policy explicit.
Environment=QDLOCKER_PAM_SERVICE=qdlocker
# Pin WAYLAND_DISPLAY + XDG_RUNTIME_DIR explicitly: the test-VM linger
# session doesn't import them into the user manager environment, so we
# set them here, mirroring noctalia-shell.service.
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000

# TCB no-network discipline. qdlocker talks to qdwin, its ctrl socket,
# logind/fprintd/PAM, and systemd notify over AF_UNIX/system facilities
# only; it has no legitimate IP/vsock egress path.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any

Restart=always
RestartSec=2

[Install]
# default.target for the user manager is the right target for an
# always-on user service. PartOf=graphical-session.target above ties
# our lifetime to the session so we go down cleanly on logout.
#
# qdwin-session.target is the production qdistro desktop session
# (greetd -> qdwin-session-launcher -> `systemctl --user start
# qdwin-session.target`). The session target also Wants= this unit, so
# the locker comes up with the desktop; declaring it WantedBy= here means
# `systemctl --user enable qdlocker.service` installs the .wants symlink
# under qdwin-session.target.wants/ in addition to default.target.wants/,
# making qdlocker a first-class member of the qdwin-session deployment
# path (finding #16). Keeping default.target too preserves the
# standalone/test-VM bring-up that does not use a session target.
WantedBy=default.target qdwin-session.target
