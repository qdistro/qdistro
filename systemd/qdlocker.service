[Unit]
Description=qdistro screen locker (qdlocker)
Documentation=https://codeberg.org/qdistro/qdlocker
# Peer to the shell — comes up alongside it, not after it. We use
# After= (ordering only, not a hard dep) on the user-session unit
# because qdshell may be slow to start and we don't want to block the
# locker behind it. Requires= on a system unit (qdwin.service) from a
# --user unit is silently ignored by systemd, so we don't bother.
# Wants= makes systemd actually try to start us when the session
# target is activated; PartOf= propagates stop/restart so we go
# down cleanly on logout.
Wants=graphical-session.target
PartOf=graphical-session.target
# Ordering: come up after qdwin's compositor unit has advertised the
# qdwin_locker_v1 global. The Requires= form is intentionally NOT
# used — qdlocker has Restart=always and will re-attempt the
# connection if qdwin isn't ready, which is the documented fail-safe.
After=graphical-session.target qdwin-compositor.service

[Service]
# Type=simple — we don't sd_notify until a later iteration wires the
# READY=1 + STATUS= path. Earlier drafts used Type=notify but the
# process never notified, so systemd held the unit `activating` until
# TimeoutStartSec.
Type=simple
ExecStart=/usr/local/bin/qdlocker
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_LOGGING_RULES=qt.qpa.wayland.debug=false
# PYTHONNOUSERSITE=1: refuse to load user-site shims (a malicious
# ~/.local/.../site-packages/pam.py would otherwise shadow the system
# python-pam at import time). PYTHONPATH override removed — the
# packaged qdlocker is installed at a system-Python-discoverable
# location; hardcoding /usr/lib/python3.11 broke on Python 3.13.
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
# WAYLAND_DISPLAY / XDG_RUNTIME_DIR are inherited from the systemd
# --user environment; the session manager imports them after qdwin
# advertises the socket.
Restart=always
RestartSec=2

[Install]
# default.target for the user manager is the right target for an
# always-on user service. PartOf=graphical-session.target above ties
# our lifetime to the session so we go down cleanly on logout.
WantedBy=default.target
