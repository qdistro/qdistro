[Unit]
Description=qdistro signed-manifest backup (06-backup-dr §2-§4)
# Triggered by qdistro-backup.timer (daily). Drives the signed-manifest engine
# over the SUBVOLUME SET in /etc/qdistro/backup.conf (TOML) — see
# qdistro_backup_service.py. Local seq/manifest state + driver-owned RO
# snapshots + stage-then-push to the configured remote; the run only advances
# state after the remote durably holds (and reads back matching) the new run.
#
# When backup.conf is absent the unit ConditionPathExists-skips, so a vanilla
# install doesn't fail. (The old unsigned qdistro-snap-export CLI was removed —
# command injection, opus-security-review HIGH #4; this signed-manifest driver
# is the only export path.)
ConditionPathExists=/etc/qdistro/backup.conf

[Service]
Type=oneshot
ExecStart=/usr/local/bin/qdistro-backup-run run --config /etc/qdistro/backup.conf
# Runs as root: `btrfs subvolume snapshot` needs CAP_SYS_ADMIN, and the backup
# must read every configured silo/metadata source. NoNewPrivileges keeps it
# from gaining more than it starts with; we do NOT restrict CapabilityBoundingSet
# (that would drop CAP_SYS_ADMIN and break snapshotting).
NoNewPrivileges=true
ProtectSystem=strict
# Sources (silo homes, /etc/qdistro) are READ; nothing under /home is written.
ProtectHome=read-only
# The driver writes ONLY under its state tree: local seq/manifest state, the RO
# snapshots it takes, the metadata-collector stage, and the encrypted staging
# dir it pushes from. StateDirectory CREATES /var/lib/qdistro/backup (0700) if
# absent and makes it writable through ProtectSystem=strict — so a fresh install
# starts without a manual mkdir. If backup.conf overrides state_dir/snapshot_dir/
# scratch_dir/collect_dir to a path OUTSIDE /var/lib/qdistro/backup, add it to a
# ReadWritePaths= line here too.
StateDirectory=qdistro/backup
StateDirectoryMode=0700
# ssh/rsync transport (a 'user@host:/path' remote) reads the ssh key + signing
# key under /root and may update known_hosts. A local-directory remote needs its
# parent added to ReadWritePaths instead. Left read-only by default (ProtectSystem
# =strict covers /root); the VM transport lane tunes this for real ssh.
PrivateTmp=true
