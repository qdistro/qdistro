[Unit]
Description=qdistro privileged-exec service (qsu backend)
# Paired with qdistro-root-exec.socket; the socket owns the fd and
# activates us on demand.
Requires=qdistro-root-exec.socket
After=qdistro-root-exec.socket qdistro-admin-broker.service

[Service]
Type=simple
# ExecStart points DIRECTLY at the labelled script (not at
# `/usr/bin/python3 <script>`) so the SELinux domain transition fires.
# The kernel takes the transition decision on the FIRST execve target;
# with `python3 <script>` that target is the interpreter (bin_t) and the
# script's qdistro_root_exec_exec_t label never triggers the
# init_daemon_domain transition into qdistro_root_exec_t. Executing the
# script directly (it carries a `#!/usr/bin/python3` shebang and is
# installed mode 0755) makes the labelled script the first execve target,
# so the daemon lands in qdistro_root_exec_t and the qdistro_qsu policy
# module's allow rules apply. Mirrors qdistro-admin-broker.service.
ExecStart=/usr/local/lib/qdistro/qdistro_root_exec.py
User=root

# Supervisor — if the handler process dies in-flight, pick it back up
# so the next connect gets a live service. Socket activation already
# covers cold start; this covers mid-life crashes.
Restart=on-failure
RestartSec=2s

# Sandboxing. The service's job is to exec arbitrary commands as the
# target user, so NoNewPrivileges and most capability bounds would
# break legitimate tools (e.g. `ping`, `passwd`, `systemctl`). We
# keep this intentionally permissive on caps but tighten everything
# the handler *itself* doesn't need:
NoNewPrivileges=false
# Config dirs read-only, /var /etc writable only via explicit paths.
ProtectSystem=full
# User homes are mounted read-only for the service and its children. Spawned
# commands inherit this service's mount namespace, so qsu is intentionally not
# a byte-for-byte sudo replacement until exec is split into a helper with a
# different sandbox contract.
ProtectHome=read-only
# Don't expose the service to per-user /run/user or private IPC.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
# SystemCallFilter is deliberately NOT set: the service execs
# arbitrary target-user commands which inherit the filter, and a
# too-tight set would break surprising tools (common causes: kernel
# keyring, iopl, obscure mount options). Reintroduce with a wide
# allowlist once the set of qsu'd commands stabilises.

[Install]
WantedBy=multi-user.target
