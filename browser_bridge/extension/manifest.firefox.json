{
  "manifest_version": 2,
  "name": "qdistro browser bridge",
  "version": "0.2.0",
  "description": "qdistro desktop integration: password fill, tab management, session export, and native messaging bridge.",
  "browser_specific_settings": {
    "gecko": {
      "id": "qdistro@qdistro.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "cookies",
    "contextualIdentities",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "qdistro browser bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
