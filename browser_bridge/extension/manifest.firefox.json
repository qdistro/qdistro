{
  "manifest_version": 2,
  "name": "qdistro browser bridge",
  "version": "0.1.0",
  "description": "Round-trips qdistro.ping through the qdistro native-messaging bridge.",
  "browser_specific_settings": {
    "gecko": {
      "id": "qdistro@qdistro.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "webNavigation"
  ],
  "browser_action": {
    "default_title": "qdistro: ping bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png"
  }
}
