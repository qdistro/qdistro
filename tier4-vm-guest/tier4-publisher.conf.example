# qdistro tier-4 guest publisher config.
#
# Leave this file unset for the default waypipe publisher path.
# For RDP mode, copy to /etc/qdistro/tier4-publisher.conf in the guest
# image or inject equivalent environment into qdistro-tier4-publisher.

QDISTRO_TIER4_STREAMING_METHOD=rdp
QDISTRO_TIER4_RDP_SUBSCRIBE=last
QDISTRO_TIER4_RDP_PEER_LABEL=tier4-rdp
QDISTRO_TIER4_RDP_CREDS=/run/qdistro-tier4-rdp.env
