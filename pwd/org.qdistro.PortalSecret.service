[D-BUS Service]
# Session-bus activation for the pwd portal Secret backend.
#
# Without this file the backend was installed and never started:
# qdistro-pwd-portal.service carried WantedBy=graphical-session.target,
# a target nothing in qdistro ever reaches (the desktop session target
# is qdwin-session.target — see deploy/qdwin-session.target), and no
# installer enabled it either. Activation is the right mechanism here
# rather than a session unit: xdg-desktop-portal only needs the backend
# when an app actually makes a Secret request, and the unit is already
# Type=dbus + BusName=org.qdistro.PortalSecret.
#
# SystemdService= (not Exec=) so the unit's sandbox directives
# (ProtectSystem=strict, PrivateNetwork=yes, MemoryDenyWriteExecute=yes,
# ...) apply to the activated process. Same shape as
# deploy/dbus-1/services/org.freedesktop.impl.portal.qdistro.service.
Name=org.qdistro.PortalSecret
SystemdService=qdistro-pwd-portal.service
