[Unit]
Description=qdistro pwd XDG portal Secret backend (spec/13 Phase-8.3)
# qdwin-session.target is the qdistro desktop session target (see
# deploy/qdwin-session.target). graphical-session.target, which this
# used to name, is never reached on a qdistro install: nothing binds
# it, so both PartOf= and WantedBy= against it were inert.
PartOf=qdwin-session.target

[Service]
Type=dbus
BusName=org.qdistro.PortalSecret
ExecStart=/usr/libexec/qdistro/qdistro_pwd_portal.py
Restart=on-failure
RestartSec=2

# Per-user session daemon. Sandbox is light — backend only needs
# system bus to talk to qdistro-pwd plus a session-bus name.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# Reached two ways, both intended: D-Bus activation via
# /usr/share/dbus-1/services/org.qdistro.PortalSecret.service (which is
# why no installer enables this unit), and as a session-transaction
# dependency of qdistro-portal-keys-unlock.service, which Wants= it.
# The [Install] section additionally lets a session pre-start it.
[Install]
WantedBy=qdwin-session.target
